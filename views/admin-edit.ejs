<%- include('partials/admin-header-edit') %>
<meta name="csrf-token" content="<%= Date.now() %>">

<div class="flex flex-col min-h-[calc(100vh-64px)] h-auto w-full">
  <!-- Top Navigation Bar -->
  <div
    class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 sm:gap-4 bg-white px-4 sm:px-6 py-3 border-b border-slate-300 shadow-sm flex-shrink-0">
    <div class="w-full sm:w-auto">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <!-- Room Name: AJAX rename, no page redirect -->
        <div class="flex items-center gap-2 flex-1 min-w-[150px]">
          <input type="text" id="roomNameInput" value="<%= room.name %>" data-room-id="<%= room.id %>" required
            class="text-base sm:text-xl font-bold text-slate-900 bg-transparent border-b-2 border-transparent hover:border-amber-300 focus:border-amber-500 focus:outline-none px-1 w-full"
            placeholder="Rename room...">
          <span id="roomNameStatus"
            class="text-xs text-emerald-600 opacity-0 transition-opacity whitespace-nowrap">Saved</span>
        </div>
        <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded-none uppercase tracking-wide whitespace-nowrap
          <%= room.status === 'published' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
          <%= room.status %>
        </span>
      </div>
    </div>

    <form action="/admin/toggle-publish/<%= room.id %>" method="POST" class="w-full sm:w-auto">
      <% if (room.status === 'published') { %>
      <button type="submit"
        class="w-full sm:w-auto bg-slate-800 hover:bg-[#333333] text-white text-sm font-semibold px-4 py-2 rounded-none shadow transition">
        Unpublish
      </button>
      <% } else { %>
      <button type="submit"
        class="w-full sm:w-auto bg-slate-800 hover:bg-[#333333] text-white text-sm font-semibold px-4 py-2 rounded-none shadow transition">
        Publish
      </button>
      <% } %>
    </form>
  </div>

  <!-- Full-height body: sidebar + content -->
  <div class="flex flex-col sm:flex-row flex-1 min-h-0">
    <!-- Sidebar: Trade Tabs -->
    <div
      class="w-full sm:w-64 flex-shrink-0 bg-white border-b sm:border-b-0 sm:border-r border-slate-300 flex flex-col max-h-[300px] sm:max-h-none sm:h-auto overflow-y-auto">
      <div class="flex items-center justify-between px-4 pt-3 pb-2 sm:pt-4">
        <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Trade Tabs</h2>
        <span class="text-xs text-slate-400 sm:hidden">Swipe to see all</span>
      </div>
      <!-- Add Trade Form -->
      <form action="/admin/edit/<%= room.id %>/add-trade" method="POST" class="p-3 sm:p-4 border-t border-slate-200"
        onsubmit="this.querySelector('button[type=submit]').disabled = true;">
        <label class="block text-xs text-slate-500 mb-1">Add New Trade</label>
        <div class="flex gap-1">
          <input type="text" name="tradeName" placeholder="e.g. Tile" required
            class="w-full text-xs px-2 py-1.5 border border-slate-300 rounded-none focus:outline-none focus:ring-1 focus:ring-amber-500">
          <button type="submit"
            class="bg-slate-800 text-white text-xs px-3 py-1 rounded-none hover:bg-slate-800 whitespace-nowrap">+
            Add</button>
        </div>
      </form>

      <div class="flex-1 overflow-y-auto">
        <% room.trades.forEach(t => { %>
        <div class="flex items-center justify-between group border-b border-slate-100 trade-tab-row"
          data-trade-id="<%= t.id %>">
          <a href="/admin/edit/<%= room.id %>?trade=<%= t.id %>"
            class="trade-tab-link flex-1 text-left px-4 py-2.5 sm:py-3 text-sm font-medium transition <%= selectedTrade === t.id ? 'bg-amber-50 text-amber-800 border-l-4 border-slate-800' : 'text-slate-600 hover:bg-slate-50 border-l-4 border-transparent' %>">
            <%= t.name %>
          </a>
          <input type="text" value="<%= t.name %>"
            class="trade-tab-input hidden flex-1 text-sm font-medium px-4 py-2.5 sm:py-3 border-0 border-l-4 border-slate-800 bg-amber-50 text-amber-800 focus:outline-none">
          <div class="flex items-center gap-1 pr-2 opacity-0 group-hover:opacity-100 transition">
            <button type="button" class="trade-rename-btn text-slate-400 hover:text-slate-800 text-xs"
              title="Rename">✎</button>
            <form id="delete-trade-form-<%= t.id %>" action="/admin/edit/<%= room.id %>/delete-trade/<%= t.id %>"
              method="POST" class="inline">
              <button type="button" onclick="openTradeDeleteModal('<%= t.id %>', '<%= t.name %>')"
                class="text-slate-400 hover:text-red-600" title="Delete">×</button>
            </form>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- Active Trade Details Editor -->
    <% const activeTrade = room.trades.find(t => t.id === selectedTrade); %>

    <div class="flex-1 overflow-y-auto bg-white p-4 sm:p-6">
      <% if (activeTrade) { %>
      <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-2 flex-wrap gap-2">
        <h2 class="text-base sm:text-lg font-bold text-slate-800">
          Editing: <span class="text-slate-800"><%= activeTrade.name %> Specs</span>
        </h2>
      </div>

      <!-- Main Form -->
      <form action="/admin/edit/<%= room.id %>/save" method="POST" enctype="multipart/form-data"
        class="space-y-4 sm:space-y-5"
        onsubmit="const btn = this.querySelector('button[type=submit]'); btn.disabled = true; btn.textContent = 'Saving...'; return true;">
        <input type="hidden" name="tradeId" value="<%= activeTrade.id %>">

        <!-- Legacy Single Upload Fields -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="border border-slate-200 p-4 rounded-none bg-slate-50">
            <label class="block text-xs font-bold text-slate-700 uppercase mb-2">3D Render / Photo</label>
            <% if (activeTrade.renderUrl) { %>
            <img src="<%= activeTrade.renderUrl %>"
              class="w-full h-32 object-cover rounded-none mb-2 border border-slate-200">
            <% } %>
            <input type="file" name="render" accept="image/*" class="text-xs text-slate-500 w-full">
          </div>

          <div class="border border-slate-200 p-4 rounded-none bg-slate-50">
            <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Plan / Drawing</label>
            <% if (activeTrade.planUrl) { %>
            <a href="<%= activeTrade.planUrl %>" target="_blank"
              class="text-xs text-slate-800 hover:underline block mb-2 font-medium truncate">
              View Attached Plan
            </a>
            <% } %>
            <input type="file" name="plan" accept="image/*,application/pdf" class="text-xs text-slate-500 w-full">
          </div>
        </div>

        <!-- Multiple Image/File Upload Section -->
        <div class="border border-slate-200 p-4 rounded-none bg-slate-50">
          <label class="block text-xs font-bold text-slate-700 uppercase mb-2">
            Upload Multiple Images & Files
          </label>

          <!-- Existing Files Display -->
          <% if (activeTrade.files && activeTrade.files.length > 0) { %>
          <div class="mb-4 space-y-2">
            <p class="text-sm font-medium text-slate-600">Current Files:</p>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              <% activeTrade.files.forEach((file, index) => { %>
              <div class="relative bg-white border border-slate-200 p-2 rounded-none">
                <% if (file.type === 'image') { %>
                <img src="<%= file.url %>" alt="<%= file.originalName %>" class="w-full h-24 object-cover mb-1">
                <% } else { %>
                <div class="w-full h-24 bg-slate-100 flex items-center justify-center mb-1">
                  <span class="text-2xl">📄</span>
                </div>
                <% } %>
                <p class="text-xs text-slate-600 truncate"><%= file.originalName %></p>

                <button type="button"
                  class="absolute top-1 right-1 text-red-500 hover:text-red-700 text-sm bg-white rounded-full w-5 h-5 flex items-center justify-center shadow"
                  onclick="openFileDeleteModal('<%= room.id %>', '<%= activeTrade.id %>', '<%= index %>', '<%= file.originalName %>')">
                  ×
                </button>
              </div>
              <% }) %>
            </div>
          </div>
          <% } %>

          <!-- File Input -->
          <div class="mt-2">
            <input type="file" name="files" multiple accept="image/*,application/pdf,.doc,.docx,.xls,.xlsx,.txt"
              class="text-xs text-slate-500 w-full">
            <p class="text-xs text-slate-400 mt-1">Hold Ctrl/Cmd to select multiple files. Supports images, PDFs, and
              documents.</p>
          </div>
        </div>

        <!-- Placement Notes -->
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Placement Notes & Instructions</label>
          <textarea name="notes" rows="5" placeholder="Specify outlet locations, elevations, notes..."
            class="w-full p-3 border border-slate-300 rounded-none text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"><%= activeTrade.notes %></textarea>
        </div>

        <!-- ========================================== -->
        <!-- COMMENTS SECTION (FIXED ATTACHMENTS)       -->
        <!-- ========================================== -->
        
        <div class="border-t border-slate-200 pt-5 mt-6">
          <h3 class="text-xs font-bold text-slate-700 uppercase mb-3">
            Client Comments (<%= (room.comments && room.comments.length) || 0 %>)
          </h3>

          <% if (room.comments && room.comments.length > 0) { %>
          <div class="space-y-3">
            <% room.comments.forEach((c) => { %>
            <div class="bg-slate-50 border border-slate-200 p-3 flex justify-between items-start gap-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-slate-900"><%= c.author || 'User' %></span>
                  <span class="text-[10px] text-slate-400">
                    <%= c.timestamp || '' %>
                  </span>
                </div>
                <p class="text-sm text-slate-700 whitespace-pre-line"><%= c.text %></p>

                <!-- Render Attachments -->
                <% if (c.attachments && c.attachments.length > 0) { %>
                <div class="flex flex-wrap gap-2 mt-3 pt-2 border-t border-slate-200/60">
                  <% c.attachments.forEach(att => { %>
                  <a href="<%= typeof att === 'string' ? att : att.url %>" target="_blank"
                    class="inline-flex items-center gap-1.5 text-xs text-amber-900 bg-amber-50 hover:bg-amber-100 border border-amber-200 px-2 py-1 transition font-medium">
                    <span>📎</span>
                    <span
                      class="truncate max-w-[180px]"><%= typeof att === 'string' ? 'Attachment' : (att.originalName || att.filename) %></span>
                  </a>
                  <% }) %>
                </div>
                <% } %>
              </div>

              <!-- Delete Comment Button -->
              <button type="button" onclick="openCommentDeleteModal('<%= room.id %>', '<%= c.id %>')"
                class="text-xs text-red-500 hover:text-red-700 font-medium whitespace-nowrap px-2 py-1 bg-white border border-red-200 hover:border-red-300">
                Delete
              </button>
            </div>
            <% }) %>
          </div>
          <% } else { %>
          <p class="text-xs text-slate-400 italic">No comments have been posted for this room yet.</p>
          <% } %>
        </div>

        <div class="pt-4">
          <button type="submit"
            class="w-full sm:w-auto bg-slate-800 hover:bg-slate-800 text-white font-semibold text-sm px-5 py-2.5 rounded-none shadow transition">
            Save Draft
          </button>
        </div>
      </form>
      <% } else { %>
      <p class="text-slate-500 text-sm">No trades configured for this room yet. Use the sidebar to add your first trade
        tab.</p>
      <% } %>
    </div>
  </div>
</div>

<div id="deleteModal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden">
  <div class="bg-white border border-slate-300 shadow-2xl max-w-md w-full p-6 space-y-4 rounded-none mx-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div>
        <h3 id="deleteModalTitle" class="text-base font-bold text-slate-900">Confirm Deletion</h3>
        <p class="text-xs text-slate-500 mt-0.5">This action cannot be undone.</p>
      </div>
    </div>

    <p id="deleteModalBody" class="text-sm text-slate-600">
      Are you sure you want to delete this item?
    </p>

    <div class="flex justify-end gap-2 pt-2 border-t border-slate-200">
      <button type="button" onclick="closeDeleteModal()"
        class="bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-semibold px-4 py-2 transition">
        Cancel
      </button>
      <button type="button" id="confirmDeleteBtn"
        class="bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-4 py-2 transition">
        Delete Permanently
      </button>
    </div>
  </div>
</div>

<script>
  // ---- Delete Modal State ----
  let deleteActionUrl = null;
  let targetFormId = null;

  function openTradeDeleteModal(tradeId, tradeName) {
    targetFormId = `delete-trade-form-${tradeId}`;
    deleteActionUrl = null;

    document.getElementById('deleteModalTitle').textContent = 'Delete Trade Tab';
    document.getElementById('deleteModalBody').innerHTML = `Are you sure you want to remove the <strong class="text-slate-900">${tradeName}</strong> tab and its specs?`;
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  function openFileDeleteModal(roomId, tradeId, fileIndex, fileName) {
    targetFormId = null;
    deleteActionUrl = `/admin/edit/${encodeURIComponent(roomId)}/delete-file/${encodeURIComponent(tradeId)}/${fileIndex}`;

    document.getElementById('deleteModalTitle').textContent = 'Delete File';
    document.getElementById('deleteModalBody').innerHTML = `Are you sure you want to delete <strong class="text-slate-900">${fileName}</strong>?`;
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  // Handle Comment Deletion Modal trigger
  function openCommentDeleteModal(roomId, commentId) {
    targetFormId = null;
    deleteActionUrl = `/admin/edit/${encodeURIComponent(roomId)}/delete-comment/${encodeURIComponent(commentId)}`;

    document.getElementById('deleteModalTitle').textContent = 'Delete Comment';
    document.getElementById('deleteModalBody').innerHTML = `Are you sure you want to delete this comment?`;
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  function closeDeleteModal() {
    targetFormId = null;
    deleteActionUrl = null;
    document.getElementById('deleteModal').classList.add('hidden');
  }

  // Handle Confirmation
  document.getElementById('confirmDeleteBtn').addEventListener('click', () => {
    if (targetFormId) {
      const form = document.getElementById(targetFormId);
      if (form) form.submit();
      return;
    }

    if (deleteActionUrl) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = deleteActionUrl;
      document.body.appendChild(form);
      form.submit();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDeleteModal();
  });

  // ---- Room name: AJAX rename ----
  (function () {
    const input = document.getElementById('roomNameInput');
    const status = document.getElementById('roomNameStatus');
    if (!input) return;

    let original = input.value;

    async function saveRoomName() {
      const newValue = input.value.trim();
      if (!newValue || newValue === original) return;

      try {
        const res = await fetch(`/admin/rooms/${encodeURIComponent(input.dataset.roomId)}/rename`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ newName: newValue })
        });

        if (res.ok) {
          original = newValue;
          status.textContent = 'Saved';
          status.classList.remove('opacity-0');
          setTimeout(() => status.classList.add('opacity-0'), 1200);
        } else {
          input.value = original;
        }
      } catch (err) {
        console.error('Failed to rename room:', err);
        input.value = original;
      }
    }

    input.addEventListener('blur', saveRoomName);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        input.blur();
      }
    });
  })();

  // ---- Trade tabs: inline rename ----
  document.querySelectorAll('.trade-tab-row').forEach(row => {
    const link = row.querySelector('.trade-tab-link');
    const input = row.querySelector('.trade-tab-input');
    const renameBtn = row.querySelector('.trade-rename-btn');
    const tradeId = row.dataset.tradeId;
    const roomId = '<%= room.id %>';
    let original = input.value;

    function enterEditMode(e) {
      if (e) e.preventDefault();
      link.classList.add('hidden');
      input.classList.remove('hidden');
      input.focus();
      input.select();
    }

    async function saveTradeName() {
      const newValue = input.value.trim();
      input.classList.add('hidden');
      link.classList.remove('hidden');

      if (!newValue || newValue === original) {
        input.value = original;
        return;
      }

      try {
        const res = await fetch(`/admin/edit/${encodeURIComponent(roomId)}/rename-trade/${encodeURIComponent(tradeId)}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ newName: newValue })
        });

        if (res.ok) {
          original = newValue;
          link.textContent = newValue;
        } else {
          input.value = original;
        }
      } catch (err) {
        console.error('Failed to rename trade:', err);
        input.value = original;
      }
    }

    renameBtn.addEventListener('click', enterEditMode);
    input.addEventListener('blur', saveTradeName);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        input.blur();
      } else if (e.key === 'Escape') {
        input.value = original;
        input.blur();
      }
    });
  });
</script>

<%- include('partials/footer') %>