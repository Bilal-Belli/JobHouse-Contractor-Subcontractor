<%- include('partials/admin-estimates-header') %>

<% 
  const draftsList = estimates.filter(e => e.status === 'draft');
  const publishedList = estimates.filter(e => e.status === 'published');
  const invoicesList = estimates.filter(e => e.status === 'invoiced');
%>

<main class="max-w-7xl mx-auto px-4 py-6 flex-grow w-full space-y-6">

  <!-- Top Action & Search Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-300 pb-4">
    <!-- Search Input -->
    <div class="relative w-full sm:w-72">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <input type="text" id="estimateSearchInput" onkeyup="filterEstimates()" placeholder="Search estimates..."
        class="w-full pl-9 pr-4 py-2 text-xs sm:text-sm bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all shadow-sm">
    </div>

    <!-- Right-aligned Button Group -->
    <div class="shrink-0 flex items-center justify-end gap-2">
      <button onclick="createNewEstimate()"
        class="bg-amber-600 hover:bg-amber-700 text-white font-semibold px-4 py-2 text-xs sm:text-sm shadow-sm transition-all flex items-center gap-2">
        New Estimate
      </button>
      <!-- UPDATED: Added onclick="toggleModal('settingsModal')" -->
      <button onclick="toggleModal('settingsModal')"
        class="bg-slate-50 hover:bg-slate-100 text-slate-800 font-semibold border border-slate-300 px-4 py-2 text-xs sm:text-sm shadow-sm transition-all flex items-center gap-2"
        title="Global Settings">
        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 010 4m-6 8a2 2 0 100-4m0 4a2 2 0 010-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 010-4m0 4v2m0-6V4">
          </path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Tab Switcher Header -->
  <div class="flex border-b border-slate-300">
    <button id="tabBtnDrafts" onclick="switchTab('drafts')"
      class="px-6 py-2.5 font-semibold text-sm border-b-2 border-amber-500 text-slate-900 transition-colors flex items-center gap-2">
      <span>Drafts</span>
      <span class="bg-amber-50 text-amber-700 text-xs px-2 py-0.5 rounded-full font-bold"
        id="draftsCount"><%= draftsList.length %></span>
    </button>

    <button id="tabBtnPublished" onclick="switchTab('published')"
      class="px-6 py-2.5 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-colors flex items-center gap-2">
      <span>Published</span>
      <span class="bg-emerald-100 text-emerald-800 text-xs px-2 py-0.5 rounded-full font-bold"
        id="publishedCount"><%= publishedList.length %></span>
    </button>

    <button id="tabBtnInvoices" onclick="switchTab('invoices')"
      class="px-6 py-2.5 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-colors flex items-center gap-2">
      <span>Invoices</span>
      <span class="bg-blue-100 text-blue-800 text-xs px-2 py-0.5 rounded-full font-bold"
        id="invoicesCount"><%= invoicesList.length %></span>
    </button>
  </div>

  <!-- ================= DRAFTS TAB ================= -->
  <div id="tabContentDrafts" class="space-y-4">
    <div class="bg-white shadow-sm border border-slate-200">
      <div id="draftsContainer" class="divide-y divide-slate-200">
        <% if (draftsList.length === 0) { %>
        <div class="p-8 text-center text-xs text-slate-400 italic">No drafts found. Click "New Estimate" to build one.
        </div>
        <% } %>

        <% draftsList.forEach(draft => { %>
        <div
          class="estimate-row p-4 hover:bg-slate-50/80 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
          draggable="true" data-id="<%= draft.id %>">
          <div class="flex items-center gap-3">
            <div class="cursor-grab text-slate-400 hover:text-slate-600 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path>
              </svg>
            </div>

            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <h3 class="font-bold text-slate-900 text-sm"><%= draft.projectName %></h3>
                <span class="text-[10px] bg-amber-100 text-amber-900 px-1.5 py-0.5 font-mono font-medium">Draft</span>
              </div>
              <p class="text-xs text-slate-500">Updated:
                <%= new Date(draft.updatedAt || draft.createdAt).toLocaleDateString() %></p>
            </div>
          </div>

          <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
            <button onclick="previewEstimate('<%= draft.id %>')"
              class="bg-slate-800 hover:bg-slate-900 text-white border border-slate-300 px-3 py-1.5 text-xs font-semibold transition-all">
              Preview
            </button>
            <a href="/admin/estimates/<%= draft.id %>/edit"
              class="bg-white hover:bg-slate-100 text-black border border-slate-300 px-3 py-1.5 text-xs font-semibold transition-all">
              Edit
            </a>
            <button onclick="duplicateEstimate('<%= draft.id %>')"
              class="bg-white hover:bg-slate-100 px-3 py-1.5 text-xs font-semibold text-black border border-slate-300 transition-all">
              Duplicate
            </button>
            <button onclick="openPublishModal('<%= draft.id %>')"
              class="bg-emerald-50 hover:bg-emerald-100 text-emerald-600 border border-emerald-300 px-3 py-1.5 text-xs font-semibold transition-all shadow-sm">
              Publish
            </button>
            <button onclick="promptDeleteEstimate('<%= draft.id %>', '<%= draft.projectName %>')"
              class="bg-red-50 hover:bg-red-100 text-red-600 border border-red-300 px-3 py-1.5 text-xs font-semibold transition-all">
              Delete
            </button>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- ================= PUBLISHED TAB ================= -->
  <div id="tabContentPublished" class="hidden space-y-4">
    <div class="bg-white shadow-sm border border-slate-200">
      <div id="publishedContainer" class="divide-y divide-slate-200">
        <% if (publishedList.length === 0) { %>
        <div class="p-8 text-center text-xs text-slate-400 italic">No published proposals yet.</div>
        <% } %>

        <% publishedList.forEach(pub => { %>
        <% const matchingCompany = companyProfiles.find(p => p.id === pub.companyProfileId); %>
        <div
          class="estimate-row p-4 hover:bg-slate-50/80 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
          draggable="true" data-id="<%= pub.id %>">
          <div class="flex items-center gap-3">
            <div class="cursor-grab text-slate-400 hover:text-slate-600 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path>
              </svg>
            </div>

            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <h3 class="font-bold text-slate-900 text-sm"><%= pub.projectName %></h3>
                <span
                  class="inline-flex items-center px-2 py-0.5 text-[10px] font-semibold bg-emerald-100 text-emerald-800">
                  <%= matchingCompany ? matchingCompany.name : 'Default Branding' %>
                </span>
              </div>
              <p class="text-xs text-slate-500">Published: <%= new Date(pub.publishedAt).toLocaleDateString() %></p>
            </div>
          </div>

          <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
            <a href="/est/<%= pub.publicId %>" target="_blank"
              class="bg-slate-800 hover:bg-slate-900 text-white px-3 py-1.5 text-xs font-semibold transition-all inline-block">
              View
            </a>
            <button onclick="openShareModal('<%= baseUrl %>/est/<%= pub.publicId %>', '<%= pub.projectName %>')"
              class="bg-white hover:bg-slate-100 text-black border border-slate-300 px-3 py-1.5 text-xs font-semibold transition-all">
              Share
            </button>
            <a href="/admin/estimates/<%= pub.id %>/edit"
              class="bg-white hover:bg-slate-100 text-black px-3 py-1.5 border border-slate-300 text-xs font-semibold transition-all">
              Edit
            </a>
            <button onclick="openConvertModal('<%= pub.id %>', '<%= pub.projectName %>')"
              class="bg-blue-50 hover:bg-blue-100 text-blue-600 px-3 py-1.5 border border-blue-300 text-xs font-semibold transition-all shadow-sm">
              Convert to Invoice
            </button>
            <button onclick="promptUnpublishEstimate('<%= pub.id %>', '<%= pub.projectName %>')"
              class="bg-amber-50 hover:bg-amber-100 text-amber-600 border border-amber-300 px-3 py-1.5 text-xs font-semibold transition-all">
              Unpublish
            </button>
            <button onclick="promptDeleteEstimate('<%= pub.id %>', '<%= pub.projectName %>')"
              class="bg-red-50 hover:bg-red-100 text-red-600 border border-red-300 px-3 py-1.5 text-xs font-semibold transition-all">
              Delete
            </button>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- ================= INVOICES TAB ================= -->
  <div id="tabContentInvoices" class="hidden space-y-4">
    <div class="bg-white shadow-sm border border-slate-200">
      <div id="invoicesContainer" class="divide-y divide-slate-200">
        <% if (invoicesList.length === 0) { %>
        <div class="p-8 text-center text-xs text-slate-400 italic">No converted invoices yet.</div>
        <% } %>

        <% invoicesList.forEach(inv => { %>
        <div
          class="estimate-row p-4 hover:bg-slate-50/80 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
          draggable="true" data-id="<%= inv.id %>">

          <div class="flex items-center gap-3">
            <!-- Drag Handle -->
            <div class="cursor-grab text-slate-400 hover:text-slate-600 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path>
              </svg>
            </div>

            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <h3 class="font-bold text-slate-900 text-sm"><%= inv.projectName %></h3>
                <span class="text-[10px] bg-blue-100 text-blue-900 px-2 py-0.5 font-mono font-bold">
                  #<%= inv.invoiceNumber || 'INV-DRAFT' %>
                </span>
              </div>
              <p class="text-xs text-slate-500">Invoiced:
                <%= new Date(inv.invoicedAt || inv.updatedAt).toLocaleDateString() %></p>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <a href="/inv/<%= inv.publicId %>" target="_blank"
              class="bg-slate-800 hover:bg-slate-900 text-white px-3 py-1.5 text-xs font-semibold transition-all inline-block">View</a>
            <button onclick="openShareModal('<%= baseUrl %>/inv/<%= inv.publicId %>', '<%= inv.projectName %>')"
              class="bg-white hover:bg-slate-100 text-black border border-slate-300 px-3 py-1.5 text-xs font-semibold transition-all">Share</button>
            <button onclick='openMilestonesModal("<%= inv.id %>", <%= JSON.stringify(inv.paymentMilestones || []) %>)'
              class="bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-300 px-3 py-1.5 text-xs font-semibold transition-all">Milestones</button>

            <button onclick="promptRevertToDraft('<%= inv.id %>', '<%= inv.projectName %>')"
              class="bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-300 px-3 py-1.5 text-xs font-semibold transition-all">
              Revert to Draft
            </button>
            <!-- Delete Button -->
            <button onclick="promptDeleteEstimate('<%= inv.id %>', '<%= inv.projectName %>')"
              class="bg-red-50 hover:bg-red-100 text-red-600 border border-red-300 px-3 py-1.5 text-xs font-semibold transition-all">
              Delete
            </button>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>

</main>

<!-- ================= MODAL: CONVERT ESTIMATE TO INVOICE ================= -->
<div id="convertModal"
  class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white max-w-md w-full shadow-2xl border border-slate-300 p-6 space-y-4">
    <h3 class="text-lg font-bold text-slate-900 border-b border-slate-200 pb-2">Convert Estimate to Invoice</h3>
    <input type="hidden" id="convertTargetId" value="">

    <p class="text-xs text-slate-600">Assign an invoice number to finalize converting <strong
        id="convertTargetName"></strong> into a billable invoice.</p>

    <div>
      <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Invoice Number</label>
      <input type="text" id="convertInvoiceNumber" placeholder="e.g. INV-1001"
        class="w-full bg-slate-50 border border-slate-300 p-2 text-xs font-mono font-bold focus:ring-2 focus:ring-blue-500">
    </div>

    <div class="flex justify-end gap-2 pt-2 border-t border-slate-200">
      <button onclick="toggleModal('convertModal')"
        class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 transition-all">Cancel</button>
      <button onclick="executeConvertInvoice()"
        class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 text-xs font-bold transition-all shadow-sm">
        Convert Now
      </button>
    </div>
  </div>
</div>

<!-- ================= MODAL: MANAGE MILESTONES ================= -->
<div id="milestonesModal"
  class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white max-w-lg w-full shadow-2xl border border-slate-300 p-6 space-y-4 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center border-b border-slate-200 pb-2">
      <h3 class="text-lg font-bold text-slate-900">Manage Payment Milestones</h3>
      <button onclick="toggleModal('milestonesModal')"
        class="text-slate-400 hover:text-slate-700 font-bold text-lg">&times;</button>
    </div>

    <input type="hidden" id="milestoneTargetId" value="">

    <div id="milestonesListContainer" class="space-y-3"></div>

    <button onclick="addMilestoneRow()"
      class="w-full py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold border border-slate-300 transition-all">+
      Add Payment Milestone</button>

    <div class="flex justify-end gap-2 pt-3 border-t border-slate-200">
      <button onclick="toggleModal('milestonesModal')"
        class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 transition-all">Cancel</button>
      <button onclick="saveMilestones()"
        class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 text-xs font-bold transition-all shadow-sm">Save
        Changes</button>
    </div>
  </div>
</div>

<!-- ================= MODAL: PUBLISH ESTIMATE ================= -->
<div id="publishModal"
  class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white max-w-md w-full shadow-2xl border border-slate-300 p-6 space-y-4">
    <h3 class="text-lg font-bold text-slate-900 border-b border-slate-200 pb-2">Publish Estimate</h3>
    <input type="hidden" id="publishTargetId" value="">

    <p class="text-xs text-slate-600">Select which company profile and client to assign to this proposal before
      publishing.</p>

    <!-- Company Profile Select -->
    <div>
      <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Company Profile *</label>
      <select id="companyProfileSelect"
        class="w-full bg-slate-50 border border-slate-300 p-2 text-xs font-semibold focus:ring-2 focus:ring-amber-500">
        <% companyProfiles.forEach(prof => { %>
        <option value="<%= prof.id %>"><%= prof.name %> (Lic: <%= prof.license || 'N/A' %>)</option>
        <% }); %>
      </select>
    </div>

    <!-- Client Profile Select with Quick Add Button -->
    <div>
      <div class="flex justify-between items-center mb-1">
        <label class="block text-xs font-bold text-slate-700 uppercase">Client Profile</label>
        <button type="button" onclick="openInlineClientModal()" class="text-xs text-amber-600 font-bold">Add
          Client</button>
      </div>
      <select id="clientProfileSelect"
        class="w-full bg-slate-50 border border-slate-300 p-2 text-xs font-semibold focus:ring-2 focus:ring-amber-500">
        <option value="">-- No Client Selected --</option>
        <% (typeof clientProfiles !== 'undefined' ? clientProfiles : []).forEach(client => { %>
        <option value="<%= client.id %>"><%= client.name %> (<%= client.phone || client.email || 'No contact info' %>)
        </option>
        <% }); %>
      </select>
    </div>

    <div class="flex justify-end gap-2 pt-2 border-t border-slate-200">
      <button onclick="toggleModal('publishModal')"
        class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 transition-all">Cancel</button>
      <button onclick="executePublish()"
        class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 text-xs font-bold transition-all shadow-sm">
        Publish Now
      </button>
    </div>
  </div>
</div>

<!-- ================= MODAL: INLINE QUICK ADD CLIENT ================= -->
<div id="inlineClientModal"
  class="hidden fixed inset-0 bg-slate-900/70 backdrop-blur-sm z-[60] flex items-center justify-center p-4">
  <div class="bg-white max-w-sm w-full shadow-2xl border border-slate-300 p-5 space-y-3">
    <div class="flex justify-between items-center border-b border-slate-200 pb-2">
      <h4 class="text-sm font-bold text-slate-900">Add New Client</h4>
      <button type="button" onclick="toggleModal('inlineClientModal')"
        class="text-slate-400 hover:text-slate-700 font-bold text-base">&times;</button>
    </div>

    <form id="inlineClientForm" onsubmit="saveInlineClient(event)" class="space-y-3 text-xs">
      <div>
        <label class="block font-bold text-slate-700 mb-0.5">Full Name *</label>
        <input type="text" id="inlineClientName" required placeholder="John Doe"
          class="w-full border border-slate-300 p-2 focus:ring-1 focus:ring-amber-500">
      </div>
      <div>
        <label class="block font-bold text-slate-700 mb-0.5">Phone Number</label>
        <input type="text" id="inlineClientPhone" placeholder="(555) 019-2831"
          class="w-full border border-slate-300 p-2 focus:ring-1 focus:ring-amber-500">
      </div>
      <div>
        <label class="block font-bold text-slate-700 mb-0.5">Email Address</label>
        <input type="email" id="inlineClientEmail" placeholder="john@example.com"
          class="w-full border border-slate-300 p-2 focus:ring-1 focus:ring-amber-500">
      </div>
      <div>
        <label class="block font-bold text-slate-700 mb-0.5">Address</label>
        <input type="text" id="inlineClientAddress" placeholder="123 Main St, City, State"
          class="w-full border border-slate-300 p-2 focus:ring-1 focus:ring-amber-500">
      </div>

      <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
        <button type="button" onclick="toggleModal('inlineClientModal')"
          class="px-3 py-1.5 font-bold text-slate-500 hover:bg-slate-100">Cancel</button>
        <button type="submit" class="bg-slate-900 text-white font-bold px-4 py-1.5 shadow-sm hover:bg-slate-800">Save &
          Select</button>
      </div>
    </form>
  </div>
</div>

<!-- ================= MODAL: GLOBAL SETTINGS ================= -->
<div id="settingsModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white max-w-lg w-full shadow-2xl border border-slate-300 p-6 space-y-4">
    <div class="flex justify-between items-center border-b border-slate-200 pb-2">
      <h3 class="text-lg font-bold text-slate-900">General Settings</h3>
      <button onclick="toggleModal('settingsModal')" class="text-slate-400 hover:text-slate-700 font-bold text-lg">&times;</button>
    </div>

    <div class="space-y-2">
      <label class="block text-xs font-bold text-slate-700 uppercase">Default General Terms & Conditions</label>
      <p class="text-xs text-slate-500">These default terms will automatically populate when creating a new estimate.</p>
      <textarea id="settingsGeneralTerms" rows="6"
        placeholder="Enter default terms & conditions..."
        class="w-full border border-slate-300 p-2 text-xs focus:ring-2 focus:ring-amber-500 font-sans leading-relaxed"><%= typeof generalTerms !== 'undefined' ? generalTerms : '' %></textarea>
    </div>

    <div class="flex justify-end gap-2 pt-3 border-t border-slate-200">
      <button onclick="toggleModal('settingsModal')" class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 transition-all">Cancel</button>
      <button onclick="saveGeneralTermsSettings()" class="bg-slate-900 hover:bg-slate-800 text-white px-4 py-2 text-xs font-bold transition-all shadow-sm">Save Terms</button>
    </div>
  </div>
</div>

<!-- ================= MODAL: QUICK ESTIMATE PREVIEW POPUP ================= -->
<div id="previewModal"
  class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white max-w-2xl w-full shadow-2xl border border-slate-300 p-6 space-y-6 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center border-b border-slate-200 pb-3">
      <h3 id="previewTitle" class="text-lg font-bold text-slate-900">Proposal Preview</h3>
      <button onclick="toggleModal('previewModal')"
        class="text-slate-400 hover:text-slate-700 font-bold text-lg">&times;</button>
    </div>

    <div id="previewContent" class="space-y-4"></div>

    <div class="flex justify-end border-t border-slate-200 pt-4">
      <button onclick="toggleModal('previewModal')"
        class="bg-slate-800 text-white text-xs font-bold px-4 py-2">Close</button>
    </div>
  </div>
</div>

<!-- ================= MODAL: CUSTOM DELETE CONFIRMATION ================= -->
<div id="deleteConfirmModal"
  class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white max-w-md w-full shadow-2xl border border-slate-300 p-6 space-y-4">
    <div class="flex items-center gap-3 border-b border-slate-200 pb-3 text-red-600">
      <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
        </path>
      </svg>
      <h3 class="text-lg font-bold text-slate-900">Delete Estimate</h3>
    </div>

    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
      Are you sure you want to delete <strong id="deleteTargetName" class="text-slate-900"></strong>?
    </p>

    <div class="flex justify-end gap-2 pt-2">
      <button onclick="toggleModal('deleteConfirmModal')"
        class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 transition-all">Cancel</button>
      <button id="confirmDeleteBtn"
        class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 text-xs font-bold transition-all shadow-sm">Delete
        Estimate</button>
