<!-- ================= MODAL: REVERT TO DRAFT CONFIRMATION ================= -->
<div id="revertConfirmModal"
  class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white max-w-md w-full shadow-2xl border border-slate-300 p-6 space-y-4">
    <div class="flex items-center gap-3 border-b border-slate-200 pb-3 text-amber-600">
      <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
        </path>
      </svg>
      <h3 class="text-lg font-bold text-slate-900">Revert to Draft</h3>
    </div>

    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
      Are you sure you want to revert <strong id="revertTargetName" class="text-slate-900"></strong> back to a draft?
    </p>

    <div class="flex justify-end gap-2 pt-2">
      <button onclick="toggleModal('revertConfirmModal')"
        class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 transition-all">Cancel</button>
      <button id="confirmRevertBtn"
        class="bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 text-xs font-bold transition-all shadow-sm">
        Revert Invoice
      </button>
    </div>
  </div>
</div>

<script>
  let targetEstimateId = null;

  document.addEventListener('DOMContentLoaded', () => {
    setupListDragAndDrop('draftsContainer');
    setupListDragAndDrop('publishedContainer');
    setupListDragAndDrop('invoicesContainer');

    // Restore active tab from localStorage on reload (defaults to 'drafts')
    const activeTab = localStorage.getItem('activeEstimateTab') || 'drafts';
    switchTab(activeTab);
  });

  function toggleModal(id) {
    document.getElementById(id).classList.toggle('hidden');
  }

  function switchTab(tab) {
    // Save selected tab state to browser storage
    localStorage.setItem('activeEstimateTab', tab);

    const dContent = document.getElementById('tabContentDrafts');
    const pContent = document.getElementById('tabContentPublished');
    const iContent = document.getElementById('tabContentInvoices');
    const dBtn = document.getElementById('tabBtnDrafts');
    const pBtn = document.getElementById('tabBtnPublished');
    const iBtn = document.getElementById('tabBtnInvoices');

    dContent.classList.add('hidden');
    pContent.classList.add('hidden');
    iContent.classList.add('hidden');

    dBtn.className = "px-6 py-2.5 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-colors flex items-center gap-2";
    pBtn.className = "px-6 py-2.5 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-colors flex items-center gap-2";
    iBtn.className = "px-6 py-2.5 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-colors flex items-center gap-2";

    if (tab === 'drafts') {
      dContent.classList.remove('hidden');
      dBtn.className = "px-6 py-2.5 font-semibold text-sm border-b-2 border-amber-500 text-slate-900 transition-colors flex items-center gap-2";
    } else if (tab === 'published') {
      pContent.classList.remove('hidden');
      pBtn.className = "px-6 py-2.5 font-semibold text-sm border-b-2 border-emerald-500 text-slate-900 transition-colors flex items-center gap-2";
    } else if (tab === 'invoices') {
      iContent.classList.remove('hidden');
      iBtn.className = "px-6 py-2.5 font-semibold text-sm border-b-2 border-blue-500 text-slate-900 transition-colors flex items-center gap-2";
    }
  }

  async function executeConvertInvoice() {
    const id = document.getElementById('convertTargetId').value;
    const invoiceNumber = document.getElementById('convertInvoiceNumber').value;

    const res = await fetch(`/admin/estimates/${id}/convert-to-invoice`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ invoiceNumber })
    });

    const data = await res.json();
    if (data.success) {
      // Set active tab to 'invoices' BEFORE reloading
      localStorage.setItem('activeEstimateTab', 'invoices');
      window.location.reload();
    } else {
      alert(data.error || 'Failed to convert estimate to invoice.');
    }
  }

  function openConvertModal(id, name) {
    document.getElementById('convertTargetId').value = id;
    document.getElementById('convertTargetName').textContent = name;

    const currentYear = new Date().getFullYear().toString().slice(-2);
    const regex = new RegExp(`^${currentYear}-(\\d{4})$`);
    let maxSeq = 0;

    <% invoicesList.forEach(inv => { %>
      if ("<%= inv.invoiceNumber || '' %>") {
        const match = "<%= inv.invoiceNumber %>".match(regex);
        if (match) {
          const num = parseInt(match[1], 10);
          if (num > maxSeq) maxSeq = num;
        }
      }
    <% }); %>

    const nextInvoiceNum = `${currentYear}-${String(maxSeq + 1).padStart(4, '0')}`;
    document.getElementById('convertInvoiceNumber').value = nextInvoiceNum;

    toggleModal('convertModal');
  }

  function openMilestonesModal(id, milestones) {
    document.getElementById('milestoneTargetId').value = id;
    const container = document.getElementById('milestonesListContainer');
    container.innerHTML = '';

    const list = milestones.length > 0 ? milestones : [
      { title: 'Deposit', percentage: 50, status: 'pending' },
      { title: 'Final Completion', percentage: 50, status: 'pending' }
    ];

    list.forEach(m => addMilestoneRow(m));
    toggleModal('milestonesModal');
  }

  function addMilestoneRow(data = { title: '', percentage: 0, status: 'pending' }) {
    const container = document.getElementById('milestonesListContainer');
    const div = document.createElement('div');
    div.className = "milestone-row flex items-center gap-2 bg-slate-50 p-2 border border-slate-200";

    div.innerHTML = `
      <input type="text" value="${data.title}" placeholder="Milestone Title" class="m-title flex-grow border border-slate-300 p-1.5 text-xs font-semibold">
      <input type="number" value="${data.percentage}" placeholder="%" class="m-percent w-16 border border-slate-300 p-1.5 text-xs text-right font-mono">
      <select class="m-status border border-slate-300 p-1.5 text-xs font-bold bg-white">
        <option value="pending" ${data.status === 'pending' ? 'selected' : ''}>Pending</option>
        <option value="paid" ${data.status === 'paid' ? 'selected' : ''}>Paid</option>
      </select>
      <button onclick="this.closest('.milestone-row').remove()" class="text-slate-400 hover:text-red-600 font-bold px-1">&times;</button>
    `;
    container.appendChild(div);
  }

  async function saveMilestones() {
    const id = document.getElementById('milestoneTargetId').value;
    const milestones = [];

    document.querySelectorAll('#milestonesListContainer .milestone-row').forEach(row => {
      milestones.push({
        title: row.querySelector('.m-title').value,
        percentage: parseFloat(row.querySelector('.m-percent').value) || 0,
        status: row.querySelector('.m-status').value
      });
    });

    const res = await fetch(`/admin/estimates/${id}/milestones`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ milestones })
    });

    const data = await res.json();
    if (data.success) {
      window.location.reload();
    } else {
      alert('Failed to update milestones.');
    }
  }

  function createNewEstimate() {
    const newId = 'est_' + Date.now();
    window.location.href = `/admin/estimates/${newId}/edit`;
  }

  function openPublishModal(id) {
    document.getElementById('publishTargetId').value = id;
    toggleModal('publishModal');
  }

  async function executePublish() {
    const estimateId = document.getElementById('publishTargetId').value;
    const companyProfileId = document.getElementById('companyProfileSelect').value;
    const clientProfileId = document.getElementById('clientProfileSelect').value;

    if (!companyProfileId) {
      alert('Please create or select a company profile first.');
      return;
    }

    const res = await fetch(`/admin/estimates/${estimateId}/publish`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ companyProfileId, clientProfileId })
    });

    const data = await res.json();
    if (data.success) {
      localStorage.setItem('activeEstimateTab', 'published');
      window.location.reload();
    } else {
      alert(data.error || 'Failed to publish estimate.');
    }
  }

  async function previewEstimate(id) {
    const res = await fetch(`/admin/estimates/${id}/get`);
    const est = await res.json();

    if (!est) return;

    document.getElementById('previewTitle').textContent = est.projectName;

    let tradesHtml = '';
    let grandTotal = 0;

    (est.trades || []).forEach(t => {
      const sub = parseFloat(t.subCost) || 0;
      const mkVal = parseFloat(t.markup?.value) || 0;
      const mkType = t.markup?.type || 'percent';
      let lineTotal = sub + (mkType === 'percent' ? sub * (mkVal / 100) : mkVal);
      grandTotal += lineTotal;

      tradesHtml += `
        <tr class="border-b border-slate-100 text-xs">
          <td class="p-2 font-bold text-slate-800">${t.name || 'General'}</td>
          <td class="p-2 text-slate-600">${t.description || ''}</td>
          <td class="p-2 text-right font-mono font-semibold">$${lineTotal.toFixed(2)}</td>
        </tr>
      `;
    });

    const ohVal = parseFloat(est.overhead?.value) || 0;
    const ohType = est.overhead?.type || 'percent';
    const ohTotal = ohType === 'percent' ? grandTotal * (ohVal / 100) : ohVal;
    grandTotal += ohTotal;

    document.getElementById('previewContent').innerHTML = `
      <div class="border border-slate-200 p-4 bg-slate-50 space-y-4">
        <table class="w-full text-left">
          <thead class="bg-slate-200 text-[10px] uppercase font-bold text-slate-600">
            <tr><th class="p-2">Trade</th><th class="p-2">Description</th><th class="p-2 text-right">Amount</th></tr>
          </thead>
          <tbody>${tradesHtml}</tbody>
        </table>
        <div class="border-t border-slate-300 pt-3 flex justify-between font-bold text-sm">
          <span>Client Grand Total:</span>
          <span class="font-mono text-base">$${grandTotal.toFixed(2)}</span>
        </div>
      </div>
    `;

    toggleModal('previewModal');
  }

  async function duplicateEstimate(id) {
    const res = await fetch(`/admin/estimates/${id}/duplicate`, { method: 'POST' });
    const data = await res.json();
    if (data.success) window.location.reload();
  }

  function promptDeleteEstimate(id, name) {
    targetEstimateId = id;
    document.getElementById('deleteTargetName').textContent = name;
    document.getElementById('confirmDeleteBtn').onclick = executeDeleteEstimate;
    toggleModal('deleteConfirmModal');
  }

  async function executeDeleteEstimate() {
    if (!targetEstimateId) return;
    const res = await fetch(`/admin/estimates/${targetEstimateId}/delete`, { method: 'POST' });
    const data = await res.json();
    if (data.success) window.location.reload();
  }

  function filterEstimates() {
    const q = document.getElementById('estimateSearchInput').value.toLowerCase().trim();
    document.querySelectorAll('.estimate-row').forEach(row => {
      row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
  }

  let currentShareUrl = '';
  let targetUnpublishId = null;

  function openShareModal(url, title) {
    currentShareUrl = url;
    const message = encodeURIComponent(`Here is the official document for ${title}: ${url}`);

    document.getElementById('shareWhatsappBtn').href = `https://api.whatsapp.com/send?text=${message}`;
    document.getElementById('shareSmsBtn').href = `sms:?body=${message}`;
    document.getElementById('shareEmailBtn').href = `mailto:?subject=${encodeURIComponent('Proposal Document - ' + title)}&body=${message}`;

    toggleModal('shareModal');
  }

  function copyShareLinkDirect() {
    if (currentShareUrl) {
      navigator.clipboard.writeText(currentShareUrl);
    }
  }

  function promptUnpublishEstimate(id, name) {
    targetUnpublishId = id;
    document.getElementById('unpublishTargetName').textContent = name;
    document.getElementById('confirmUnpublishBtn').onclick = executeUnpublishEstimate;
    toggleModal('unpublishConfirmModal');
  }

  async function executeUnpublishEstimate() {
    if (!targetUnpublishId) return;

    const res = await fetch(`/admin/estimates/${targetUnpublishId}/unpublish`, { method: 'POST' });
    const data = await res.json();

    if (data.success) {
      localStorage.setItem('activeEstimateTab', 'drafts');
      window.location.reload();
    } else {
      alert(data.error || 'Failed to unpublish estimate.');
    }
  }

  function setupListDragAndDrop(containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;

    let draggedRow = null;

    container.querySelectorAll('.estimate-row').forEach(row => {
      row.addEventListener('dragstart', () => {
        draggedRow = row;
        row.classList.add('opacity-50', 'bg-amber-50');
      });

      row.addEventListener('dragend', () => {
        row.classList.remove('opacity-50', 'bg-amber-50');
        draggedRow = null;
        saveEstimatesOrder(containerId);
      });
    });

    container.addEventListener('dragover', (e) => {
      e.preventDefault();
      const rows = [...container.querySelectorAll('.estimate-row:not(.opacity-50)')];
      const afterElement = rows.reduce((closest, child) => {
        const box = child.getBoundingClientRect();
        const offset = e.clientY - box.top - box.height / 2;
        if (offset < 0 && offset > closest.offset) {
          return { offset: offset, element: child };
        } else {
          return closest;
        }
      }, { offset: Number.NEGATIVE_INFINITY }).element;

      if (afterElement == null) {
        container.appendChild(draggedRow);
      } else {
        container.insertBefore(draggedRow, afterElement);
      }
    });
  }

  async function saveEstimatesOrder(containerId) {
    const container = document.getElementById(containerId);
    const order = [...container.querySelectorAll('.estimate-row')].map(row => row.getAttribute('data-id'));

    await fetch('/admin/estimates/reorder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ order })
    });
  }

  let targetRevertId = null;

  function promptRevertToDraft(id, name) {
    targetRevertId = id;
    document.getElementById('revertTargetName').textContent = name;
    document.getElementById('confirmRevertBtn').onclick = executeRevertToDraft;
    toggleModal('revertConfirmModal');
  }

  async function executeRevertToDraft() {
    if (!targetRevertId) return;

    const res = await fetch(`/admin/estimates/${targetRevertId}/revert-to-draft`, { method: 'POST' });
    const data = await res.json();

    if (data.success) {
      localStorage.setItem('activeEstimateTab', 'drafts');
      window.location.reload();
    } else {
      alert(data.error || 'Failed to revert invoice to draft.');
    }
  }

  function openInlineClientModal() {
    document.getElementById('inlineClientForm').reset();
    toggleModal('inlineClientModal');
  }

  async function saveInlineClient(e) {
    e.preventDefault();
    const payload = {
      id: '',
      name: document.getElementById('inlineClientName').value,
      phone: document.getElementById('inlineClientPhone').value,
      email: document.getElementById('inlineClientEmail').value,
      address: document.getElementById('inlineClientAddress').value
    };

    const res = await fetch('/admin/client-profiles', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const result = await res.json();
    if (result.success && result.profile) {
      const select = document.getElementById('clientProfileSelect');
      const option = document.createElement('option');
      option.value = result.profile.id;
      option.textContent = `${result.profile.name} (${result.profile.phone || result.profile.email || 'No contact info'})`;
      option.selected = true;
      select.appendChild(option);

      toggleModal('inlineClientModal');
    } else {
      alert('Failed to create client.');
    }
  }

  async function saveGeneralTermsSettings() {
    const generalTerms = document.getElementById('settingsGeneralTerms').value;

    const res = await fetch('/admin/settings/general-terms', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ generalTerms })
    });

    const data = await res.json();
    if (data.success) {
      toggleModal('settingsModal');
    } else {
      alert('Failed to update general terms settings.');
    }
  }
</script>