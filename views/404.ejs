<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>404 - Page Not Found</title>
        <link rel="icon" type="image/x-icon" href="<%= baseUrl %>/favicon.ico">
        <!-- Tailwind CSS via CDN -->
        <script src="https://cdn.tailwindcss.com"></script>
    </head>

    <body class="bg-[#D0CBC4] text-slate-900 antialiased font-serif flex flex-col min-h-screen">

        <main class="flex-grow flex items-center justify-center p-4">
            <div class="max-w-md w-full bg-white border border-slate-300 shadow-lg p-8 text-center font-sans space-y-6">

                <!-- Big Visual Indicator -->
                <div class="inline-flex items-center justify-center w-20 h-20 bg-amber-100 rounded-full text-amber-600">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
                        </path>
                    </svg>
                </div>

                <!-- Error Content -->
                <div class="space-y-2">
                    <h1 class="text-5xl font-black text-slate-900 tracking-tight">404</h1>
                    <h2 class="text-lg font-bold text-slate-800 uppercase tracking-wide">Page Not Found</h2>
                    <p class="text-xs text-slate-600 leading-relaxed">
                        The jobsite specification, room folder, or admin page you are looking for doesn't exist or has
                        been moved.
                    </p>
                </div>

                <!-- Actions -->
                <div class="pt-2 flex flex-col sm:flex-row gap-2 justify-center">
                    <a href="/"
                        class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold px-4 py-2.5 rounded-none transition">
                        Go to Home
                    </a>
                    <a href="/admin"
                        class="bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold px-4 py-2.5 rounded-none transition">
                        Admin Dashboard
                    </a>
                </div>

            </div>
        </main>

        <footer class="text-center py-4 text-xs text-slate-500 font-sans">
            &copy; JobSite Specs Portal
        </footer>

    </body>

</html>