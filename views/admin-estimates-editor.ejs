<%- include('partials/admin-estimates-header') %>

<main class="max-w-5xl mx-auto px-4 py-6 flex-grow w-full space-y-6">

    <!-- Editor Top Bar -->
    <div class="flex justify-between items-center pb-4">
        <a href="/admin/estimates"
            class="text-xs font-bold text-amber-600 hover:text-amber-900 flex items-center gap-1">
            Back to Estimates
        </a>

        <div class="flex items-center gap-2">
            <button onclick="saveCurrentEstimate(true)"
                class="bg-white hover:bg-slate-100 text-slate-800 font-semibold border border-slate-300 p-2 text-xs sm:text-sm shadow-sm transition-all flex items-center gap-1.5">
                Save
            </button>
            <button onclick="toggleModal('publishModal')"
                class="bg-white hover:bg-slate-100 text-slate-800 font-semibold border border-slate-300 p-2 text-xs sm:text-sm shadow-sm transition-all flex items-center gap-1.5">
                Publish
            </button>
        </div>
    </div>

    <!-- Workspace Form -->
    <div class="bg-slate-100 shadow-sm border border-slate-200 p-6 space-y-6">
        <input type="hidden" id="activeEstimateId" value="<%= estimate.id %>">

        <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-black flex items-center gap-2 mb-3"><span
                    class="w-1 h-4 bg-slate-400 block"></span>Estimate Title</h3>
            <input type="text" id="activeProjectName" value="<%= estimate.projectName %>" oninput="debouncedAutoSave()"
                class="w-full px-3 py-2 text-slate-500 font-semibold bg-slate-50 border border-slate-300 focus:bg-white focus:ring-2 focus:ring-slate-500 focus:outline-none">
        </div>

        <!-- Trade Line Items Header -->
        <div class="flex justify-between items-center pt-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-black flex items-center gap-2 mb-3"><span
                    class="w-1 h-4 bg-slate-400 block"></span>Trade Line Items</h3>
            <button onclick="addTradeRow()"
                class="text-xs font-semibold bg-amber-50 text-amber-600 hover:text-amber-700 border border-amber-300 flex items-center gap-1 p-2">
                + Add Trade Line
            </button>
        </div>

        <!-- Trades Reorderable Container -->
        <div id="tradesContainer" class="space-y-4">
            <% (estimate.trades || []).forEach(trade => { %>
            <div class="trade-item bg-white p-4 border border-slate-200 shadow-sm space-y-3" draggable="true">

                <!-- Card Top Bar: Drag Handle on Left, Trade Input in Middle, Simple 'X' Delete on Right -->
                <div class="flex justify-between items-center border-b border-slate-100 pb-2">
                    <div class="cursor-grab text-slate-400 hover:text-slate-600 shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16">
                            </path>
                        </svg>
                    </div>

                    <button onclick="this.closest('.trade-item').remove(); recalculateTotals(); debouncedAutoSave();"
                        class="text-slate-400 hover:text-red-600 font-bold text-lg px-2 shrink-0 transition-colors"
                        title="Remove Trade">
                        &times;
                    </button>
                </div>

                <!-- Trade Name (Now on its own dedicated line) -->
                <div>
                    <label
                        class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Trade</label>
                    <input type="text" value="<%= trade.name %>" placeholder="e.g. Electrical / Plumbing"
                        oninput="debouncedAutoSave()"
                        class="trade-name-input w-full text-xs font-bold text-slate-800 bg-slate-50 border border-slate-300 px-2.5 py-1.5 focus:bg-white focus:ring-1 focus:ring-amber-500">
                </div>

                <!-- Item Description -->
                <div>
                    <label
                        class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Description</label>
                    <input type="text" value="<%= trade.description %>" placeholder="Describe the scope of work..."
                        oninput="debouncedAutoSave()"
                        class="trade-desc-input w-full text-xs text-slate-700 bg-slate-50 border border-slate-300 px-2.5 py-1.5 focus:bg-white focus:ring-1 focus:ring-amber-500">
                </div>

                <!-- Financial Metrics Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 bg-slate-50/80 p-3 border border-slate-100">
                    <!-- Subcontractor Cost -->
                    <div>
                        <span class="text-[10px] text-slate-400 font-bold block uppercase mb-1">Sub Cost ($)</span>
                        <input type="number" value="<%= trade.subCost %>"
                            oninput="recalculateTotals(); debouncedAutoSave();"
                            class="sub-cost-input w-full text-xs text-right font-mono bg-white border border-slate-300 px-2 py-1.5">
                    </div>

                    <!-- Markup & Type Select -->
                    <div>
                        <span class="text-[10px] text-slate-400 font-bold block uppercase mb-1">Markup</span>
                        <div class="flex">
                            <input type="number" value="<%= trade.markup ? trade.markup.value : 0 %>"
                                oninput="recalculateTotals(); debouncedAutoSave();"
                                class="markup-val-input w-full text-xs text-right font-mono bg-white border border-r-0 border-slate-300 px-2 py-1.5">
                            <select onchange="recalculateTotals(); debouncedAutoSave();"
                                class="markup-type-input bg-slate-200 text-slate-900 text-xs font-bold border border-slate-300 w-10 text-center focus:outline-none shrink-0 cursor-pointer">
                                <option value="percent"
                                    <%= (trade.markup && trade.markup.type === 'percent') ? 'selected' : '' %>>%
                                </option>
                                <option value="flat"
                                    <%= (trade.markup && trade.markup.type === 'flat') ? 'selected' : '' %>>$</option>
                            </select>
                        </div>
                    </div>

                    <!-- Calculated Client Total -->
                    <div
                        class="col-span-2 sm:col-span-1 flex flex-col justify-center text-right border-t sm:border-t-0 sm:border-l border-slate-200 pt-2 sm:pt-0 sm:pl-3">
                        <span class="text-[10px] text-slate-400 font-bold uppercase">Client Price</span>
                        <span class="line-total-val text-sm font-extrabold text-slate-900 font-mono">$0.00</span>
                    </div>
                </div>

            </div>
            <% }); %>
        </div>

        <!-- Internal Contractor Financial Summary -->
        <div class="bg-white border border-slate-200 p-5 space-y-4 shadow-sm">
            <h4
                class="text-xs font-bold text-slate-800 uppercase tracking-wider border-b border-slate-200 pb-2 flex items-center gap-2">
                <span class="w-1 h-3 bg-amber-500 block"></span> Internal Financial Breakdown
            </h4>

            <div class="grid grid-cols-2 gap-3 text-xs sm:text-sm">
                <div class="text-slate-600 font-medium">Total Subcontractor Cost:</div>
                <div id="summarySubTotal" class="text-right font-mono font-bold text-slate-800">$0.00</div>

                <div class="text-slate-600 font-medium">Total Markup / Gross Profit:</div>
                <div id="summaryMarkupTotal" class="text-right font-mono font-bold text-emerald-600">$0.00</div>

                <div class="flex items-center gap-2 text-slate-600 font-medium">
                    <span>Overhead Fee:</span>
                    <input type="number" id="overheadVal" value="<%= estimate.overhead ? estimate.overhead.value : 0 %>"
                        oninput="recalculateTotals(); debouncedAutoSave();"
                        class="w-16 text-slate-900 bg-slate-50 border border-slate-300 text-xs px-2 py-1 font-mono text-right">
                    <select id="overheadType" onchange="recalculateTotals(); debouncedAutoSave();"
                        class="bg-slate-200 text-slate-900 text-xs font-bold border border-slate-300 w-10 text-center focus:outline-none shrink-0 cursor-pointer">
                        <option value="percent"
                            <%= (estimate.overhead && estimate.overhead.type === 'percent') ? 'selected' : '' %>>%
                        </option>
                        <option value="flat"
                            <%= (estimate.overhead && estimate.overhead.type === 'flat') ? 'selected' : '' %>>$</option>
                    </select>
                </div>
                <div id="summaryOverheadTotal" class="text-right font-mono font-bold text-slate-800">$0.00</div>
            </div>

            <div
                class="border-t border-slate-200 pt-3 flex justify-between items-center text-sm sm:text-base font-bold bg-slate-50 p-3">
                <span class="text-slate-900 uppercase tracking-wider">Client Grand Total:</span>
                <span id="summaryGrandTotal" class="font-mono text-lg sm:text-xl text-amber-600">$0.00</span>
            </div>
        </div>

        <!-- Payment Schedule & Additional Terms -->
        <div class="bg-white border border-slate-200 p-5 space-y-4 shadow-sm">
            <h4
                class="text-xs font-bold text-slate-800 uppercase tracking-wider border-b border-slate-200 pb-2 flex items-center gap-2">
                <span class="w-1 h-3 bg-slate-800 block"></span> Payment Terms & Legal Clauses
            </h4>

            <div class="space-y-4 text-xs">
                <!-- Payment Schedule -->
                <div>
                    <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">
                        Payment Schedule (Deposit & Progress Payments)
                    </label>
                    <textarea id="paymentSchedule" rows="3" oninput="debouncedAutoSave()"
                        placeholder="e.g. 30% Deposit upon signing, 40% Mid-project completion, 30% Final walk-through completion..."
                        class="w-full text-xs text-slate-700 bg-slate-50 border border-slate-300 p-2.5 focus:bg-white focus:ring-1 focus:ring-amber-500 focus:outline-none"><%= estimate.paymentSchedule || '' %></textarea>
                </div>

                <!-- Additional Terms & Liabilities -->
                <div>
                    <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">
                        Additional Terms, Exclusions & Change Order Releases
                    </label>
                    <textarea id="additionalTerms" rows="4" oninput="debouncedAutoSave()"
                        placeholder="e.g. Price estimate valid for 30 days. Any unmapped structural conditions or unforeseen permit requirements subject to written Change Orders. Liability limited to scope of work specified."
                        class="w-full text-xs text-slate-700 bg-slate-50 border border-slate-300 p-2.5 focus:bg-white focus:ring-1 focus:ring-amber-500 focus:outline-none"><%= estimate.additionalTerms || '' %></textarea>
                </div>

                <!-- General Terms & Conditions -->
                <div>
                    <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">
                        General Terms & Conditions
                    </label>
                    <textarea id="generalTerms" rows="4" oninput="debouncedAutoSave()"
                        placeholder="Enter standard terms and conditions..."
                        class="w-full text-xs text-slate-700 bg-slate-50 border border-slate-300 p-2.5 focus:bg-white focus:ring-1 focus:ring-amber-500 focus:outline-none"><%= estimate.generalTerms || 'This estimate is valid for 30 days and is based on the scope described above; any changes to that scope, materials, or design will be documented and priced as a written change order before proceeding. Prices reflect current material costs and may be adjusted if those costs change significantly before work begins. Estimated start and completion dates are approximate and may shift due to weather, permitting, or other factors outside our control. All work is performed by licensed, insured professionals. Acceptance of this estimate (in writing or by signature) constitutes agreement to these terms.' %></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- Professional Save Toast Notification -->
    <div id="saveToast"
        class="hidden fixed bottom-5 right-5 z-50 bg-slate-900 text-white px-4 py-3 shadow-xl border border-slate-700 flex items-center gap-2 transition-all">
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <span class="text-xs font-bold tracking-wide">Estimate Saved</span>
    </div>
</main>

<!-- ================= MODAL: PUBLISH SELECTION ================= -->
<div id="publishModal"
    class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white max-w-md w-full shadow-2xl border border-slate-300 p-6 space-y-4">
        <h3 class="text-lg font-bold text-slate-900 border-b border-slate-200 pb-2">Publish Estimate</h3>
        <p class="text-xs text-slate-600">Select which operating company profile to brand this quote with.</p>

        <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Company Profile</label>
            <select id="companyProfileSelect"
                class="w-full bg-slate-50 border border-slate-300 p-2 text-sm font-semibold">
                <% companyProfiles.forEach(prof => { %>
                <option value="<%= prof.id %>"><%= prof.name %></option>
                <% }); %>
            </select>
        </div>

        <div class="flex justify-end space-x-2 pt-2">
            <button onclick="toggleModal('publishModal')"
                class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 transition-all">Cancel</button>
            <button onclick="executePublish()"
                class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 text-xs font-bold transition-all shadow-sm">Publish
                Now</button>
        </div>
    </div>
</div>

<script>
    let autoSaveTimer = null;

    document.addEventListener('DOMContentLoaded', () => {
        recalculateTotals();
        setupDragAndDrop();
    });

    function toggleModal(id) {
        document.getElementById(id).classList.toggle('hidden');
    }

    function recalculateTotals() {
        let grandSubTotal = 0;
        let grandLineTotal = 0;

        document.querySelectorAll('.trade-item').forEach(item => {
            const subCost = parseFloat(item.querySelector('.sub-cost-input').value) || 0;
            const markupVal = parseFloat(item.querySelector('.markup-val-input').value) || 0;
            const markupType = item.querySelector('.markup-type-input').value;

            let lineTotal = subCost + (markupType === 'percent' ? subCost * (markupVal / 100) : markupVal);
            item.querySelector('.line-total-val').textContent = `$${lineTotal.toFixed(2)}`;

            grandSubTotal += subCost;
            grandLineTotal += lineTotal;
        });

        const overheadVal = parseFloat(document.getElementById('overheadVal').value) || 0;
        const overheadType = document.getElementById('overheadType').value;
        const totalOverhead = overheadType === 'percent' ? grandLineTotal * (overheadVal / 100) : overheadVal;

        document.getElementById('summarySubTotal').textContent = `$${grandSubTotal.toFixed(2)}`;
        document.getElementById('summaryMarkupTotal').textContent = `$${((grandLineTotal - grandSubTotal) + totalOverhead).toFixed(2)}`;
        document.getElementById('summaryOverheadTotal').textContent = `$${totalOverhead.toFixed(2)}`;
        document.getElementById('summaryGrandTotal').textContent = `$${(grandLineTotal + totalOverhead).toFixed(2)}`;
    }

    function addTradeRow(data = { name: '', description: '', subCost: 0, markupVal: 0, markupType: 'percent' }) {
        const container = document.getElementById('tradesContainer');
        const div = document.createElement('div');
        div.className = "trade-item bg-white p-4 border border-slate-200 shadow-sm space-y-3";
        div.draggable = true;

        div.innerHTML = `
        <div class="flex justify-between items-center border-b border-slate-100 pb-2">
            <div class="cursor-grab text-slate-400 hover:text-slate-600 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path>
                </svg>
            </div>

            <button onclick="this.closest('.trade-item').remove(); recalculateTotals(); debouncedAutoSave();" class="text-slate-400 hover:text-red-600 font-bold text-lg px-2 shrink-0 transition-colors" title="Remove Trade">
                &times;
            </button>
        </div>

        <div>
            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Trade</label>
            <input type="text" value="${data.name}" placeholder="e.g. Electrical / Plumbing" oninput="debouncedAutoSave()" class="trade-name-input w-full text-xs font-bold text-slate-800 bg-slate-50 border border-slate-300 px-2.5 py-1.5 focus:bg-white focus:ring-1 focus:ring-amber-500">
        </div>

        <div>
            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Description</label>
            <input type="text" value="${data.description}" placeholder="Describe the scope of work..." oninput="debouncedAutoSave()" class="trade-desc-input w-full text-xs text-slate-700 bg-slate-50 border border-slate-300 px-2.5 py-1.5 focus:bg-white focus:ring-1 focus:ring-amber-500">
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 bg-slate-50/80 p-3 border border-slate-100">
            <div>
                <span class="text-[10px] text-slate-400 font-bold block uppercase mb-1">Sub Cost ($)</span>
                <input type="number" value="${data.subCost}" oninput="recalculateTotals(); debouncedAutoSave();" class="sub-cost-input w-full text-xs text-right font-mono bg-white border border-slate-300 px-2 py-1.5">
            </div>

            <div>
                <span class="text-[10px] text-slate-400 font-bold block uppercase mb-1">Markup</span>
                <div class="flex">
                    <input type="number" value="${data.markupVal}" oninput="recalculateTotals(); debouncedAutoSave();" class="markup-val-input w-full text-xs text-right font-mono bg-white border border-r-0 border-slate-300 px-2 py-1.5">
                    <select onchange="recalculateTotals(); debouncedAutoSave();" class="markup-type-input bg-slate-200 text-slate-900 text-xs font-bold border border-slate-300 w-10 text-center focus:outline-none shrink-0 cursor-pointer">
                        <option value="percent" ${data.markupType === 'percent' ? 'selected' : ''}>%</option>
                        <option value="flat" ${data.markupType === 'flat' ? 'selected' : ''}>$</option>
                    </select>
                </div>
            </div>

            <div class="col-span-2 sm:col-span-1 flex flex-col justify-center text-right border-t sm:border-t-0 sm:border-l border-slate-200 pt-2 sm:pt-0 sm:pl-3">
                <span class="text-[10px] text-slate-400 font-bold uppercase">Client Price</span>
                <span class="line-total-val text-sm font-extrabold text-slate-900 font-mono">$0.00</span>
            </div>
        </div>
    `;

        container.appendChild(div);
        recalculateTotals();
        setupDragAndDrop();
    }

    function setupDragAndDrop() {
        const container = document.getElementById('tradesContainer');
        let draggedItem = null;

        container.querySelectorAll('.trade-item').forEach(item => {
            item.addEventListener('dragstart', () => { draggedItem = item; item.classList.add('opacity-50'); });
            item.addEventListener('dragend', () => { item.classList.remove('opacity-50'); draggedItem = null; debouncedAutoSave(); });
        });

        container.addEventListener('dragover', (e) => {
            e.preventDefault();
            const draggableElements = [...container.querySelectorAll('.trade-item:not(.opacity-50)')];
            const afterElement = draggableElements.reduce((closest, child) => {
                const box = child.getBoundingClientRect();
                const offset = e.clientY - box.top - box.height / 2;
                return (offset < 0 && offset > closest.offset) ? { offset: offset, element: child } : closest;
            }, { offset: Number.NEGATIVE_INFINITY }).element;

            if (afterElement == null) container.appendChild(draggedItem);
            else container.insertBefore(draggedItem, afterElement);
        });
    }

    function debouncedAutoSave() {
        clearTimeout(autoSaveTimer);
        autoSaveTimer = setTimeout(() => saveCurrentEstimate(false), 1000);
    }

    async function saveCurrentEstimate(showAlert = false) {
        const estimateId = document.getElementById('activeEstimateId').value;
        const trades = [];

        document.querySelectorAll('.trade-item').forEach(item => {
            trades.push({
                name: item.querySelector('.trade-name-input').value,
                description: item.querySelector('.trade-desc-input').value,
                subCost: parseFloat(item.querySelector('.sub-cost-input').value) || 0,
                markup: {
                    value: parseFloat(item.querySelector('.markup-val-input').value) || 0,
                    type: item.querySelector('.markup-type-input').value
                }
            });
        });

        const payload = {
            id: estimateId,
            projectName: document.getElementById('activeProjectName').value,
            trades,
            overhead: {
                type: document.getElementById('overheadType').value,
                value: parseFloat(document.getElementById('overheadVal').value) || 0
            },
            paymentSchedule: document.getElementById('paymentSchedule').value,
            additionalTerms: document.getElementById('additionalTerms').value,
            generalTerms: document.getElementById('generalTerms').value
        };

        const res = await fetch('/admin/estimates/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (data.success && showAlert) {
            showSaveToast();
        }
    }

    function showSaveToast() {
        const toast = document.getElementById('saveToast');
        if (!toast) return;

        toast.classList.remove('hidden');

        setTimeout(() => {
            toast.classList.add('hidden');
        }, 2500);
    }

    async function executePublish() {
        const estimateId = document.getElementById('activeEstimateId').value;
        const companyProfileId = document.getElementById('companyProfileSelect').value;

        await saveCurrentEstimate(false);

        const res = await fetch(`/admin/estimates/${estimateId}/publish`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ companyProfileId })
        });

        const data = await res.json();
        if (data.success) window.location.href = '/admin/estimates';
    }
</script>