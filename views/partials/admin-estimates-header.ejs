<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Admin Portal - Estimates</title>
        <link rel="icon" type="image/x-icon" href="<%= baseUrl %>/favicon.png">
        <!-- Tailwind CSS via CDN -->
        <script src="https://cdn.tailwindcss.com"></script>
        <style>
            /* Hide scrollbar for Chrome, Safari and Opera */
            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }

            /* Hide scrollbar for IE, Edge and Firefox */
            .no-scrollbar {
                -ms-overflow-style: none;
                /* IE and Edge */
                scrollbar-width: none;
                /* Firefox */
            }

            .duplicate-btn {
                background: #f59e0b;
                color: white;
                border: 1px solid #f59e0b;
            }

            .duplicate-btn:hover {
                background: #d97706;
                border-color: #d97706;
            }
        </style>
    </head>

    <body class="bg-[#F4F1EC] text-slate-900 antialiased flex flex-col min-h-screen">

        <!-- MAIN HEADER -->
        <!-- MAIN HEADER -->
        <header class="bg-slate-900 text-white shadow-md flex-shrink-0 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-3 sm:px-4 py-2.5 flex items-center justify-between gap-2">

                <!-- LEFT: Logo -->
                <a href="/admin"
                    class="flex items-center space-x-2 text-white hover:text-amber-400 transition-colors shrink-0">
                    <img src="<%= baseUrl %>/logo.png" alt="Logo" class="w-24 sm:w-32 h-8 sm:h-10 object-contain">
                </a>

                <!-- RIGHT: Main Navigation Links (Scrollable on small screens if needed) -->
                <div class="flex items-center space-x-1 sm:space-x-2 overflow-x-auto no-scrollbar shrink">

                    <!-- Dashboard / Projects -->
                    <a href="/admin"
                        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 sm:px-3 sm:py-2 text-xs sm:text-sm font-medium transition-all shrink-0 <%= currentPath === '/admin' ? 'bg-slate-800 text-amber-400 font-bold border-b-2 border-amber-400' : 'text-slate-300 hover:text-white hover:bg-slate-800' %>">
                        <svg class="w-4 h-4 sm:hidden shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6">
                            </path>
                        </svg>
                        <span>Dashboard</span>
                    </a>

                    <!-- Estimates -->
                    <a href="/admin/estimates"
                        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 sm:px-3 sm:py-2 text-xs sm:text-sm font-medium transition-all shrink-0 <%= currentPath.startsWith('/admin/estimates') ? 'bg-slate-800 text-slate-100 font-bold border-b-2 border-slate-300' : 'text-slate-300 hover:text-white hover:bg-slate-800' %>">
                        <svg class="w-4 h-4 sm:hidden shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                            </path>
                        </svg>
                        <span>Estimates</span>
                    </a>

                    <!-- Company Profiles -->
                    <a href="/admin/company-profiles"
                        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 sm:px-3 sm:py-2 text-xs sm:text-sm font-medium transition-all shrink-0 <%= currentPath.startsWith('/admin/company-profiles') ? 'bg-slate-800 text-slate-100 font-bold border-b-2 border-slate-300' : 'text-slate-300 hover:text-white hover:bg-slate-800' %>">
                        <svg class="w-4 h-4 sm:hidden shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
                            </path>
                        </svg>
                        <span class="hidden sm:inline">Company Profiles</span>
                    </a>

                    <!-- Logout -->
                    <a href="javascript:void(0)" onclick="logoutAdmin()" title="Sign out"
                        class="inline-flex items-center bg-slate-800 hover:bg-red-600/80 text-slate-300 hover:text-white p-2 text-xs sm:text-sm transition-all shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                            </path>
                        </svg>
                    </a>
                </div>

            </div>
        </header>

        <!-- Client-side helper script for search filter and Basic Auth logout -->
        <script>
            function filterHouses() {
                const query = document.getElementById('houseSearchInput').value.toLowerCase().trim();
                const houseCards = document.querySelectorAll('[data-house-card]');

                houseCards.forEach(houseCard => {
                    const houseName = (houseCard.getAttribute('data-house-name') || '').toLowerCase();
                    const houseMatches = houseName.includes(query);

                    const roomCards = houseCard.querySelectorAll('[data-room-card]');
                    let matchingRoomCount = 0;

                    roomCards.forEach(roomCard => {
                        const roomName = (roomCard.getAttribute('data-room-name') || '').toLowerCase();
                        const roomMatches = roomName.includes(query);

                        if (houseMatches || roomMatches) {
                            roomCard.style.display = '';
                            matchingRoomCount++;
                        } else {
                            roomCard.style.display = 'none';
                        }
                    });

                    if (houseMatches || matchingRoomCount > 0 || query === '') {
                        houseCard.style.display = '';
                    } else {
                        houseCard.style.display = 'none';
                    }
                });
            }

            async function logoutAdmin() {
                if (!confirm('Are you sure you want to log out of the Admin portal?')) {
                    return;
                }

                try {
                    const response = await fetch('/admin/logout', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    const data = await response.json();

                    if (response.ok && data.success) {
                        window.location.href = data.redirectUrl || '/admin/login';
                    } else {
                        alert(data.error || 'Logout failed. Please try again.');
                    }
                } catch (err) {
                    console.error('Logout request failed:', err);
                    alert('Network error while logging out.');
                }
            }
        </script>

        <main class="max-w-7xl mx-auto px-4 py-6 flex-grow w-full">