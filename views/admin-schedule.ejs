<%- include('partials/admin-edit-header') %>

<div class="flex-1 space-y-6 mb-6">
    <!-- Add Job Form -->
    <div class="bg-white border border-slate-300 p-4 mt-6 mr-2 ml-2">
        <form id="addJobForm" class="flex flex-col sm:flex-row flex-wrap gap-3">
            <input type="text" id="jobName" placeholder="Job name (e.g. Plumbing)" required
                class="px-3 py-2 border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 flex-1 min-w-[150px]">
            <input type="date" id="startDate" required
                class="px-3 py-2 border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 w-full sm:w-auto"
                value="<%= new Date().toISOString().split('T')[0] %>">
            <input type="date" id="endDate" required
                class="px-3 py-2 border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 w-full sm:w-auto"
                value="<%= new Date(Date.now() + 7*24*60*60*1000).toISOString().split('T')[0] %>">
            <input type="color" id="jobColor" value="#f59e0b" class="h-9 w-9 border border-slate-300 p-1 cursor-pointer" title="Color">
            <button type="submit"
                class="bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2 transition w-full sm:w-auto">
                + Add Job
            </button>
            <button type="button" onclick="window.open('/house/schedule/<%= house.id %>', '_blank')"
                class="bg-slate-300 hover:bg-slate-200 text-white text-sm font-semibold px-6 py-2 transition w-full sm:w-auto">
                View
            </button>
            <button type="button" onclick="openQRModal()"
                class="bg-slate-300 hover:bg-slate-200 text-white text-sm font-semibold px-6 py-2 transition w-full sm:w-auto">QR</button>
        </form>

        <!-- QR Modal -->
        <div id="qrModal"
            class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden">
            <div class="bg-white border border-slate-300 shadow-2xl max-w-sm w-full p-6 mx-4 text-center">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-base font-bold text-slate-900">Schedule <%= house.id.charAt(0).toUpperCase() + house.id.slice(1) %></h3>
                    <button onclick="closeQRModal()"
                        class="text-slate-400 hover:text-slate-600 text-xl leading-none">&times;</button>
                </div>
                <div class="flex justify-center mb-4">
                    <% if (qrDataUrl) { %>
                    <img src="<%= qrDataUrl %>" alt="QR Code" class="w-48 h-48 border border-slate-200">
                    <% } else { %>
                    <div class="w-48 h-48 bg-slate-100 flex items-center justify-center text-slate-400 text-sm">QR not available</div>
                    <% } %>
                </div>
                <div class="flex justify-center gap-3">
                    <% if (qrDataUrl) { %>
                    <a href="<%= qrDataUrl %>" download="schedule-<%= house.id %>.png"
                        class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 transition rounded">Download</a>
                    <% } %>
                    <button onclick="closeQRModal()"
                        class="bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-semibold px-4 py-2 transition rounded">Close</button>
                </div>
            </div>
        </div>
        <div id="addStatus" class="mt-2 text-xs hidden"></div>
    </div>

    <!-- Gantt Chart -->
    <div class="bg-white border border-slate-300 overflow-hidden mr-2 ml-2">
        <div
            class="p-4 border-b border-slate-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
            <h2 class="text-sm font-bold">Project Timeline</h2>
            <span id="jobCount" class="text-xs text-slate-500 bg-slate-100 px-3 py-1"></span>
        </div>
        <div id="ganttContainer" class="p-2 sm:p-4 overflow-x-auto">
            <div id="ganttChart" class="relative">
                <!-- Rendered by JavaScript -->
            </div>
        </div>
    </div>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteModal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden">
  <div class="bg-white border border-slate-300 shadow-2xl max-w-md w-full p-6 space-y-4 rounded-none mx-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div>
        <h3 id="deleteModalTitle" class="text-base font-bold text-slate-900">Confirm Deletion</h3>
        <p class="text-xs text-slate-500 mt-0.5">This action cannot be undone.</p>
      </div>
    </div>

    <p id="deleteModalBody" class="text-sm text-slate-600">
      Are you sure you want to delete this item?
    </p>

    <div class="flex justify-end gap-2 pt-2 border-t border-slate-200">
      <button type="button" onclick="closeDeleteModal()"
        class="bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-semibold px-4 py-2 transition">
        Cancel
      </button>
      <button type="button" id="confirmDeleteBtn" onclick="confirmDeleteJob()"
        class="bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-4 py-2 transition">
        Delete Permanently
      </button>
    </div>
  </div>
</div>

<script>
    const houseId = '<%= house.id %>';
    let jobs = <%- JSON.stringify(house.schedule?.jobs || []) %>;

    let globalMinDate = null;
    let globalDayWidth = 0;
    let draggedJobId = null;
    let dragStartX = 0;
    let dragStartOffsetDays = 0;
    let isDragging = false;

    function formatDate(dateStr) {
        if (!dateStr) return 'N/A';
        const d = new Date(dateStr + 'T00:00:00');
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    function getMonthName(dateStr) {
        const d = new Date(dateStr + 'T00:00:00');
        return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
    }

    function formatDateISO(date) {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    }

    function renderGantt() {
        const container = document.getElementById('ganttChart');
        const countEl = document.getElementById('jobCount');

        if (countEl) {
            countEl.textContent = `${jobs.length} job${jobs.length !== 1 ? 's' : ''}`;
        }

        if (!container) return;

        if (jobs.length === 0) {
            container.innerHTML = '<div class="text-center py-12 text-slate-500 text-sm">No jobs scheduled yet. Add a job above to see the timeline.</div>';
            return;
        }

        const today = new Date();
        const startDates = jobs.map(j => new Date(j.startDate + 'T00:00:00'));
        const endDates = jobs.map(j => new Date(j.endDate + 'T00:00:00'));

        const minDate = new Date(Math.min(...startDates));
        minDate.setDate(minDate.getDate() - 2);
        globalMinDate = new Date(minDate);

        const maxDate = new Date(Math.max(...endDates));
        maxDate.setDate(maxDate.getDate() + 2);

        const totalDays = Math.ceil((maxDate - minDate) / (1000 * 60 * 60 * 24));

        let dayWidth;
        if (window.innerWidth < 640) {
            dayWidth = Math.max(20, Math.min(35, 400 / totalDays));
        } else if (window.innerWidth < 1024) {
            dayWidth = Math.max(25, Math.min(45, 600 / totalDays));
        } else {
            dayWidth = Math.max(30, Math.min(60, 800 / totalDays));
        }
        globalDayWidth = dayWidth;

        const totalWidth = totalDays * dayWidth;

        let html = `<div class="flex">`;

        html += `<div class="flex-shrink-0" style="width: 150px;">`;
        html += `<div class="border-b border-slate-300 bg-white sticky top-0 z-20" style="height: 50px;">`;
        html += `<div class="p-2 font-bold text-xs text-slate-600">Job</div>`;
        html += `</div>`;

        jobs.forEach(job => {
            html += `<div class="border-b border-slate-100 hover:bg-slate-50 group" style="height: 44px;">`;
            html += `<div class="p-2 text-xs sm:text-sm font-medium text-slate-700 flex items-center gap-1">`;
            html += `<span class="truncate cursor-pointer hover:text-amber-600 transition" onclick="openEditModal('${job.id}')" title="Click to edit">${job.name}</span>`;
            html += `<button onclick="deleteJob('${job.id}')" class="text-red-500 hover:text-red-700 text-xs ml-auto flex-shrink-0 opacity-0 group-hover:opacity-100 transition" title="Delete job">✕</button>`;
            html += `</div>`;
            html += `</div>`;
        });

        html += `</div>`;

        html += `<div class="overflow-x-auto flex-1">`;
        html += `<div style="width: ${totalWidth}px;">`;

        html += `<div class="border-b border-slate-300 bg-white sticky top-0 z-10" style="height: 50px;">`;
        html += `<div class="relative w-full" style="height: 50px;">`;

        let currentMonth = '';
        let monthStartDay = 0;
        let monthIndex = 0;
        let lastMonthDateStr = '';

        for (let i = 0; i < totalDays; i++) {
            const date = new Date(minDate.getTime() + i * 24 * 60 * 60 * 1000);
            const dateStr = formatDateISO(date);
            const monthKey = dateStr.substring(0, 7);

            if (monthKey !== currentMonth) {
                if (currentMonth !== '') {
                    const monthWidth = (i - monthStartDay) * dayWidth;
                    const bgClass = (monthIndex % 2 === 0) ? 'bg-white' : 'bg-slate-100';
                    html += `<div class="absolute top-0 text-[9px] sm:text-[10px] font-bold text-slate-700 ${bgClass} px-1 sm:px-2 py-0.5 rounded" 
                    style="left: ${monthStartDay * dayWidth}px; width: ${monthWidth}px; text-align: center; border-bottom: 2px solid #e2e8f0;">`;
                    html += `${getMonthName(lastMonthDateStr)}`;
                    html += `</div>`;
                    monthIndex++;
                }
                currentMonth = monthKey;
                monthStartDay = i;
            }
            lastMonthDateStr = dateStr;
        }

        if (currentMonth !== '') {
            const monthWidth = (totalDays - monthStartDay) * dayWidth;
            const bgClass = (monthIndex % 2 === 0) ? 'bg-white' : 'bg-slate-100';
            html += `<div class="absolute top-0 text-[9px] sm:text-[10px] font-bold text-slate-700 ${bgClass} px-1 sm:px-2 py-0.5 rounded" 
                style="left: ${monthStartDay * dayWidth}px; width: ${monthWidth}px; text-align: center; border-bottom: 2px solid #e2e8f0;">`;
            html += `${getMonthName(lastMonthDateStr)}`;
            html += `</div>`;
        }

        html += `<div class="absolute bottom-0 flex w-full">`;
        for (let i = 0; i < totalDays; i++) {
            const date = new Date(minDate.getTime() + i * 24 * 60 * 60 * 1000);
            const isWeekend = date.getDay() === 0 || date.getDay() === 6;
            const isToday = date.toDateString() === today.toDateString();

            html += `<div class="text-[6px] sm:text-[8px] text-slate-400 border-r border-slate-200 ${isToday ? 'font-bold text-amber-600' : ''}" 
            style="width: ${dayWidth}px; text-align: center; ${isWeekend ? 'color: #94a3b8;' : ''}">`;
            html += `${date.getDate()}`;
            html += `</div>`;
        }
        html += `</div>`;

        html += `</div></div>`;

        jobs.forEach(job => {
            const start = new Date(job.startDate + 'T00:00:00');
            const end = new Date(job.endDate + 'T00:00:00');

            const startOffset = Math.max(0, (start - minDate) / (1000 * 60 * 60 * 24));
            const duration = Math.max(1, (end - start) / (1000 * 60 * 60 * 24) + 1);

            const bgColor = job.color || '#f59e0b';

            html += `<div class="border-b border-slate-300 hover:bg-slate-50" style="height: 44px; position: relative;">`;

            html += `<div class="absolute inset-0 flex pointer-events-none">`;
            let rowMonth = '';
            let rowStartDay = 0;
            let rowMonthIndex = 0;
            for (let i = 0; i < totalDays; i++) {
                const date = new Date(minDate.getTime() + i * 24 * 60 * 60 * 1000);
                const dateStr = formatDateISO(date);
                const monthKey = dateStr.substring(0, 7);

                if (monthKey !== rowMonth) {
                    if (rowMonth !== '') {
                        const monthWidth = (i - rowStartDay) * dayWidth;
                        const bgClass = (rowMonthIndex % 2 === 0) ? 'bg-white' : 'bg-slate-100/60';
                        html += `<div class="${bgClass} h-full" style="width: ${monthWidth}px;"></div>`;
                        rowMonthIndex++;
                    }
                    rowMonth = monthKey;
                    rowStartDay = i;
                }
            }
            if (rowMonth !== '') {
                const monthWidth = (totalDays - rowStartDay) * dayWidth;
                const bgClass = (rowMonthIndex % 2 === 0) ? 'bg-white' : 'bg-slate-100/60';
                html += `<div class="${bgClass} h-full" style="width: ${monthWidth}px;"></div>`;
            }
            html += `</div>`;

            html += `<div class="absolute inset-0 flex pointer-events-none">`;
            for (let i = 0; i < totalDays; i++) {
                html += `<div class="border-r border-slate-300 h-full" style="width: ${dayWidth}px;"></div>`;
            }
            html += `</div>`;

            html += `<div class="absolute top-1 rounded-sm cursor-grab active:cursor-grabbing hover:opacity-80 transition-opacity flex items-center select-none" 
                id="job-bar-${job.id}"
                style="left: ${startOffset * dayWidth}px; 
                       width: ${duration * dayWidth - 4}px; 
                       height: 32px; 
                       background: ${bgColor};
                       min-width: 12px;"
                onmousedown="startDrag(event, '${job.id}')"
                onclick="handleJobClick(event, '${job.id}')"
                title="${job.name}: ${formatDate(job.startDate)} → ${formatDate(job.endDate)}">`;

            if (duration * dayWidth > 60) {
                html += `<span class="text-white text-[8px] sm:text-[10px] font-semibold px-2 truncate pointer-events-none">${job.name}</span>`;
            } else {
                html += `<span class="text-white text-[10px] w-full text-center pointer-events-none">●</span>`;
            }

            html += `</div>`;
            html += `</div>`;
        });

        html += `</div>`;
        html += `</div>`;
        html += `</div>`;

        container.innerHTML = html;
    }

    function handleJobClick(e, jobId) {
        if (isDragging) return;
        openEditModal(jobId);
    }

    function startDrag(e, jobId) {
        if (e.button !== 0) return;
        draggedJobId = jobId;
        dragStartX = e.clientX;
        isDragging = false;

        const job = jobs.find(j => j.id === jobId);
        if (!job) return;

        const start = new Date(job.startDate + 'T00:00:00');
        dragStartOffsetDays = Math.round((start - globalMinDate) / (1000 * 60 * 60 * 24));

        window.addEventListener('mousemove', onDrag);
        window.addEventListener('mouseup', stopDrag);
    }

    function onDrag(e) {
        if (!draggedJobId) return;
        const deltaX = e.clientX - dragStartX;
        if (Math.abs(deltaX) > 3) {
            isDragging = true;
        }

        if (!isDragging) return;

        const daysShift = Math.round(deltaX / globalDayWidth);
        const newOffsetDays = dragStartOffsetDays + daysShift;

        const jobBar = document.getElementById(`job-bar-${draggedJobId}`);
        if (jobBar) {
            jobBar.style.left = `${newOffsetDays * globalDayWidth}px`;
        }
    }

    async function stopDrag(e) {
        window.removeEventListener('mousemove', onDrag);
        window.removeEventListener('mouseup', stopDrag);

        if (!draggedJobId) return;

        if (isDragging) {
            const deltaX = e.clientX - dragStartX;
            const daysShift = Math.round(deltaX / globalDayWidth);

            if (daysShift !== 0) {
                const job = jobs.find(j => j.id === draggedJobId);
                if (job) {
                    const start = new Date(job.startDate + 'T00:00:00');
                    const end = new Date(job.endDate + 'T00:00:00');

                    start.setDate(start.getDate() + daysShift);
                    end.setDate(end.getDate() + daysShift);

                    const newStartDate = formatDateISO(start);
                    const newEndDate = formatDateISO(end);

                    try {
                        const response = await fetch(`/admin/houses/schedule/${houseId}/jobs/${job.id}`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                name: job.name,
                                startDate: newStartDate,
                                endDate: newEndDate,
                                color: job.color
                            })
                        });

                        const data = await response.json();
                        if (data.success) {
                            Object.assign(job, data.job);
                        } else {
                            alert('Failed to update job dates: ' + (data.error || 'Unknown error'));
                        }
                    } catch (err) {
                        console.error('Error updating job dates:', err);
                        alert('Failed to update job dates');
                    }
                }
            }
            renderGantt();
        }

        setTimeout(() => {
            isDragging = false;
            draggedJobId = null;
        }, 50);
    }

    function openEditModal(jobId) {
        const job = jobs.find(j => j.id === jobId);
        if (!job) return;

        const modal = document.createElement('div');
        modal.id = 'editModal';
        modal.className = 'fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm';
        modal.innerHTML = `
      <div class="bg-white border border-slate-300 shadow-2xl max-w-md w-full p-6 mx-4">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-base font-bold text-slate-900">Edit Job</h3>
          <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600 text-xl leading-none">×</button>
        </div>
        <form id="editJobForm" class="space-y-4">
          <input type="hidden" id="editJobId" value="${job.id}">
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Job Name</label>
            <input type="text" id="editJobName" value="${job.name}" required
                   class="w-full px-3 py-2 border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Start Date</label>
            <input type="date" id="editStartDate" value="${job.startDate}" required
                   class="w-full px-3 py-2 border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">End Date</label>
            <input type="date" id="editEndDate" value="${job.endDate}" required
                   class="w-full px-3 py-2 border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Color</label>
            <input type="color" id="editJobColor" value="${job.color || '#f59e0b'}" required
                   class="h-9 w-full border border-slate-300 p-1 cursor-pointer">
          </div>
          <div class="flex justify-end gap-2 pt-2 border-t border-slate-200">
            <button type="button" onclick="closeEditModal()"
                    class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 transition">
              Cancel
            </button>
            <button type="submit"
                    class="px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 transition">
              Update Job
            </button>
          </div>
        </form>
      </div>
    `;

        document.body.appendChild(modal);
        document.body.style.overflow = 'hidden';

        document.getElementById('editJobForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = document.getElementById('editJobId').value;
            const name = document.getElementById('editJobName').value.trim();
            const startDate = document.getElementById('editStartDate').value;
            const endDate = document.getElementById('editEndDate').value;
            const color = document.getElementById('editJobColor').value;

            if (!name || !startDate || !endDate) return;

            try {
                const response = await fetch(`/admin/houses/schedule/${houseId}/jobs/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, startDate, endDate, color })
                });

                const data = await response.json();
                if (data.success) {
    const jobToUpdate = jobs.find(j => j.id === id);
    if (jobToUpdate) {
        jobToUpdate.name = name;
        jobToUpdate.startDate = startDate;
        jobToUpdate.endDate = endDate;
        jobToUpdate.color = color;      // explicitly set from form
    }
    closeEditModal();
    renderGantt();
} else {
                    alert('Failed to update job: ' + (data.error || 'Unknown error'));
                }
            } catch (err) {
                console.error('Error updating job:', err);
                alert('Failed to update job');
            }
        });
    }

    function closeEditModal() {
        const modal = document.getElementById('editModal');
        if (modal) {
            modal.remove();
            document.body.style.overflow = '';
        }
    }

    const addJobForm = document.getElementById('addJobForm');
    if (addJobForm) {
        addJobForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const statusEl = document.getElementById('addStatus');

            const name = document.getElementById('jobName').value.trim();
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            const color = document.getElementById('jobColor').value;

            if (!name || !startDate || !endDate) {
                if (statusEl) {
                    statusEl.textContent = 'All fields are required';
                    statusEl.className = 'mt-2 text-xs text-red-600';
                    statusEl.classList.remove('hidden');
                }
                return;
            }

            if (statusEl) {
                statusEl.className = 'mt-2 text-xs text-amber-600';
                statusEl.textContent = 'Adding job...';
                statusEl.classList.remove('hidden');
            }

            try {
                const response = await fetch(`/admin/houses/schedule/${houseId}/jobs`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, startDate, endDate, color })
                });

                const data = await response.json();
                if (data.success) {
                    jobs.push(data.job);
                    renderGantt();
                    addJobForm.reset();
                    const jobColorInput = document.getElementById('jobColor');
                    if (jobColorInput) jobColorInput.value = '#f59e0b';
                    if (statusEl) {
                        statusEl.textContent = '✓ Job added successfully!';
                        statusEl.className = 'mt-2 text-xs text-green-600';
                        setTimeout(() => statusEl.classList.add('hidden'), 3000);
                    }
                } else {
                    if (statusEl) {
                        statusEl.textContent = 'Failed: ' + (data.error || 'Unknown error');
                        statusEl.className = 'mt-2 text-xs text-red-600';
                    }
                }
            } catch (err) {
                console.error('Error adding job:', err);
                if (statusEl) {
                    statusEl.textContent = 'Error: ' + err.message;
                    statusEl.className = 'mt-2 text-xs text-red-600';
                }
            }
        });
    }

    let pendingDeleteJobId = null;

    function deleteJob(jobId) {
        const job = jobs.find(j => j.id === jobId);
        if (!job) return;

        pendingDeleteJobId = jobId;
        const deleteModalBody = document.getElementById('deleteModalBody');
        const deleteModal = document.getElementById('deleteModal');
        if (deleteModalBody) deleteModalBody.textContent = `Are you sure you want to delete "${job.name}"?`;
        if (deleteModal) deleteModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        pendingDeleteJobId = null;
        const deleteModal = document.getElementById('deleteModal');
        if (deleteModal) deleteModal.classList.add('hidden');
        document.body.style.overflow = '';
    }

    async function confirmDeleteJob() {
        if (!pendingDeleteJobId) return;

        const jobId = pendingDeleteJobId;
        const confirmBtn = document.getElementById('confirmDeleteBtn');

        try {
            if (confirmBtn) {
                confirmBtn.disabled = true;
                confirmBtn.textContent = 'Deleting...';
            }

            const response = await fetch(`/admin/houses/schedule/${houseId}/jobs/${jobId}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' }
            });

            const data = await response.json();
            if (data.success) {
                jobs = jobs.filter(j => j.id !== jobId);
                renderGantt();
                closeDeleteModal();
            } else {
                alert('Failed to delete job: ' + (data.error || 'Unknown error'));
            }
        } catch (err) {
            console.error('Error deleting job:', err);
            alert('Failed to delete job');
        } finally {
            if (confirmBtn) {
                confirmBtn.disabled = false;
                confirmBtn.textContent = 'Delete Permanently';
            }
        }
    }

    let resizeTimeout;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(renderGantt, 250);
    });

    renderGantt();

    function openQRModal() {
        const qrModal = document.getElementById('qrModal');
        if (qrModal) qrModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeQRModal() {
        const qrModal = document.getElementById('qrModal');
        if (qrModal) qrModal.classList.add('hidden');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeEditModal();
            closeQRModal();
            closeDeleteModal();
        }
    });
</script>

