<%- include('partials/admin-edit-header') %>

<div class="flex-1 space-y-6 mb-6">
    <!-- Add Job Form -->
    <div class="bg-white border border-slate-300 p-4 mt-6 mr-2 ml-2 shadow-sm rounded-sm">
        <form id="addJobForm" class="flex flex-col sm:flex-row flex-wrap gap-3">
            <input type="text" id="jobName" placeholder="Task name (e.g. Plumbing)" required
                class="px-3 py-2 border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 flex-1 min-w-[150px] rounded-sm">
            <input type="date" id="startDate" required
                class="px-3 py-2 border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 w-full sm:w-auto rounded-sm"
                value="<%= new Date().toISOString().split('T')[0] %>">
            <input type="date" id="endDate" required
                class="px-3 py-2 border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 w-full sm:w-auto rounded-sm"
                value="<%= new Date(Date.now() + 7*24*60*60*1000).toISOString().split('T')[0] %>">
            <input type="color" id="jobColor" value="#f59e0b" class="h-[38px] w-[38px] border border-slate-300 p-1 cursor-pointer rounded-sm" title="Color">
            
            <button type="submit"
                class="bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-6 py-2 transition w-full sm:w-auto rounded-sm shadow-sm">
                + Add Task
            </button>
            <button type="button" onclick="window.open('/house/schedule/<%= house.id %>', '_blank')"
                class="bg-white text-black border border-slate-300 hover:bg-slate-50 text-sm font-semibold px-6 py-2 transition w-full sm:w-auto rounded-sm shadow-sm">
                View
            </button>
            <button type="button" onclick="openQRModal()"
                class="bg-white text-black border border-slate-300 hover:bg-slate-50 text-sm font-semibold px-6 py-2 transition w-full sm:w-auto rounded-sm shadow-sm">QR</button>
            <button type="button" id="statusToggleBtn" onclick="togglePublishStatus()"
            class="text-xs sm:text-sm font-semibold px-4 py-2 transition rounded-sm shadow-sm flex items-center justify-center gap-2 border w-full sm:w-auto">
                <span id="statusText">Draft</span>
            </button>
        </form>

        <!-- QR Modal -->
        <div id="qrModal" class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden">
            <div class="bg-white border border-slate-300 shadow-2xl max-w-lg w-full p-6 mx-4 text-center rounded-sm">
                <div class="flex justify-center mb-4">
                    <% if (typeof qrDataUrl !== 'undefined' && qrDataUrl) { %>
                        <img src="<%= qrDataUrl %>" alt="QR Code" style="width: 100%; height: auto; max-width: 400px; display: block; margin: 0 auto; border: 1px solid #e2e8f0; border-radius: 4px;">
                    <% } else { %>
                        <div class="w-48 h-48 bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 text-sm rounded-sm">QR not available</div>
                    <% } %>
                </div>
                <div class="flex justify-center gap-3">
                    <% if (typeof qrDataUrl !== 'undefined' && qrDataUrl) { %>
                        <a href="<%= qrDataUrl %>" download="schedule-<%= house.id %>.png"
                            class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2 transition rounded-sm shadow-sm">Download</a>
                    <% } %>
                    <button onclick="closeQRModal()"
                        class="bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-semibold px-4 py-2 transition rounded-sm">Close</button>
                </div>
            </div>
        </div>
        <div id="addStatus" class="mt-2 text-xs font-medium hidden"></div>
    </div>

    <!-- Gantt Chart Area -->
    <div class="bg-white border border-slate-300 overflow-hidden mr-2 ml-2 shadow-sm rounded-sm">
        <div class="p-4 border-b border-slate-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 bg-slate-50">
            <div class="flex items-center gap-3">
                <h2 class="text-sm font-bold text-slate-800">Project Timeline</h2>
                <span id="jobCount" class="text-xs font-medium text-slate-600 bg-white border border-slate-200 px-3 py-1 rounded-full shadow-sm"></span>
            </div>
            
            <!-- Save / Discard Actions -->
            <div class="flex items-center gap-2">
                <button type="button" id="discardChangesBtn" onclick="discardScheduleChanges()" disabled
                    class="bg-slate-100 text-slate-400 border border-slate-200 text-xs font-semibold px-3 py-1.5 transition rounded-sm cursor-not-allowed">
                    Discard
                </button>
                <button type="button" id="saveChangesBtn" onclick="saveScheduleChanges()" disabled
                    class="bg-slate-300 text-slate-500 text-xs font-semibold px-4 py-1.5 transition rounded-sm shadow-sm cursor-not-allowed">
                    Save Changes
                </button>
            </div>
        </div>
        <div id="ganttContainer" class="w-full relative">
            <div id="ganttChart" class="relative overflow-auto custom-scrollbar" style="max-height: 65vh;">
                <!-- Rendered flawlessly by JavaScript -->
            </div>
        </div>
    </div>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteModal" class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden">
    <div class="bg-white border border-slate-300 shadow-2xl max-w-md w-full p-6 space-y-4 rounded-sm mx-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <div>
                <h3 class="text-base font-bold text-slate-900">Confirm Deletion</h3>
                <p class="text-xs text-slate-500 mt-0.5">This action cannot be undone.</p>
            </div>
        </div>
        <p id="deleteModalBody" class="text-sm text-slate-600 font-medium">Are you sure you want to delete this item?</p>
        <div class="flex justify-end gap-2 pt-4 border-t border-slate-200 mt-4">
            <button type="button" onclick="closeDeleteModal()" class="bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-semibold px-4 py-2 transition rounded-sm">Cancel</button>
            <button type="button" id="confirmDeleteBtn" onclick="confirmDeleteJob()" class="bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-4 py-2 transition rounded-sm shadow-sm">Delete Permanently</button>
        </div>
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 8px; height: 8px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
</style>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
    const houseId = '<%= house.id %>';
    let originalJobs = <%- JSON.stringify(house.schedule?.jobs || []) %>;
    let jobs = JSON.parse(JSON.stringify(originalJobs));

    // Change tracking flag
    let hasUnsavedChanges = false;

    // State Variables
    let globalMinDate = null;
    let globalDayWidth = 0;
    let draggedJobId = null;
    let dragStartX = 0;
    let dragStartOffsetDays = 0;
    let isDragging = false;

    function setUnsavedChanges(dirty) {
        hasUnsavedChanges = dirty;
        const saveBtn = document.getElementById('saveChangesBtn');
        const discardBtn = document.getElementById('discardChangesBtn');

        if (!saveBtn || !discardBtn) return;

        if (dirty) {
            saveBtn.disabled = false;
            saveBtn.className = 'bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold px-4 py-1.5 transition rounded-sm shadow-sm cursor-pointer';
            
            discardBtn.disabled = false;
            discardBtn.className = 'bg-white text-slate-700 border border-slate-300 hover:bg-slate-50 text-xs font-semibold px-3 py-1.5 transition rounded-sm shadow-sm cursor-pointer';
        } else {
            saveBtn.disabled = true;
            saveBtn.className = 'bg-slate-300 text-slate-500 text-xs font-semibold px-4 py-1.5 transition rounded-sm shadow-sm cursor-not-allowed';

            discardBtn.disabled = true;
            discardBtn.className = 'bg-slate-100 text-slate-400 border border-slate-200 text-xs font-semibold px-3 py-1.5 transition rounded-sm cursor-not-allowed';
        }
    }

    // --- ROCK SOLID DATE UTILITIES (DST SAFE) ---
    function getDaysDiff(d1, d2) {
        const utc1 = Date.UTC(d1.getFullYear(), d1.getMonth(), d1.getDate());
        const utc2 = Date.UTC(d2.getFullYear(), d2.getMonth(), d2.getDate());
        return Math.floor((utc2 - utc1) / (1000 * 60 * 60 * 24));
    }

    function addDays(date, days) {
        const result = new Date(date);
        result.setDate(result.getDate() + days);
        return result;
    }

    function formatDate(dateStr) {
        if (!dateStr) return 'N/A';
        const d = new Date(dateStr + 'T00:00:00');
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    function getMonthName(dateStr) {
        const d = new Date(dateStr + 'T00:00:00');
        return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
    }

    function formatDateISO(date) {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    }

    function escapeHtml(unsafe) {
        if (!unsafe) return '';
        return String(unsafe).replace(/[&<"'>]/g, function (match) {
            const escape = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
            return escape[match];
        });
    }

    function renderGantt() {
        const container = document.getElementById('ganttChart');
        const countEl = document.getElementById('jobCount');

        if (countEl) countEl.textContent = `${jobs.length} task${jobs.length !== 1 ? 's' : ''}`;
        if (!container) return;

        if (jobs.length === 0) {
            container.innerHTML = '<div class="text-center py-12 text-slate-500 text-sm font-medium">No tasks scheduled yet. Add a task above to see the timeline.</div>';
            return;
        }

        const today = new Date();
        today.setHours(0,0,0,0);

        const startDates = jobs.map(j => new Date(j.startDate + 'T00:00:00'));
        const endDates = jobs.map(j => new Date(j.endDate + 'T00:00:00'));

        const minDate = new Date(Math.min(...startDates));
        minDate.setDate(minDate.getDate() - 7);
        globalMinDate = new Date(minDate);

        const maxDate = new Date(Math.max(...endDates));
        maxDate.setDate(maxDate.getDate() + 4);

        const totalDays = getDaysDiff(minDate, maxDate);

        if (window.innerWidth < 640) globalDayWidth = 25;
        else if (window.innerWidth < 1024) globalDayWidth = 35;
        else globalDayWidth = Math.max(30, Math.min(60, 800 / totalDays));

        const totalWidth = totalDays * globalDayWidth;

        let html = `<div class="flex w-max min-w-full">`;

        // 1. FIXED LEFT COLUMN
        html += `<div class="flex-shrink-0 sticky left-0 z-40 bg-white border-r border-slate-300 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]" style="width: 160px;">`;
        html += `<div class="bg-slate-100 sticky top-0 z-50 border-b border-slate-300 flex items-center px-3" style="height: 54px;">`;
        html += `</div>`;

        // Task rows container for drag-and-drop
        html += `<div id="taskRowsContainer" class="flex flex-col">`;

        jobs.forEach((job, index) => {
            html += `<div class="border-b border-slate-200 hover:bg-slate-50 group flex items-center justify-between px-3 transition-colors cursor-grab" data-job-id="${job.id}" data-index="${index}" style="height: 48px;">`;
            html += `<span class="text-xs sm:text-sm font-semibold text-slate-700 truncate cursor-pointer hover:text-amber-600 transition-colors" onclick="openEditModal('${job.id}')" title="Edit ${escapeHtml(job.name)}">${escapeHtml(job.name)}</span>`;
            html += `<button onclick="deleteJob('${job.id}')" class="text-slate-400 hover:text-red-600 text-sm flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity" title="Delete">✕</button>`;
            html += `</div>`;
        });

        html += `</div>`; // End taskRowsContainer
        html += `</div>`; // End left column

        // 2. TIMELINE AREA
        html += `<div class="relative flex-shrink-0 bg-white" style="width: ${totalWidth}px;">`;

        // Timeline Headers
        html += `<div class="bg-white sticky top-0 z-30 border-b border-slate-300 shadow-sm" style="height: 54px;">`;
        html += `<div class="relative w-full h-full">`;

        // Render Months
        let currentMonth = '';
        let monthStartDay = 0;
        let monthIndex = 0;
        let lastMonthDateStr = '';

        for (let i = 0; i <= totalDays; i++) {
            let dateStr, monthKey;
            if (i < totalDays) {
                const date = addDays(minDate, i);
                dateStr = formatDateISO(date);
                monthKey = dateStr.substring(0, 7);
            } else {
                monthKey = 'END';
            }

            if (monthKey !== currentMonth) {
                if (currentMonth !== '') {
                    const monthWidth = (i - monthStartDay) * globalDayWidth;
                    const bgClass = (monthIndex % 2 === 0) ? 'bg-slate-100/80' : 'bg-slate-50/50';
                    html += `<div class="absolute top-0 text-[10px] font-bold text-slate-700 ${bgClass} px-2 py-1 border-r-2 border-slate-300 flex items-center justify-center overflow-hidden" 
                    style="left: ${monthStartDay * globalDayWidth}px; width: ${monthWidth}px; height: 26px;">`;
                    html += `${getMonthName(lastMonthDateStr)}`;
                    html += `</div>`;
                    monthIndex++;
                }
                currentMonth = monthKey;
                monthStartDay = i;
            }
            if (i < totalDays) lastMonthDateStr = dateStr;
        }

        // Render Days
        html += `<div class="absolute bottom-0 flex w-full h-[28px]">`;
        for (let i = 0; i < totalDays; i++) {
            const date = addDays(minDate, i);
            const isWeekend = date.getDay() === 0 || date.getDay() === 6;
            const isToday = date.toDateString() === today.toDateString();
            
            const nextDate = addDays(minDate, i + 1);
            const isMonthEnd = (i === totalDays - 1) || (nextDate.getMonth() !== date.getMonth());
            const borderClass = isMonthEnd ? 'border-r-2 border-slate-300' : 'border-r border-slate-200';
            const isEvenMonth = date.getMonth() % 2 === 0;

            let txtColor = isToday ? 'text-white bg-amber-500 font-bold' : (isWeekend ? 'text-slate-600 bg-slate-200/60' : (isEvenMonth ? 'text-slate-600 bg-slate-100/50' : 'text-slate-600 bg-white'));
            html += `<div class="text-[10px] ${borderClass} flex items-center justify-center ${txtColor}" 
            style="width: ${globalDayWidth}px; height: 100%;">`;
            html += `${date.getDate()}`;
            html += `</div>`;
        }
        html += `</div>`;
        html += `</div></div>`;

        // Render Task Rows
        jobs.forEach(job => {
            const start = new Date(job.startDate + 'T00:00:00');
            const end = new Date(job.endDate + 'T00:00:00');

            const startOffset = Math.max(0, getDaysDiff(minDate, start));
            const duration = Math.max(1, getDaysDiff(start, end) + 1);
            const bgColor = job.color || '#f59e0b';

            html += `<div class="border-b border-slate-300 hover:bg-slate-200/50 relative group" style="height: 48px;">`;

            // Background vertical guides
            html += `<div class="absolute inset-0 flex pointer-events-none">`;
            for (let i = 0; i < totalDays; i++) {
                const date = addDays(minDate, i);
                const isWeekend = date.getDay() === 0 || date.getDay() === 6;
                const nextDate = addDays(minDate, i + 1);
                
                const isEvenMonth = date.getMonth() % 2 === 0;
                const isMonthEnd = (i === totalDays - 1) || (nextDate.getMonth() !== date.getMonth());
                
                const colBg = isWeekend ? 'bg-slate-200/60' : (isEvenMonth ? 'bg-slate-100/50' : 'bg-transparent');
                const borderClass = isMonthEnd ? 'border-r-2 border-slate-300' : 'border-r border-slate-300/70';

                html += `<div class="${borderClass} h-full ${colBg}" style="width: ${globalDayWidth}px;"></div>`;
            }
            html += `</div>`;

            // The Draggable Bar
            html += `<div class="absolute top-[8px] rounded-sm shadow-sm cursor-grab active:cursor-grabbing hover:opacity-90 hover:shadow-md transition-shadow flex items-center select-none overflow-hidden" 
                id="job-bar-${job.id}"
                style="left: ${startOffset * globalDayWidth}px; width: ${duration * globalDayWidth}px; height: 32px; background: ${bgColor}; z-index: 10; min-width: ${globalDayWidth}px;"
                onmousedown="startDrag(event, '${job.id}')"
                onclick="handleJobClick(event, '${job.id}')"
                title="${escapeHtml(job.name)}: ${formatDate(job.startDate)} to ${formatDate(job.endDate)}">`;

            if (duration * globalDayWidth > 50) {
                html += `<span class="text-white text-[10px] font-bold px-2 truncate pointer-events-none drop-shadow-sm">${escapeHtml(job.name)}</span>`;
            }
            html += `</div>`;
            html += `</div>`;
        });

        html += `</div>`;
        html += `</div>`;
        container.innerHTML = html;

        // Initialize Sortable for task reordering
        const containerEl = document.getElementById('taskRowsContainer');
        if (containerEl) {
            Sortable.create(containerEl, {
                handle: '.cursor-grab',
                animation: 150,
                onEnd: function(evt) {
                    const fromIndex = evt.oldIndex;
                    const toIndex = evt.newIndex;
                    if (fromIndex === toIndex) return;
                    
                    // Reorder local jobs array without pushing to server immediately
                    const [movedJob] = jobs.splice(fromIndex, 1);
                    jobs.splice(toIndex, 0, movedJob);
                    
                    setUnsavedChanges(true);
                    renderGantt();
                }
            });
        }
    }

    // --- DRAG & DROP LOGIC ---
    function handleJobClick(e, jobId) {
        if (isDragging) return;
        openEditModal(jobId);
    }

    function startDrag(e, jobId) {
        if (e.button !== 0) return;
        e.preventDefault();
        
        draggedJobId = jobId;
        dragStartX = e.clientX;
        isDragging = false;

        const job = jobs.find(j => j.id === jobId);
        if (!job) return;

        const start = new Date(job.startDate + 'T00:00:00');
        dragStartOffsetDays = getDaysDiff(globalMinDate, start);

        window.addEventListener('mousemove', onDrag);
        window.addEventListener('mouseup', stopDrag);
    }

    function onDrag(e) {
        if (!draggedJobId) return;
        const deltaX = e.clientX - dragStartX;
        
        if (Math.abs(deltaX) > 4) isDragging = true;
        if (!isDragging) return;

        const daysShift = Math.round(deltaX / globalDayWidth);
        const newOffsetDays = dragStartOffsetDays + daysShift;

        const jobBar = document.getElementById(`job-bar-${draggedJobId}`);
        if (jobBar) jobBar.style.left = `${newOffsetDays * globalDayWidth}px`;
    }

    function stopDrag(e) {
        window.removeEventListener('mousemove', onDrag);
        window.removeEventListener('mouseup', stopDrag);

        if (!draggedJobId) return;

        if (isDragging) {
            const deltaX = e.clientX - dragStartX;
            const daysShift = Math.round(deltaX / globalDayWidth);

            if (daysShift !== 0) {
                const job = jobs.find(j => j.id === draggedJobId);
                if (job) {
                    const start = new Date(job.startDate + 'T00:00:00');
                    const end = new Date(job.endDate + 'T00:00:00');

                    const newStart = addDays(start, daysShift);
                    const newEnd = addDays(end, daysShift);

                    // Update dates locally
                    job.startDate = formatDateISO(newStart);
                    job.endDate = formatDateISO(newEnd);

                    setUnsavedChanges(true);
                }
            }
            renderGantt();
        }

        setTimeout(() => {
            isDragging = false;
            draggedJobId = null;
        }, 50);
    }

    // --- SAVE AND DISCARD LOGIC ---
    async function saveScheduleChanges() {
        const saveBtn = document.getElementById('saveChangesBtn');
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        try {
            // Save modified task dates sequentially
            for (const job of jobs) {
                await fetch(`/admin/houses/schedule/${houseId}/jobs/${job.id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: job.name,
                        startDate: job.startDate,
                        endDate: job.endDate,
                        color: job.color
                    })
                });
            }

            // Save final task order
            const order = jobs.map(j => j.id);
            await fetch(`/admin/houses/schedule/reorder/${houseId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ order })
            });

            originalJobs = JSON.parse(JSON.stringify(jobs));
            setUnsavedChanges(false);
        } catch (err) {
            alert('Failed to save changes. Please check network connection.');
        } finally {
            saveBtn.textContent = 'Save Changes';
        }
    }

    function discardScheduleChanges() {
        jobs = JSON.parse(JSON.stringify(originalJobs));
        setUnsavedChanges(false);
        renderGantt();
    }

    // --- MODAL CONTROLS ---
    function openEditModal(jobId) {
        const job = jobs.find(j => j.id === jobId);
        if (!job) return;

        const modal = document.createElement('div');
        modal.id = 'editModal';
        modal.className = 'fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/60 backdrop-blur-sm';
        modal.innerHTML = `
        <div class="bg-white border border-slate-300 shadow-2xl max-w-md w-full p-6 mx-4 rounded-sm">
            <div class="flex items-center justify-between mb-5">
                <h3 class="text-base font-bold text-slate-900">Edit Task</h3>
                <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600 text-2xl leading-none">&times;</button>
            </div>
            <form id="editJobForm" class="space-y-4">
                <input type="hidden" id="editJobId" value="${job.id}">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Task Name</label>
                    <input type="text" id="editJobName" value="${escapeHtml(job.name)}" required
                        class="w-full px-3 py-2 border border-slate-300 rounded-sm text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
                </div>
                <div class="flex gap-4">
                    <div class="flex-1">
                        <label class="block text-xs font-bold text-slate-700 mb-1">Start Date</label>
                        <input type="date" id="editStartDate" value="${job.startDate}" required
                            class="w-full px-3 py-2 border border-slate-300 rounded-sm text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
                    </div>
                    <div class="flex-1">
                        <label class="block text-xs font-bold text-slate-700 mb-1">End Date</label>
                        <input type="date" id="editEndDate" value="${job.endDate}" required
                            class="w-full px-3 py-2 border border-slate-300 rounded-sm text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
                    </div>
                </div>
                <div id="editTotalDays" class="text-xs font-semibold text-slate-600 bg-slate-100 px-3 py-1.5 rounded-sm inline-block">
                    Total: <span id="editDayCount">0</span> days
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Color Marker</label>
                    <input type="color" id="editJobColor" value="${job.color || '#f59e0b'}" required
                        class="h-10 w-full border border-slate-300 rounded-sm p-1 cursor-pointer">
                </div>
                <div class="flex justify-end gap-2 pt-4 border-t border-slate-200 mt-2">
                    <button type="button" onclick="closeEditModal()" class="px-4 py-2 text-sm font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 transition rounded-sm shadow-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 text-sm font-semibold text-white bg-amber-600 hover:bg-amber-700 transition rounded-sm shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>`;

        document.body.appendChild(modal);
        document.body.style.overflow = 'hidden';

        function updateDayCount() {
            const start = document.getElementById('editStartDate').value;
            const end = document.getElementById('editEndDate').value;
            if (start && end) {
                const startDate = new Date(start + 'T00:00:00');
                const endDate = new Date(end + 'T00:00:00');
                const days = Math.ceil((endDate - startDate) / (1000 * 60 * 60 * 24)) + 1;
                document.getElementById('editDayCount').textContent = days >= 0 ? days : 0;
            }
        }

        document.getElementById('editStartDate').addEventListener('change', updateDayCount);
        document.getElementById('editEndDate').addEventListener('change', updateDayCount);
        updateDayCount();

        document.getElementById('editJobForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = document.getElementById('editJobId').value;
            const name = document.getElementById('editJobName').value.trim();
            const startDate = document.getElementById('editStartDate').value;
            const endDate = document.getElementById('editEndDate').value;
            const color = document.getElementById('editJobColor').value;

            try {
                const response = await fetch(`/admin/houses/schedule/${houseId}/jobs/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, startDate, endDate, color })
                });

                const data = await response.json();
                if (data.success) {
                    const jobToUpdate = jobs.find(j => j.id === id);
                    if (jobToUpdate) {
                        jobToUpdate.name = name;
                        jobToUpdate.startDate = startDate;
                        jobToUpdate.endDate = endDate;
                        jobToUpdate.color = color;
                    }
                    const origJobToUpdate = originalJobs.find(j => j.id === id);
                    if (origJobToUpdate) {
                        origJobToUpdate.name = name;
                        origJobToUpdate.startDate = startDate;
                        origJobToUpdate.endDate = endDate;
                        origJobToUpdate.color = color;
                    }
                    closeEditModal();
                    renderGantt();
                } else {
                    alert('Failed to update job: ' + (data.error || 'Unknown error'));
                }
            } catch (err) {
                alert('Network error updating job');
            }
        });
    }

    function closeEditModal() {
        const modal = document.getElementById('editModal');
        if (modal) modal.remove();
        document.body.style.overflow = '';
    }

    // --- ADD / DELETE CONTROLS ---
    const addJobForm = document.getElementById('addJobForm');
    if (addJobForm) {
        addJobForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const statusEl = document.getElementById('addStatus');
            const name = document.getElementById('jobName').value.trim();
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            const color = document.getElementById('jobColor').value;

            statusEl.className = 'mt-2 text-xs text-amber-600 font-medium';
            statusEl.textContent = 'Adding schedule...';
            statusEl.classList.remove('hidden');

            try {
                const response = await fetch(`/admin/houses/schedule/${houseId}/jobs`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, startDate, endDate, color })
                });

                const data = await response.json();
                if (data.success) {
                    jobs.push(data.job);
                    originalJobs.push(JSON.parse(JSON.stringify(data.job)));
                    renderGantt();
                    addJobForm.reset();
                    document.getElementById('jobColor').value = '#f59e0b';
                    statusEl.textContent = '✓ Task added successfully!';
                    statusEl.className = 'mt-2 text-xs text-green-600 font-bold';
                    setTimeout(() => statusEl.classList.add('hidden'), 3000);
                } else {
                    statusEl.textContent = 'Failed: ' + (data.error || 'Unknown error');
                    statusEl.className = 'mt-2 text-xs text-red-600 font-bold';
                }
            } catch (err) {
                statusEl.textContent = 'Error connecting to server';
                statusEl.className = 'mt-2 text-xs text-red-600 font-bold';
            }
        });
    }

    let pendingDeleteJobId = null;

    function deleteJob(jobId) {
        const job = jobs.find(j => j.id === jobId);
        if (!job) return;
        pendingDeleteJobId = jobId;
        document.getElementById('deleteModalBody').innerHTML = `Are you sure you want to delete <strong>${escapeHtml(job.name)}</strong>?`;
        document.getElementById('deleteModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        pendingDeleteJobId = null;
        document.getElementById('deleteModal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    async function confirmDeleteJob() {
        if (!pendingDeleteJobId) return;
        const confirmBtn = document.getElementById('confirmDeleteBtn');
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Deleting...';

        try {
            const response = await fetch(`/admin/houses/schedule/${houseId}/jobs/${pendingDeleteJobId}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if (data.success) {
                jobs = jobs.filter(j => j.id !== pendingDeleteJobId);
                originalJobs = originalJobs.filter(j => j.id !== pendingDeleteJobId);
                renderGantt();
                closeDeleteModal();
            } else {
                alert('Failed to delete: ' + (data.error || 'Unknown error'));
            }
        } catch (err) {
            alert('Network error deleting job');
        } finally {
            confirmBtn.disabled = false;
            confirmBtn.textContent = 'Delete Permanently';
        }
    }

    // --- OTHER UI UTILS ---
    function openQRModal() {
        document.getElementById('qrModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeQRModal() {
        document.getElementById('qrModal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeEditModal();
            closeQRModal();
            closeDeleteModal();
        }
    });

    let resizeTimeout;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(renderGantt, 150);
    });

    // Boot Gantt Chart
    renderGantt();
</script>

<script>
    let currentStatus = '<%= house.schedule?.status || "draft" %>';

    function updateStatusUI() {
        const btn = document.getElementById('statusToggleBtn');
        const text = document.getElementById('statusText');
        if (!btn) return;

        if (currentStatus === 'published') {
            btn.className = 'bg-emerald-50 border-emerald-300 text-emerald-700 hover:bg-emerald-100 text-xs sm:text-sm font-semibold px-4 py-2 transition rounded-sm shadow-sm flex items-center justify-center gap-2 border w-full sm:w-auto';
            text.textContent = 'Published';
        } else {
            btn.className = 'bg-amber-50 border-amber-300 text-amber-700 hover:bg-amber-100 text-xs sm:text-sm font-semibold px-4 py-2 transition rounded-sm shadow-sm flex items-center justify-center gap-2 border w-full sm:w-auto';
            text.textContent = 'Draft';
        }
    }

    async function togglePublishStatus() {
        const nextStatus = currentStatus === 'published' ? 'draft' : 'published';

        try {
            const response = await fetch(`/admin/houses/schedule/status/${houseId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: nextStatus })
            });

            const data = await response.json();
            if (data.success) {
                currentStatus = nextStatus;
                updateStatusUI();
            } else {
                alert('Failed to update status: ' + (data.error || 'Unknown error'));
            }
        } catch (err) {
            alert('Network error updating status');
        }
    }

    updateStatusUI();
</script>
</main>
<footer class="bg-slate-900 border-t border-slate-600 flex-shrink-0 mt-auto">
    <div class="max-w-7xl mx-auto px-4 py-6 text-center text-xs text-white">
        &copy; 2026. Manu Romero Construction.
    </div>
</footer>
