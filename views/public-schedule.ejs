<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Manu Romero Construction</title>
        <link rel="icon" type="image/x-icon" href="<%= baseUrl %>/favicon.png">
        <script src="https://cdn.tailwindcss.com"></script>
        <!-- HTML Canvas, PDF & Excel Libraries -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/exceljs@4.3.0/dist/exceljs.min.js"></script>
        <style>
            /* Custom scrollbar for better aesthetics */
            .custom-scrollbar::-webkit-scrollbar {
                width: 8px;
                height: 8px;
            }
            .custom-scrollbar::-webkit-scrollbar-track {
                background: #f1f5f9;
                border-radius: 4px;
            }
            .custom-scrollbar::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 4px;
            }
            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

            @media print {
                @page { size: landscape; }
                body, html { background: white; height: auto; }
                header, footer, .no-print { display: none !important; }
                #ganttContainer { 
                    max-height: none !important; 
                    overflow: visible !important; 
                }
                #ganttChart { min-width: 100% !important; }
                * { 
                    -webkit-print-color-adjust: exact !important; 
                    print-color-adjust: exact !important; 
                }
            }
        </style>
    </head>

    <body class="font-sans text-black bg-[#f4f1ec] pb-16">
        <header class="bg-slate-900 text-white shadow-md flex-shrink-0 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
                <div class="flex items-center space-x-3 text-white hover:text-amber-400 transition-colors shrink-0">
                    <img src="<%= baseUrl %>/logo.png" alt="Logo" class="w-32 h-10 object-contain">
                </div>

                <div class="flex-1 max-w-md mx-auto">
                    <h2>Schedule - <%= house.id.charAt(0).toUpperCase() + house.id.slice(1) %></h2>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 py-6">
            
            <!-- Action Buttons -->
            <div class="flex flex-wrap gap-2 mb-4 justify-end no-print">
                <button onclick="toggleFullscreen()" class="px-4 py-2 bg-white border border-slate-600 text-slate-800 text-sm  hover:bg-slate-100 transition">
                    Fullscreen
                </button>
                <button onclick="exportGanttToExcel()" class="px-4 py-2 bg-white text-slate-800  border border-slate-600 text-sm  hover:bg-slate-100 transition">
                    Export As Excel
                </button>
                <button onclick="exportGanttToPDF()" class="px-4 py-2 bg-white text-slate-800  border border-slate-600 text-sm  hover:bg-slate-100 transition">
                    Download As PDF
                </button>
            </div>

            <!-- Gantt Chart -->
            <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden mb-6">
                <!-- Unified scroll container -->
                <div id="ganttContainer" class="custom-scrollbar overflow-auto max-h-[60vh] relative bg-white">
                    <div id="ganttChart" class="min-w-max relative">
                        <!-- Rendered by JavaScript -->
                    </div>
                </div>
            </div>

            <!-- Job Details Modal -->
            <div id="detailModal"
                class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden">
                <div class="bg-white border border-slate-200 shadow-xl max-w-md w-full p-6 mx-4 rounded-lg">
                    <div class="flex items-center justify-between mb-4">
                        <h3 id="detailJobName" class="text-lg font-bold text-slate-900">Job Details</h3>
                        <button onclick="closeDetailModal()"
                            class="text-slate-400 hover:text-slate-600 text-2xl leading-none">×</button>
                    </div>
                    <div class="space-y-3">
                        <div>
                            <p class="text-xs text-slate-500">Duration</p>
                            <p id="detailDuration" class="text-sm font-medium text-slate-700"></p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500">Start Date</p>
                            <p id="detailStart" class="text-sm font-medium text-slate-700"></p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500">End Date</p>
                            <p id="detailEnd" class="text-sm font-medium text-slate-700"></p>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500">Total Days</p>
                            <p id="detailDays" class="text-sm font-medium text-slate-700"></p>
                        </div>
                    </div>
                    <button onclick="closeDetailModal()"
                        class="mt-4 w-full px-4 py-2 text-sm font-medium text-white bg-slate-700 hover:bg-slate-800 transition rounded">
                        Close
                    </button>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="bg-slate-900 border-t border-slate-600 flex-shrink-0 fixed bottom-0 left-0 right-0 z-40">
            <div class="max-w-7xl mx-auto px-4 py-6 text-center text-xs text-white">
                &copy; 2026. Manu Romero Construction.
            </div>
        </footer>

        <script>
            const houseId = '<%= house.id %>';
            let jobs = <%- JSON.stringify(house.schedule?.jobs || []) %>;

            // Format date
            function formatDate(dateStr) {
                if (!dateStr) return 'N/A';
                const d = new Date(dateStr + 'T00:00:00');
                return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
            }

            // Format date short
            function formatDateShort(dateStr) {
                if (!dateStr) return 'N/A';
                const d = new Date(dateStr + 'T00:00:00');
                return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            }

            // Get month name safely without UTC offset shifts
            function getMonthName(dateObj) {
                if (!dateObj) return 'N/A';
                const d = typeof dateObj === 'string' ? new Date(dateObj + 'T00:00:00') : dateObj;
                return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            }

            // Render Gantt Chart
            function renderGantt() {
                const container = document.getElementById('ganttChart');

                if (jobs.length === 0) {
                    container.innerHTML = `
                      <div class="text-center py-16 w-full absolute left-0 right-0">
                        <div class="text-4xl mb-3">📋</div>
                        <p class="text-slate-500 text-sm">No jobs scheduled yet.</p>
                        <p class="text-slate-400 text-xs mt-1">Check back later for updates.</p>
                      </div>
                    `;
                    return;
                }

                const today = new Date();
                const startDates = jobs.map(j => new Date(j.startDate + 'T00:00:00'));
                const endDates = jobs.map(j => new Date(j.endDate + 'T00:00:00'));

                const minDate = new Date(Math.min(...startDates));
                minDate.setDate(minDate.getDate() - 2);

                const maxDate = new Date(Math.max(...endDates));
                maxDate.setDate(maxDate.getDate() + 2);

                const totalDays = Math.round((maxDate - minDate) / (1000 * 60 * 60 * 24)) + 1;

                // Responsive day width
                let dayWidth;
                if (window.innerWidth < 640) {
                    dayWidth = Math.max(20, Math.min(35, 400 / totalDays));
                } else if (window.innerWidth < 1024) {
                    dayWidth = Math.max(25, Math.min(45, 600 / totalDays));
                } else {
                    dayWidth = Math.max(30, Math.min(60, 800 / totalDays));
                }

                const totalWidth = totalDays * dayWidth;

                let html = `<div class="flex flex-col w-full">`;

                // ==========================================
                // HEADER ROW (Sticky Top)
                // ==========================================
                html += `<div class="flex sticky top-0 z-30 bg-white border-b border-slate-200 shadow-sm" style="height: 50px; min-width: max-content;">`;
                
                // Top-Left Corner (Sticky Left + Top)
                html += `<div class="sticky left-0 z-40 bg-white flex-shrink-0 border-r border-slate-200" style="width: 150px; height: 50px;"></div>`;
                
                // Timeline Header (Months & Days)
                html += `<div class="relative flex-1" style="width: ${totalWidth}px; height: 50px;">`;
                
                let currentMonth = '';
                let monthStartDay = 0;
                let monthStartDate = new Date(minDate);

                for (let i = 0; i < totalDays; i++) {
                    const date = new Date(minDate);
                    date.setDate(date.getDate() + i);
                    const monthKey = date.getFullYear() + '-' + date.getMonth();

                    if (monthKey !== currentMonth) {
                        if (currentMonth !== '') {
                            const monthWidth = (i - monthStartDay) * dayWidth;
                            html += `<div class="absolute top-0 text-[9px] sm:text-[10px] font-bold text-slate-700 bg-slate-50 px-1 sm:px-2 py-0.5 rounded-sm border-r border-slate-400" 
                              style="left: ${monthStartDay * dayWidth}px; width: ${monthWidth}px; text-align: center; border-bottom: 1px solid #e2e8f0;">`;
                            html += `${getMonthName(monthStartDate)}`;
                            html += `</div>`;
                        }
                        currentMonth = monthKey;
                        monthStartDay = i;
                        monthStartDate = new Date(date);
                    }
                }
                
                // Last month block
                if (currentMonth !== '') {
                    const monthWidth = (totalDays - monthStartDay) * dayWidth;
                    html += `<div class="absolute top-0 text-[9px] sm:text-[10px] font-bold text-slate-700 bg-slate-50 px-1 sm:px-2 py-0.5 rounded-sm" 
                      style="left: ${monthStartDay * dayWidth}px; width: ${monthWidth}px; text-align: center; border-bottom: 1px solid #e2e8f0;">`;
                    html += `${getMonthName(monthStartDate)}`;
                    html += `</div>`;
                }

                // Day markers
                html += `<div class="absolute bottom-0 flex w-full">`;
                for (let i = 0; i < totalDays; i++) {
                    const date = new Date(minDate);
                    date.setDate(date.getDate() + i);
                    const isWeekend = date.getDay() === 0 || date.getDay() === 6;
                    const isToday = date.toDateString() === today.toDateString();

                    const headerBg = isWeekend ? 'bg-slate-200/60 text-slate-600 font-semibold' : '';
html += `<div class="text-[6px] sm:text-[8px] text-slate-400 border-r border-slate-100 ${headerBg} ${isToday ? 'font-bold text-amber-600' : ''}" 
  style="width: ${dayWidth}px; text-align: center;">`;
                    html += `${date.getDate()}`;
                    html += `</div>`;
                }
                html += `</div>`;

                html += `</div></div>`; // End Header Row

                // ==========================================
                // JOB ROWS
                // ==========================================
                jobs.forEach(job => {
                    // Increased horizontal border visibility for rows
                    html += `<div class="flex border-b border-slate-200 group" style="min-width: max-content;">`;
                    
                    // Job Name Column (Sticky Left)
                    html += `<div class="sticky left-0 z-20 bg-white group-hover:bg-slate-50 flex-shrink-0 border-r border-slate-200 transition-colors flex items-center" style="width: 150px; height: 28px;">`;
                    html += `<div class="p-2 text-xs sm:text-sm font-medium text-slate-700 w-full truncate" title="${job.name}">${job.name}</div>`;
                    html += `</div>`;
                    
                    // Job Timeline Area
                    const start = new Date(job.startDate + 'T00:00:00');
                    const end = new Date(job.endDate + 'T00:00:00');

                    const startOffset = Math.max(0, (start - minDate) / (1000 * 60 * 60 * 24));
                    const duration = Math.max(1, (end - start) / (1000 * 60 * 60 * 24) + 1);

                    // Solid colors generator
                    const bgColor = job.color || '#f59e0b';

                    html += `<div class="relative flex-1 bg-white group-hover:bg-slate-50 transition-colors overflow-hidden" style="width: ${totalWidth}px; height: 28px;">`;

                    // --- BACKGROUND GRID & MONTH DIVIDERS ---
                    html += `<div class="absolute inset-0 flex pointer-events-none">`;
                    let monthIndex = 0;
                    let currentMonthKey = '';
                    for (let i = 0; i < totalDays; i++) {
                        const date = new Date(minDate);
                        date.setDate(date.getDate() + i);
                        const nextDate = new Date(minDate);
                        nextDate.setDate(nextDate.getDate() + i + 1);

                        const monthKey = date.getFullYear() + '-' + date.getMonth();
                        if (monthKey !== currentMonthKey) {
                            currentMonthKey = monthKey;
                            monthIndex++;
                        }
                        
                        const isMonthEnd = (i === totalDays - 1) || (nextDate.getMonth() !== date.getMonth());
                        
                        const isWeekend = date.getDay() === 0 || date.getDay() === 6;
const bgClass = isWeekend ? 'bg-slate-200/60' : ((monthIndex % 2 === 0) ? 'bg-white' : 'bg-slate-100/50');
                        const borderClass = isMonthEnd ? 'border-r-2 border-slate-400' : 'border-r border-slate-300';

                        html += `<div class="${bgClass} ${borderClass} h-full flex-shrink-0" style="width: ${dayWidth}px;"></div>`;
                    }
                    html += `</div>`;

                    // Job bar
                    html += `<div class="absolute top-1 rounded-sm cursor-pointer hover:opacity-80 transition shadow-sm z-10" 
                    style="left: ${startOffset * dayWidth}px; 
                        width: ${duration * dayWidth - 4}px; 
                        height: 32px; 
                        background: ${bgColor}; 
                        border: 2px solid ${bgColor};
                        min-width: 12px;"
                    onclick="showJobDetails('${job.id}')"
                    title="Click for details: ${job.name}">`;

                    if (duration * dayWidth > 60) {
                        html += `<span class="text-white text-[8px] sm:text-[10px] font-semibold px-2 leading-[28px] block truncate">${job.name}</span>`;
                    } else {
                        html += `<span class="text-white text-[10px] leading-[28px] block text-center">●</span>`;
                    }

                    html += `</div>`;
                    html += `</div></div>`; // End Job Row
                });

                html += `</div>`;
                container.innerHTML = html;
            }

            // Show job details in modal
            function showJobDetails(jobId) {
                const job = jobs.find(j => j.id === jobId);
                if (!job) return;

                const start = new Date(job.startDate + 'T00:00:00');
                const end = new Date(job.endDate + 'T00:00:00');
                const days = Math.ceil((end - start) / (1000 * 60 * 60 * 24)) + 1;

                document.getElementById('detailJobName').textContent = job.name;
                document.getElementById('detailDuration').textContent = `${formatDate(job.startDate)} → ${formatDate(job.endDate)}`;
                document.getElementById('detailStart').textContent = formatDate(job.startDate);
                document.getElementById('detailEnd').textContent = formatDate(job.endDate);
                document.getElementById('detailDays').textContent = `${days} day${days !== 1 ? 's' : ''}`;

                document.getElementById('detailModal').classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }

            function closeDetailModal() {
                document.getElementById('detailModal').classList.add('hidden');
                document.body.style.overflow = '';
            }

            // Close modal on Escape key
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeDetailModal();
            });

            // Close modal on click outside
            document.getElementById('detailModal').addEventListener('click', (e) => {
                if (e.target === e.currentTarget) closeDetailModal();
            });

            // Handle resize
            let resizeTimeout;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(renderGantt, 250);
            });

            // Initial render
            renderGantt();

            // Toggle Fullscreen View
            function toggleFullscreen() {
                const container = document.getElementById('ganttContainer');
                if (!document.fullscreenElement) {
                    if (container.requestFullscreen) {
                        container.requestFullscreen();
                    } else if (container.webkitRequestFullscreen) { /* Safari */
                        container.webkitRequestFullscreen();
                    }
                    container.classList.remove('max-h-[60vh]');
                    container.classList.add('h-screen', 'p-4');
                } else {
                    if (document.exitFullscreen) {
                        document.exitFullscreen();
                    }
                }
            }

            // Listen for fullscreen exit to restore height
            document.addEventListener('fullscreenchange', () => {
                const container = document.getElementById('ganttContainer');
                if (!document.fullscreenElement) {
                    container.classList.add('max-h-[60vh]');
                    container.classList.remove('h-screen', 'p-4');
                }
            });

            // 1. Export Full Gantt Chart with Merged Month Header, Day Row, and Job Names Inside Bars
            async function exportGanttToExcel() {
                if (jobs.length === 0) return alert('No jobs to export.');

                const workbook = new ExcelJS.Workbook();
                const worksheet = workbook.addWorksheet('Gantt Schedule');

                const startDates = jobs.map(j => new Date(j.startDate + 'T00:00:00'));
                const endDates = jobs.map(j => new Date(j.endDate + 'T00:00:00'));

                const minDate = new Date(Math.min(...startDates));
                minDate.setDate(minDate.getDate() - 2);

                const maxDate = new Date(Math.max(...endDates));
                maxDate.setDate(maxDate.getDate() + 2);

                const totalDays = Math.round((maxDate - minDate) / (1000 * 60 * 60 * 24)) + 1;

                // --- BUILD ROW 1 (MONTHS) & ROW 2 (DAYS) ---
                const row1Values = ['Job Name', 'Start Date', 'End Date', 'Days'];
                const row2Values = ['', '', '', ''];

                const monthRanges = []; 
                let currentMonthKey = '';
                let currentMonthStartCol = 5;

                for (let i = 0; i < totalDays; i++) {
                    const d = new Date(minDate);
                    d.setDate(d.getDate() + i);

                    const colIdx = 5 + i;
                    const monthKey = `${d.getFullYear()}-${d.getMonth()}`;
                    const monthLabel = d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

                    row2Values.push(d.getDate());

                    if (monthKey !== currentMonthKey) {
                        if (currentMonthKey !== '') {
                            monthRanges.push({
                                startCol: currentMonthStartCol,
                                endCol: colIdx - 1,
                                label: row1Values[currentMonthStartCol - 1]
                            });
                        }
                        currentMonthKey = monthKey;
                        currentMonthStartCol = colIdx;
                        row1Values.push(monthLabel);
                    } else {
                        row1Values.push('');
                    }
                }

                if (currentMonthKey !== '') {
                    monthRanges.push({
                        startCol: currentMonthStartCol,
                        endCol: 4 + totalDays,
                        label: row1Values[currentMonthStartCol - 1]
                    });
                }

                // Add Header Rows
                const row1 = worksheet.addRow(row1Values);
                const row2 = worksheet.addRow(row2Values);

                // Merge Info Columns across Rows 1 & 2
                for (let col = 1; col <= 4; col++) {
                    worksheet.mergeCells(1, col, 2, col);
                    const cell = worksheet.getCell(1, col);
                    cell.alignment = { vertical: 'middle', horizontal: 'center' };
                    cell.font = { bold: true, color: { argb: 'FFFFFF' } };
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: '0F172A' } };
                }

                // Merge Month Cells & Format Row 1
                monthRanges.forEach(m => {
                    if (m.startCol < m.endCol) {
                        worksheet.mergeCells(1, m.startCol, 1, m.endCol);
                    }
                    const cell = worksheet.getCell(1, m.startCol);
                    cell.value = m.label;
                    cell.alignment = { vertical: 'middle', horizontal: 'center' };
                    cell.font = { bold: true, color: { argb: 'FFFFFF' } };
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: '1E293B' } };
                });

                // Format Row 2 (Days)
                for (let col = 5; col <= 4 + totalDays; col++) {
                    const cell = row2.getCell(col);
                    cell.alignment = { vertical: 'middle', horizontal: 'center' };
                    cell.font = { size: 9, bold: true, color: { argb: '475569' } };
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'F8FAFC' } };
                }

                // Set Column Widths
                worksheet.getColumn(1).width = 25;
                worksheet.getColumn(2).width = 12;
                worksheet.getColumn(3).width = 12;
                worksheet.getColumn(4).width = 8;
                for (let col = 5; col <= 4 + totalDays; col++) {
                    worksheet.getColumn(col).width = 3.5;
                }

                // --- POPULATE JOB ROWS ---
                jobs.forEach(job => {
                    const start = new Date(job.startDate + 'T00:00:00');
                    const end = new Date(job.endDate + 'T00:00:00');
                    const days = Math.ceil((end - start) / (1000 * 60 * 60 * 24)) + 1;

                    const rowData = [job.name, job.startDate, job.endDate, days];
                    const addedRow = worksheet.addRow(rowData);
                    const currentRowNum = addedRow.number;

                    const startCol = Math.max(0, Math.round((start - minDate) / (1000 * 60 * 60 * 24))) + 5;
                    const endCol = startCol + days - 1;

                    // Convert Hex Color to ARGB
                    let hexColor = (job.color || '#F59E0B').replace('#', '');
                    if (hexColor.length === 3) {
                        hexColor = hexColor.split('').map(c => c + c).join('');
                    }
                    const argbColor = 'FF' + hexColor.toUpperCase();

                    // Shading Weekends
                    for (let i = 0; i < totalDays; i++) {
                        const col = 5 + i;
                        const d = new Date(minDate);
                        d.setDate(d.getDate() + i);

                        const isWeekend = d.getDay() === 0 || d.getDay() === 6;
                        if (isWeekend && (col < startCol || col > endCol)) {
                            addedRow.getCell(col).fill = {
                                type: 'pattern',
                                pattern: 'solid',
                                fgColor: { argb: 'E2E8F0' }
                            };
                        }
                    }

                    // --- MERGE BAR CELLS & INSERT JOB NAME INSIDE THE PIPE ---
                    if (startCol <= endCol) {
                        if (startCol < endCol) {
                            worksheet.mergeCells(currentRowNum, startCol, currentRowNum, endCol);
                        }
                        const barCell = worksheet.getCell(currentRowNum, startCol);
                        barCell.value = job.name;
                        barCell.alignment = { vertical: 'middle', horizontal: 'center' };
                        barCell.font = { size: 9, bold: true, color: { argb: 'FFFFFF' } };

                        // Apply fill across the merged pipe
                        for (let c = startCol; c <= endCol; c++) {
                            addedRow.getCell(c).fill = {
                                type: 'pattern',
                                pattern: 'solid',
                                fgColor: { argb: argbColor }
                            };
                        }
                    }
                });

                // --- ADD VERTICAL BORDERS BETWEEN MONTHS ---
                const totalRows = worksheet.rowCount;
                for (let r = 1; r <= totalRows; r++) {
                    const row = worksheet.getRow(r);
                    monthRanges.forEach(m => {
                        const cell = row.getCell(m.endCol);
                        cell.border = {
                            ...cell.border,
                            right: { style: 'medium', color: { argb: '94A3B8' } }
                        };
                    });
                }

                // Generate and Trigger File Download
                const buffer = await workbook.xlsx.writeBuffer();
                const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = `Schedule_Gantt_${houseId}.xlsx`;
                link.click();
            }

            // 2. Export Entire Full-Size Gantt Diagram (No scrolling cutoff) to PDF
            async function exportGanttToPDF() {
                if (jobs.length === 0) return alert('No jobs to export.');

                const element = document.getElementById('ganttChart');
                const container = document.getElementById('ganttContainer');

                // Store original styles
                const originalMaxHeight = container.style.maxHeight;
                const originalOverflow = container.style.overflow;

                // Temporarily remove scroll limits so full width/height renders
                container.style.maxHeight = 'none';
                container.style.overflow = 'visible';

                try {
                    const canvas = await html2canvas(element, {
                        scale: 2, // High resolution capture
                        useCORS: true,
                        logging: false
                    });

                    const imgData = canvas.toDataURL('image/png');
                    const { jsPDF } = window.jspdf;

                    // Auto-scale PDF canvas size to fit full chart dimensions
                    const pdf = new jsPDF({
                        orientation: canvas.width > canvas.height ? 'landscape' : 'portrait',
                        unit: 'px',
                        format: [canvas.width, canvas.height]
                    });

                    pdf.addImage(imgData, 'PNG', 0, 0, canvas.width, canvas.height);
                    pdf.save(`Schedule_Full_${houseId}.pdf`);
                } catch (err) {
                    console.error(err);
                    alert('Failed to generate PDF export.');
                } finally {
                    // Restore container scrolling
                    container.style.maxHeight = originalMaxHeight;
                    container.style.overflow = originalOverflow;
                }
            }
        </script>
    </body>
</html>