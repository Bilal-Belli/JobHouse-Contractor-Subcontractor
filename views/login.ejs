<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Admin Login - JobSite Specs</title>
        <link rel="icon" type="image/x-icon" href="<%= baseUrl %>/favicon.ico">
        <!-- Tailwind CSS via CDN -->
        <script src="https://cdn.tailwindcss.com"></script>
    </head>

    <body
        class="bg-[#F4F1EC] text-slate-900 antialiased font-serif flex flex-col justify-center items-center min-h-screen p-4">

        <div class="w-full max-w-md bg-white shadow-xl overflow-hidden font-sans">

            <!-- Top Header Banner -->
            <div class="bg-slate-900 text-white p-6 border-b-4 border-amber-500 text-center">
                <div class="inline-flex items-center space-x-2 mb-2">
                    <img src="<%= baseUrl %>/logo.png" alt="Logo" class="w-64 h-32 object-contain">
                </div>
                <h1 class="text-xs uppercase tracking-widest text-slate-400 font-semibold">Admin Authentication</h1>
            </div>

            <!-- Login Form -->
            <form action="/admin/login" method="POST" class="p-6 space-y-5">

                <!-- Error Alert Message -->
                <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-50 border-l-4 border-red-500 p-3 text-red-700 text-xs flex items-center gap-2">
                    <svg class="w-4 h-4 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span><%= error %></span>
                </div>
                <% } %>

                <!-- Username Field -->
                <div>
                    <label for="username" class="block text-xs font-bold uppercase text-slate-700 mb-1">Username</label>
                    <input type="text" id="username" name="username" required autofocus
                        placeholder="Enter admin username"
                        class="w-full px-3 py-2 border border-slate-300 rounded-none text-sm text-slate-900 bg-slate-50 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition">
                </div>

                <!-- Password Field -->
                <div>
                    <label for="password" class="block text-xs font-bold uppercase text-slate-700 mb-1">Password</label>
                    <input type="password" id="password" name="password" required placeholder="••••••••"
                        class="w-full px-3 py-2 border border-slate-300 rounded-none text-sm text-slate-900 bg-slate-50 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition">
                </div>

                <!-- Submit Button -->
                <button type="submit"
                    class="w-full bg-slate-900 hover:bg-amber-500 hover:text-slate-950 text-white font-bold py-2.5 px-4 text-sm uppercase tracking-wider rounded-none shadow transition duration-150 flex justify-center items-center gap-2">
                    Sign In
                </button>
            </form>
        </div>
    </body>

</html>