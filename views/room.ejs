<%- include('partials/header') %>

<div class="space-y-6 max-w-4xl mx-auto">
  <!-- Room Title and QR Bar -->
  <div class="bg-white p-5 rounded-lg border border-slate-200 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
      <span class="inline-block px-2 py-0.5 text-xs font-bold rounded uppercase bg-emerald-100 text-emerald-800 mb-1">Active Site Specs</span>
      <h1 class="text-2xl font-black text-slate-900 tracking-tight"><%= room.name %></h1>
    </div>

    <!-- QR Code & Share Trigger -->
    <div class="flex items-center gap-3 bg-slate-50 p-2 rounded-lg border border-slate-200">
      <img src="<%= qrCodeUrl %>" alt="QR Code" class="w-16 h-16 rounded border border-slate-200 bg-white">
      <div class="space-y-1">
        <a href="<%= qrCodeUrl %>" download="QR-<%= room.id %>.png" class="block text-center bg-slate-800 hover:bg-slate-700 text-white text-xs px-3 py-1 rounded transition">
          Download QR
        </a>
        <button onclick="toggleShareModal()" class="w-full text-center bg-amber-600 hover:bg-amber-700 text-white text-xs px-3 py-1 rounded transition">
          Share Room
        </button>
      </div>
    </div>
  </div>

  <!-- Responsive Trade Tabs Navigation -->
  <div class="border-b border-slate-200 overflow-x-auto">
    <nav class="flex space-x-2 pb-px">
      <% room.trades.forEach(trade => { %>
        <a href="/room/<%= room.id %>?trade=<%= trade.id %>" 
          class="whitespace-nowrap px-4 py-2.5 text-sm font-bold rounded-t-lg transition border-b-2 
          <%= activeTrade === trade.id ? 'bg-white text-amber-600 border-amber-600 shadow-sm' : 'bg-slate-100 text-slate-600 border-transparent hover:bg-slate-200' %>">
          <%= trade.name %>
        </a>
      <% }) %>
    </nav>
  </div>

  <!-- Selected Trade Content -->
  <% const currentTrade = room.trades.find(t => t.id === activeTrade) || room.trades[0]; %>
  
  <% if (currentTrade) { %>
    <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
      <!-- Media Displays -->
      <div class="grid grid-cols-1 md:grid-cols-2 border-b border-slate-200">
        <!-- Render View -->
        <div class="p-4 bg-slate-900 flex flex-col justify-center items-center min-h-[250px]">
          <span class="text-slate-400 text-xs font-semibold uppercase tracking-wider mb-2">3D Visual / Render</span>
          <% if (currentTrade.renderUrl) { %>
            <img src="<%= currentTrade.renderUrl %>" class="max-h-72 object-contain rounded">
          <% } else { %>
            <p class="text-slate-500 text-xs">No visual attached for this trade</p>
          <% } %>
        </div>

        <!-- Drawing/Plan View -->
        <div class="p-4 bg-slate-100 flex flex-col justify-center items-center min-h-[250px] border-t md:border-t-0 md:border-l border-slate-200">
          <span class="text-slate-500 text-xs font-semibold uppercase tracking-wider mb-2">Technical Drawing</span>
          <% if (currentTrade.planUrl) { %>
            <% if (currentTrade.planUrl.endsWith('.pdf')) { %>
              <a href="<%= currentTrade.planUrl %>" target="_blank" class="bg-slate-800 text-white text-xs font-semibold px-4 py-2 rounded shadow hover:bg-slate-700">
                Open Blueprint PDF
              </a>
            <% } else { %>
              <img src="<%= currentTrade.planUrl %>" class="max-h-72 object-contain rounded border border-slate-300">
            <% } %>
          <% } else { %>
            <p class="text-slate-400 text-xs">No technical drawing attached</p>
          <% } %>
        </div>
      </div>

      <!-- Placement Notes Block -->
      <div class="p-6">
        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Placement Notes & Instructions</h3>
        <div class="bg-amber-50/50 border-l-4 border-amber-500 p-4 rounded text-slate-800 text-sm whitespace-pre-line leading-relaxed">
          <%= currentTrade.notes || 'No specific placement notes provided.' %>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Job Site Comments Section -->
  <div class="bg-white p-6 rounded-lg border border-slate-200 shadow-sm space-y-4">
    <h3 class="text-md font-bold text-slate-900 border-b border-slate-100 pb-2">Field Notes & Comments</h3>

    <!-- Post Comment Form -->
    <form action="/room/<%= room.id %>/comment" method="POST" class="space-y-3">
      <input type="hidden" name="activeTrade" value="<%= activeTrade %>">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
        <input type="text" name="author" placeholder="Your Name / Trade (e.g., HVAC Lead)" required 
          class="sm:col-span-1 text-sm p-2 border border-slate-300 rounded focus:ring-2 focus:ring-amber-500 focus:outline-none">
        <input type="text" name="text" placeholder="Add field observation or question..." required 
          class="sm:col-span-2 text-sm p-2 border border-slate-300 rounded focus:ring-2 focus:ring-amber-500 focus:outline-none">
      </div>
      <button type="submit" class="bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs px-4 py-2 rounded transition">
        Post Comment
      </button>
    </form>

    <!-- Comments List -->
    <div class="space-y-3 pt-2">
      <% if (room.comments && room.comments.length > 0) { %>
        <% room.comments.forEach(comment => { %>
          <div class="p-3 bg-slate-50 rounded border border-slate-200 text-xs">
            <div class="flex justify-between items-center mb-1">
              <span class="font-bold text-slate-700"><%= comment.author %></span>
              <span class="text-slate-400"><%= comment.timestamp %></span>
            </div>
            <p class="text-slate-600"><%= comment.text %></p>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-xs text-slate-400 italic">No notes posted for this room yet.</p>
      <% } %>
    </div>
  </div>
</div>

<!-- Native Sharing Modal -->
<div id="shareModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-lg p-6 max-w-sm w-full space-y-4 shadow-xl">
    <div class="flex justify-between items-center">
      <h3 class="font-bold text-slate-900">Share Room Specifications</h3>
      <button onclick="toggleShareModal()" class="text-slate-400 hover:text-slate-600">&times;</button>
    </div>
    <div class="grid grid-cols-2 gap-2">
      <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(roomUrl) %>" target="_blank" class="bg-emerald-600 text-white text-center py-2 rounded text-xs font-semibold hover:bg-emerald-700">WhatsApp</a>
      <a href="mailto:?subject=Job Site Specs: <%= room.name %>&body=<%= encodeURIComponent(roomUrl) %>" class="bg-slate-700 text-white text-center py-2 rounded text-xs font-semibold hover:bg-slate-800">Email</a>
      <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(roomUrl) %>" target="_blank" class="bg-sky-500 text-white text-center py-2 rounded text-xs font-semibold hover:bg-sky-600">X / Twitter</a>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(roomUrl) %>" target="_blank" class="bg-blue-700 text-white text-center py-2 rounded text-xs font-semibold hover:bg-blue-800">LinkedIn</a>
    </div>
  </div>
</div>

<script>
  function toggleShareModal() {
    const modal = document.getElementById('shareModal');
    modal.classList.toggle('hidden');
  }
</script>

<%- include('partials/footer') %>