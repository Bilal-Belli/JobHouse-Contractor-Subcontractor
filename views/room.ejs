<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= room.name %> | JobSite Specs</title>
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#D0CBC4] text-slate-900 antialiased font-sans min-h-screen flex flex-col justify-between">

  <!-- Public Brand Header Bar -->
  <header class="bg-slate-900 text-white shadow-md">
    <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0V11m0 0h4m-4 0H7" />
        </svg>
        <span class="font-bold text-sm tracking-wider uppercase text-slate-200">JobSite Specs</span>
      </div>
      <span class="text-xs text-slate-400">Client Portal</span>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="max-w-4xl mx-auto w-full px-4 py-6 space-y-6 flex-grow">

    <!-- Parent House Navigation Bar -->
    <% if (typeof house !== 'undefined' && house) { %>
    <div class="bg-slate-900 text-white px-4 py-3 rounded-none flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 shadow-md">
      <div class="flex items-center gap-2 text-xs">
        <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span class="text-slate-400">Project:</span>
        <a href="/house/<%= house.id %>" class="font-bold text-amber-400 hover:underline">
          <%= house.name %>
        </a>
      </div>

      <!-- Quick Switch Room Dropdown -->
      <div class="flex items-center gap-2 text-xs w-full sm:w-auto">
        <span class="text-slate-400 whitespace-nowrap">Switch Room:</span>
        <select onchange="window.location.href=this.value"
          class="bg-slate-800 text-white text-xs border border-slate-700 rounded-none px-2.5 py-1 focus:outline-none focus:ring-1 focus:ring-amber-500 w-full sm:w-auto">
          <% (house.rooms || []).forEach(r => { %>
          <option value="/room/<%= r.id %>" <%= r.id === room.id ? 'selected' : '' %>>
            <%= r.name %>
          </option>
          <% }) %>
        </select>
      </div>
    </div>
    <% } %>

    <!-- Room Title and QR Bar -->
    <div class="bg-white p-5 rounded-none border border-slate-200 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <span class="inline-block px-2 py-0.5 text-xs font-bold rounded-none uppercase bg-emerald-100 text-emerald-800 mb-1">
          Active Site Specs
        </span>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight"><%= room.name %></h1>
      </div>

      <!-- QR Code & Share Trigger -->
      <div class="flex items-center gap-3 bg-slate-50 p-2 rounded-none border border-slate-200">
        <img src="<%= qrCodeUrl %>" alt="QR Code" class="w-16 h-16 rounded-none border border-slate-200 bg-white">
        <div class="space-y-1">
          <a href="<%= qrCodeUrl %>" download="QR-<%= room.id %>.png"
            class="block text-center bg-black hover:bg-slate-800 text-white text-xs px-3 py-1 rounded-none transition">
            Download QR
          </a>
          <button onclick="toggleShareModal()"
            class="w-full text-center bg-amber-600 hover:bg-amber-700 text-white text-xs px-3 py-1 rounded-none transition">
            Share Room
          </button>
        </div>
      </div>
    </div>

    <!-- Responsive Trade Tabs Navigation -->
    <div class="border-b border-slate-200 overflow-x-auto">
      <nav class="flex space-x-2 pb-px">
        <% room.trades.forEach(trade => { %>
        <a href="/room/<%= room.id %>?trade=<%= trade.id %>"
          class="whitespace-nowrap px-4 py-2.5 text-sm font-bold rounded-none transition border-b-2 
            <%= activeTrade === trade.id ? 'bg-white text-amber-600 border-amber-600 shadow-sm' : 'bg-slate-100 text-slate-600 border-transparent hover:bg-slate-200' %>">
          <%= trade.name %>
        </a>
        <% }) %>
      </nav>
    </div>

    <!-- Selected Trade Content -->
    <% const currentTrade = room.trades.find(t => t.id === activeTrade) || room.trades[0]; %>

    <% if (currentTrade) { %>
    <div class="bg-white rounded-none border border-slate-200 shadow-sm overflow-hidden">
      <!-- Media Displays -->
      <div class="grid grid-cols-1 md:grid-cols-2 border-b border-slate-200">
        <!-- Render View -->
        <div class="p-4 bg-slate-900 flex flex-col justify-center items-center min-h-[250px]">
          <span class="text-slate-400 text-xs font-semibold uppercase tracking-wider mb-2">3D Visual / Render</span>
          <% if (currentTrade.renderUrl) { %>
          <img src="<%= currentTrade.renderUrl %>" class="max-h-72 object-contain rounded-none">
          <% } else { %>
          <p class="text-slate-500 text-xs">No visual attached for this trade</p>
          <% } %>
        </div>

        <!-- Drawing/Plan View -->
        <div class="p-4 bg-slate-100 flex flex-col justify-center items-center min-h-[250px] border-t md:border-t-0 md:border-l border-slate-200">
          <span class="text-slate-500 text-xs font-semibold uppercase tracking-wider mb-2">Technical Drawing</span>
          <% if (currentTrade.planUrl) { %>
          <% if (currentTrade.planUrl.endsWith('.pdf')) { %>
          <a href="<%= currentTrade.planUrl %>" target="_blank"
            class="bg-slate-800 text-white text-xs font-semibold px-4 py-2 rounded-none shadow hover:bg-slate-700">
            Open Blueprint PDF
          </a>
          <% } else { %>
          <img src="<%= currentTrade.planUrl %>" class="max-h-72 object-contain rounded-none border border-slate-300">
          <% } %>
          <% } else { %>
          <p class="text-slate-400 text-xs">No technical drawing attached</p>
          <% } %>
        </div>
      </div>

      <!-- Placement Notes Block -->
      <div class="p-6">
        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Placement Notes & Instructions</h3>
        <div class="bg-amber-50/50 border-l-4 border-amber-500 p-4 rounded-none text-slate-800 text-sm whitespace-pre-line leading-relaxed">
          <%= currentTrade.notes || 'No specific placement notes provided.' %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Job Site Comments Section -->
    <div class="bg-white p-6 rounded-none border border-slate-200 shadow-sm space-y-4">
      <h3 class="text-md font-bold text-slate-900 border-b border-slate-100 pb-2">Field Notes & Comments</h3>

      <!-- Post Comment Form -->
      <form action="/room/<%= room.id %>/comment" method="POST" class="space-y-3">
        <input type="hidden" name="activeTrade" value="<%= activeTrade %>">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <input type="text" name="author" placeholder="Your Name / Trade (e.g., HVAC Lead)" required
            class="sm:col-span-1 text-sm p-2 border border-slate-300 rounded-none focus:ring-2 focus:ring-amber-500 focus:outline-none">
          <input type="text" name="text" placeholder="Add field observation or question..." required
            class="sm:col-span-2 text-sm p-2 border border-slate-300 rounded-none focus:ring-2 focus:ring-amber-500 focus:outline-none">
        </div>
        <button type="submit"
          class="bg-black hover:bg-slate-800 text-white font-semibold text-xs px-4 py-2 rounded-none transition">
          Post Comment
        </button>
      </form>

      <!-- Comments List -->
      <div class="space-y-3 pt-2">
        <% if (room.comments && room.comments.length > 0) { %>
        <% room.comments.forEach(comment => { %>
        <div class="p-3 bg-slate-50 rounded-none border border-slate-200 text-xs">
          <div class="flex justify-between items-center mb-1">
            <span class="font-bold text-slate-700"><%= comment.author %></span>
            <span class="text-slate-400"><%= comment.timestamp %></span>
          </div>
          <p class="text-slate-600"><%= comment.text %></p>
        </div>
        <% }) %>
        <% } else { %>
        <p class="text-xs text-slate-400 italic">No notes posted for this room yet.</p>
        <% } %>
      </div>
    </div>

  </main>

  <!-- Public Footer -->
  <footer class="bg-white border-t border-slate-300 py-4 mt-auto">
    <div class="max-w-4xl mx-auto px-4 text-center text-xs text-slate-500">
      &copy; 2026 Manu Romero Construction. All Rights Reserved.
    </div>
  </footer>

  <!-- Native Sharing Modal -->
  <div id="shareModal"
    class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-none p-6 max-w-sm w-full space-y-4 shadow-xl border border-slate-300">
      <div class="flex justify-between items-center">
        <h3 class="font-bold text-slate-900">Share Room Specifications</h3>
        <button onclick="toggleShareModal()" class="text-slate-400 hover:text-slate-600 font-bold">&times;</button>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(roomUrl) %>" target="_blank"
          class="bg-emerald-600 text-white text-center py-2 rounded-none text-xs font-semibold hover:bg-emerald-700">WhatsApp</a>
        <a href="mailto:?subject=Job Site Specs: <%= room.name %>&body=<%= encodeURIComponent(roomUrl) %>"
          class="bg-slate-700 text-white text-center py-2 rounded-none text-xs font-semibold hover:bg-slate-800">Email</a>
        <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(roomUrl) %>" target="_blank"
          class="bg-sky-500 text-white text-center py-2 rounded-none text-xs font-semibold hover:bg-sky-600">X / Twitter</a>
        <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(roomUrl) %>" target="_blank"
          class="bg-blue-700 text-white text-center py-2 rounded-none text-xs font-semibold hover:bg-blue-800">LinkedIn</a>
      </div>
    </div>
  </div>

  <script>
    function toggleShareModal() {
      const modal = document.getElementById('shareModal');
      modal.classList.toggle('hidden');
    }
  </script>

</body>
</html>