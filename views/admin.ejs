<%- include('partials/admin-header') %>

<div class="space-y-8">
  <!-- Page Title & Create House Action -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Admin Dashboard</h1>
      <p class="text-xs text-slate-600">Manage houses, rooms, and trade specifications</p>
    </div>

    <!-- Create House (Main Folder) Form -->
    <form action="/admin/houses" method="POST" class="flex gap-2">
      <input type="text" name="houseName" placeholder="e.g. Villa Sunset" required
        class="px-3 py-2 border border-slate-300 rounded-none text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
      <button type="submit"
        class="bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2 rounded-none shadow transition flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
        </svg>
        + Create House
      </button>
    </form>
  </div>

  <!-- Houses (Folders) List -->
  <% if (houses && houses.length > 0) { %>
  <div class="space-y-6">
    <% houses.forEach(house => { %>
    <div data-house-card data-house-name="<%= house.name %>" data-house-id="<%= house.id %>"
      class="bg-white rounded-none border border-slate-300 shadow-sm overflow-hidden">

      <!-- House (Folder) Header -->
      <div class="bg-slate-900 text-white p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3 flex-1">
          <svg class="w-6 h-6 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 001 1m-6 0h6" />
          </svg>
          <div class="flex items-center gap-2 flex-1">
            <!-- House Name with inline rename -->
            <form action="/admin/houses/<%= house.id %>/rename" method="POST" class="flex items-center gap-2 flex-1">
              <input type="text" name="newName" value="<%= house.name %>"
                class="bg-transparent text-lg font-bold tracking-wide border-b-2 border-transparent hover:border-amber-500/50 focus:border-amber-500 focus:outline-none px-1 text-white w-auto min-w-[100px]"
                onblur="this.form.submit()" onkeydown="if(event.key==='Enter'){this.form.submit()}"
                placeholder="Rename house...">
              <button type="submit"
                class="text-xs text-amber-400 hover:text-amber-300 opacity-0 group-hover:opacity-100 transition"
                title="Rename">✎</button>
            </form>
            <p class="text-xs text-slate-400"><%= house.rooms.length %> Room Subfolder(s)</p>
          </div>
        </div>

        <div class="flex gap-2">
          <!-- Add Room to this House Form -->
          <form action="/admin/houses/<%= house.id %>/rooms" method="POST" class="flex gap-2">
            <input type="text" name="roomName" placeholder="New Room" required
              class="px-2.5 py-1 text-xs text-slate-900 rounded-none focus:outline-none">
            <button type="submit"
              class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs px-3 py-1 rounded-none transition">
              + Add Room
            </button>
          </form>
          <!-- Delete House Form -->
          <form id="delete-house-form-<%= house.id %>" action="/admin/houses/<%= house.id %>/delete" method="POST">
            <button type="button" onclick="openHouseDeleteModal('<%= house.id %>', '<%= house.name %>')"
              class="text-slate-400 hover:text-red-500 text-xl leading-none px-1 transition"
              title="Delete House">×</button>
          </form>
        </div>
      </div>

      <!-- Rooms (Subfolders) Grid -->
      <div class="p-5">
        <% if (house.rooms && house.rooms.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% house.rooms.forEach(room => { %>
          <div data-room-card data-room-name="<%= room.name %>" data-room-id="<%= room.id %>"
            class="bg-slate-50 border border-slate-200 rounded-none p-4 flex flex-col justify-between hover:border-amber-400 transition group">
            <div>
              <div class="flex justify-between items-start mb-2">
                <div class="flex items-center gap-2 flex-1">
                  <svg class="w-4 h-4 text-slate-500 flex-shrink-0" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                  </svg>
                  <!-- Room Name with inline rename -->
                  <form action="/admin/rooms/<%= room.id %>/rename" method="POST"
                    class="flex items-center gap-1 flex-1">
                    <input type="text" name="newName" value="<%= room.name %>"
                      class="font-bold text-slate-800 text-sm bg-transparent border-b-2 border-transparent hover:border-amber-300 focus:border-amber-500 focus:outline-none px-1 w-auto min-w-[60px]"
                      onblur="this.form.submit()" onkeydown="if(event.key==='Enter'){this.form.submit()}"
                      placeholder="Rename room...">
                    <button type="submit"
                      class="text-xs text-amber-600 hover:text-amber-700 opacity-0 group-hover:opacity-100 transition"
                      title="Rename">✎</button>
                  </form>
                </div>
                <span
                  class="inline-block px-1.5 py-0.5 text-[10px] font-bold rounded-none uppercase tracking-wide flex-shrink-0
                          <%= room.status === 'published' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                  <%= room.status %>
                </span>
              </div>

              <div class="flex flex-wrap gap-1 mb-3">
                <% room.trades.forEach(trade => { %>
                <span class="text-[10px] bg-white text-slate-600 px-1.5 py-0.5 rounded-none border border-slate-200">
                  <%= trade.name %>
                </span>
                <% }) %>
              </div>
            </div>

            <!-- ROOM ACTION BUTTONS (3-BUTTON ROW) -->
            <div class="flex gap-1.5 pt-2 border-t border-slate-200">
              <a href="/room/<%= room.id %>" target="_blank"
                class="flex-1 text-center bg-black hover:bg-slate-900 text-white text-xs font-semibold py-1.5 rounded-none transition">
                Deal
              </a>
              <a href="/admin/edit/<%= room.id %>"
                class="flex-1 text-center bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-semibold py-1.5 rounded-none transition">
                Edit
              </a>
              <form id="delete-room-form-<%= room.id %>" action="/admin/rooms/<%= room.id %>/delete" method="POST"
                class="flex-1 flex">
                <button type="button" onclick="openRoomDeleteModal('<%= room.id %>', '<%= room.name %>')"
                  class="w-full bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 text-xs font-semibold py-1.5 rounded-none transition">
                  Delete
                </button>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <p class="text-xs text-slate-400 italic">No room subfolders created in this house yet. Add one above.</p>
        <% } %>
      </div>

    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="text-center py-12 bg-white rounded-none border border-slate-300">
    <p class="text-slate-500 text-sm">No house projects created yet. Start by adding a House folder above!</p>
  </div>
  <% } %>
</div>

<!-- ========================================== -->
<!-- UNIFIED TAILWIND DELETE CONFIRMATION MODAL -->
<!-- ========================================== -->
<div id="deleteModal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden">
  <div class="bg-white border border-slate-300 shadow-2xl max-w-md w-full p-6 space-y-4 rounded-none mx-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div>
        <h3 id="deleteModalTitle" class="text-base font-bold text-slate-900">Confirm Deletion</h3>
        <p class="text-xs text-slate-500 mt-0.5">This action cannot be undone.</p>
      </div>
    </div>

    <p id="deleteModalBody" class="text-sm text-slate-600">
      Are you sure you want to delete this item?
    </p>

    <div class="flex justify-end gap-2 pt-2 border-t border-slate-200">
      <button type="button" onclick="closeDeleteModal()"
        class="bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-semibold px-4 py-2 transition">
        Cancel
      </button>
      <button type="button" id="confirmDeleteBtn"
        class="bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-4 py-2 transition">
        Delete Permanently
      </button>
    </div>
  </div>
</div>

<style>
  .group:hover .opacity-0 {
    opacity: 1 !important;
  }
</style>

<script>
  let targetFormId = null;

  function openHouseDeleteModal(houseId, houseName) {
    targetFormId = `delete-house-form-${houseId}`;
    document.getElementById('deleteModalTitle').textContent = 'Delete House';
    document.getElementById('deleteModalBody').innerHTML = `Are you sure you want to delete <strong class="text-slate-900">${houseName}</strong> and all associated room subfolders?`;
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  function openRoomDeleteModal(roomId, roomName) {
    targetFormId = `delete-room-form-${roomId}`;
    document.getElementById('deleteModalTitle').textContent = 'Delete Room';
    document.getElementById('deleteModalBody').innerHTML = `Are you sure you want to delete room <strong class="text-slate-900">${roomName}</strong> and all its spec files?`;
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  function closeDeleteModal() {
    targetFormId = null;
    document.getElementById('deleteModal').classList.add('hidden');
  }

  document.getElementById('confirmDeleteBtn').addEventListener('click', () => {
    if (targetFormId) {
      document.getElementById(targetFormId).submit();
    }
  });

  // Close modal when pressing Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDeleteModal();
  });

  // Auto-save inline rename handlers
  document.querySelectorAll('input[name="newName"]').forEach(input => {
    let originalValue = input.value;

    input.addEventListener('blur', async () => {
      const newValue = input.value.trim();
      if (!newValue || newValue === originalValue) return;

      const form = input.closest('form');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ newName: newValue })
        });

        if (response.ok) {
          originalValue = newValue;
        } else {
          input.value = originalValue;
        }
      } catch (err) {
        console.error('Failed to rename:', err);
        input.value = originalValue;
      }
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        input.blur();
      }
    });
  });
</script>

<%- include('partials/footer') %>