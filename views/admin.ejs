<%- include('partials/admin-header') %>

<div class="space-y-8">
  <!-- Page Title & Create House Action -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Admin Dashboard</h1>
      <p class="hidden md:block text-xs text-slate-600">Manage houses, rooms, and trade specifications</p>
    </div>

    <!-- Create House (Main Folder) Form -->
    <form action="/admin/houses" method="POST" class="flex gap-2">
      <input type="text" name="houseName" placeholder="e.g. Villa Sunset" required
        class="px-3 py-2 border border-slate-300 rounded-none text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
      <button type="submit"
        class="bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2 rounded-none shadow transition flex items-center gap-1.5">
        + Create House
      </button>
    </form>
  </div>

  <!-- Houses (Folders) List -->
  <% if (houses && houses.length > 0) { %>
  <div class="space-y-6" id="housesContainer">
    <% houses.forEach(house => { %>
    <div data-house-card data-house-name="<%= house.name %>" data-house-id="<%= house.id %>"
      class="bg-white rounded-none border border-slate-300 shadow-sm overflow-hidden">
      <!-- House (Folder) Header - Click to expand/collapse -->
      <div class="drag-handle-house cursor-move text-slate-900 hover:text-slate-800 mr-1">
        ⠿
      </div>
      <div
        class="house-header bg-slate-900 text-white p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 cursor-pointer"
        onclick="toggleHouse(this.closest('[data-house-card]'))">
        <div class="flex items-center gap-3 flex-1">
          <!-- Expand/collapse icon -->
          <svg class="w-5 h-5 text-amber-500 flex-shrink-0 transition-transform duration-200 house-toggle-icon"
            fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>

          <svg class="hidden md:block w-6 h-6 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor"
            viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 001 1m-6 0h6" />
          </svg>
          <div class="flex items-center gap-2 flex-1">
            <!-- House Name with inline rename -->
            <form action="/admin/houses/<%= house.id %>/rename" method="POST" class="flex items-center gap-2 flex-1">
              <input type="text" name="newName" value="<%= house.name %>"
                class="house-name-input bg-transparent text-lg font-bold tracking-wide border-b-2 border-transparent hover:border-amber-500/50 focus:border-amber-500 focus:outline-none px-1 text-white w-auto min-w-[100px]"
                onblur="renameHouse(this)" onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur()}"
                placeholder="Rename house..." data-house-id="<%= house.id %>">
              <span class="hidden md:inline text-xs text-slate-400"><%= house.rooms.length %> Room Subfolder(s)</span>
            </form>
          </div>
        </div>

        <div class="flex gap-2" onclick="event.stopPropagation()">
          <!-- Add Room to this House Form -->
          <form action="/admin/houses/<%= house.id %>/rooms" method="POST" class="flex gap-2">
            <input type="text" name="roomName" placeholder="New Room" required
              class="px-2.5 py-1 text-xs text-slate-900 rounded-none focus:outline-none">
            <button type="submit"
              class="bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs px-3 py-1 rounded-none transition">
              + Add Room
            </button>
          </form>
          <a href="/admin/houses/schedule/<%= house.id %>"
            class="bg-green-600 hover:bg-green-700 text-white text-xs font-semibold px-3 py-1 rounded-none transition">
            Schedule
          </a>
          
          <!-- Delete House Form -->
          <form id="delete-house-form-<%= house.id %>" action="/admin/houses/<%= house.id %>/delete" method="POST">
            <button type="button" onclick="openHouseDeleteModal('<%= house.id %>', '<%= house.name %>')"
              class="text-slate-400 hover:text-red-500 text-xl leading-none px-1 transition"
              title="Delete House">×</button>
          </form>
        </div>
      </div>

      <!-- Rooms (Subfolders) Grid - Collapsible -->
      <div class="house-rooms-container p-5">
        <% if (house.rooms && house.rooms.length > 0) { %>
        <div class="rooms-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" data-house-id="<%= house.id %>">
          <% house.rooms.forEach(room => { %>
          <div data-room-card data-room-name="<%= room.name %>" data-room-id="<%= room.id %>"
            data-house-id="<%= house.id %>"
            class="room-card bg-slate-50 border border-slate-200 rounded-none p-4 flex flex-col justify-between hover:border-amber-400 transition group">
            <div>
              <div class="flex justify-between items-start mb-2">
                <div class="flex items-center gap-2 flex-1">
                  <!-- Drag handle -->
                  <div class="drag-handle cursor-move text-slate-400 hover:text-slate-600">
                    ⠿
                  </div>
                  <svg class="hidden md:block  w-4 h-4 text-slate-500 flex-shrink-0" fill="none" stroke="currentColor"
                    viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                  </svg>
                  <!-- Room Name with inline rename -->
                  <form action="/admin/rooms/<%= room.id %>/rename" method="POST"
                    class="flex items-center gap-1 flex-1">
                    <input type="text" name="newName" value="<%= room.name %>"
                      class="room-name-input font-bold text-slate-800 text-sm bg-transparent border-b-2 border-transparent hover:border-amber-300 focus:border-amber-500 focus:outline-none px-1 w-auto min-w-[60px]"
                      onblur="renameRoom(this)" onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur()}"
                      placeholder="Rename room..." data-room-id="<%= room.id %>">
                  </form>
                </div>
                <span
                  class="inline-block px-1.5 py-0.5 text-[10px] font-bold rounded-none uppercase tracking-wide flex-shrink-0
                          <%= room.status === 'published' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                  <%= room.status %>
                </span>
              </div>

              <!-- Trades list - draggable with inline rename -->
              <div class="trades-container flex flex-wrap gap-1 mb-2" data-room-id="<%= room.id %>">
                <% room.trades.forEach((trade, index) => { %>
                <span
                  class="trade-item group relative text-[10px] bg-white text-slate-600 px-1.5 py-0.5 rounded-none border border-slate-200 cursor-move inline-flex items-center gap-1"
                  data-trade-id="<%= trade.id %>" data-trade-name="<%= trade.name %>" data-trade-index="<%= index %>">
                  <span class="trade-name"><%= trade.name %></span>
                  <input type="text" value="<%= trade.name %>"
                    class="trade-rename-input hidden text-[10px] bg-transparent border-b border-amber-500 focus:outline-none w-auto min-w-[40px] px-0 py-0"
                    data-room-id="<%= room.id %>" data-trade-id="<%= trade.id %>">
                  <button type="button"
                    class="trade-rename-btn opacity-0 group-hover:opacity-100 text-slate-400 hover:text-slate-700 text-[8px] leading-none"
                    onclick="enableTradeRename(this)">✎</button>
                </span>
                <% }) %>

                <!-- Add trade input (shows as empty tab) -->
                <span class="add-trade-container inline-flex items-center">
                  <input type="text"
                    class="add-trade-input text-[10px] bg-transparent border border-dashed border-amber-400 hover:border-amber-500 focus:border-amber-500 focus:outline-none px-1.5 py-0.5 rounded-none w-[60px] transition placeholder:text-slate-400"
                    placeholder="+ Add" data-room-id="<%= room.id %>" onfocus="this.placeholder='Enter trade name...'"
                    onblur="addTradeFromInput(this)"
                    onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur();} if(event.key==='Escape'){this.value='';this.blur();}">
                </span>
              </div>
            </div>

            <!-- ROOM ACTION BUTTONS (3-BUTTON ROW) -->
            <div class="flex gap-1.5 pt-2 border-t border-slate-200">
              <a href="/room/<%= room.id %>" target="_blank"
                class="flex-1 text-center bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold py-1.5 rounded-none transition">
                View
              </a>
              <a href="/admin/edit/<%= room.id %>"
                class="flex-1 text-center bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-semibold py-1.5 rounded-none transition">
                Edit
              </a>
              <button type="button" onclick="duplicateRoom('<%= room.id %>', '<%= room.name %>', '<%= house.id %>')"
                class="flex-1 bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-semibold py-1.5 rounded-none transition">
                Duplicate
              </button>
              <form id="delete-room-form-<%= room.id %>" action="/admin/rooms/<%= room.id %>/delete" method="POST"
                class="flex-1 flex">
                <button type="button" onclick="openRoomDeleteModal('<%= room.id %>', '<%= room.name %>')"
                  class="w-full bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 text-xs font-semibold py-1.5 rounded-none transition">
                  Delete
                </button>
              </form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <p class="text-xs text-slate-400 italic">No room subfolders created in this house yet. Add one above.</p>
        <% } %>
      </div>

    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="text-center py-12 bg-white rounded-none border border-slate-300">
    <p class="text-slate-500 text-sm">No house projects created yet. Start by adding a House folder above!</p>
  </div>
  <% } %>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div id="deleteModal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden">
  <div class="bg-white border border-slate-300 shadow-2xl max-w-md w-full p-6 space-y-4 rounded-none mx-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div>
        <h3 id="deleteModalTitle" class="text-base font-bold text-slate-900">Confirm Deletion</h3>
        <p class="text-xs text-slate-500 mt-0.5">This action cannot be undone.</p>
      </div>
    </div>

    <p id="deleteModalBody" class="text-sm text-slate-600">
      Are you sure you want to delete this item?
    </p>

    <div class="flex justify-end gap-2 pt-2 border-t border-slate-200">
      <button type="button" onclick="closeDeleteModal()"
        class="bg-white border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-semibold px-4 py-2 transition">
        Cancel
      </button>
      <button type="button" id="confirmDeleteBtn"
        class="bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-4 py-2 transition">
        Delete Permanently
      </button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<script>
  let targetFormId = null;

  function toggleHouse(houseCard) {
    const container = houseCard.querySelector('.house-rooms-container');
    const icon = houseCard.querySelector('.house-toggle-icon');

    container.classList.toggle('collapsed');
    icon.classList.toggle('collapsed');

    const houseId = houseCard.dataset.houseId;
    const isCollapsed = container.classList.contains('collapsed');
    localStorage.setItem('house_' + houseId + '_collapsed', isCollapsed);
  }

  async function renameHouse(input) {
    const newName = input.value.trim();
    if (!newName) return;

    const houseId = input.dataset.houseId;
    const form = input.closest('form');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ newName: newName })
      });

      if (!response.ok) {
        input.value = input.defaultValue;
      }
    } catch (err) {
      console.error('Failed to rename house:', err);
      input.value = input.defaultValue;
    }
  }

  function enableTradeRename(btn) {
    const tradeItem = btn.closest('.trade-item');
    const nameSpan = tradeItem.querySelector('.trade-name');
    const input = tradeItem.querySelector('.trade-rename-input');
    const roomId = input.dataset.roomId;
    const tradeId = input.dataset.tradeId;
    const originalName = nameSpan.textContent.trim();

    nameSpan.classList.add('hidden');
    input.classList.remove('hidden');
    input.classList.add('active');
    input.value = originalName;
    input.focus();
    input.select();

    input.onblur = async function () {
      const newName = this.value.trim();
      if (!newName || newName === originalName) {
        nameSpan.classList.remove('hidden');
        input.classList.add('hidden');
        input.classList.remove('active');
        return;
      }

      try {
        const response = await fetch('/admin/rooms/' + roomId + '/rename-trade/' + tradeId, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ newName: newName })
        });

        if (response.ok) {
          nameSpan.textContent = newName;
          tradeItem.dataset.tradeName = newName;
        } else {
          input.value = originalName;
        }
      } catch (err) {
        console.error('Failed to rename trade:', err);
        input.value = originalName;
      }

      nameSpan.classList.remove('hidden');
      input.classList.add('hidden');
      input.classList.remove('active');
    };

    // Save on Enter key
    input.onkeydown = function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        this.blur();
      } else if (e.key === 'Escape') {
        this.value = originalName;
        this.blur();
      }
    };
  }

  async function renameRoom(input) {
    const newName = input.value.trim();
    if (!newName) return;

    const roomId = input.dataset.roomId;
    const form = input.closest('form');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ newName: newName })
      });

      if (!response.ok) {
        input.value = input.defaultValue;
      }
    } catch (err) {
      console.error('Failed to rename room:', err);
      input.value = input.defaultValue;
    }
  }

  function openHouseDeleteModal(houseId, houseName) {
    targetFormId = 'delete-house-form-' + houseId;
    document.getElementById('deleteModalTitle').textContent = 'Delete House';
    document.getElementById('deleteModalBody').innerHTML = 'Are you sure you want to delete <strong class="text-slate-900">' + houseName + '</strong> and all associated room subfolders?';
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  function openRoomDeleteModal(roomId, roomName) {
    targetFormId = 'delete-room-form-' + roomId;
    document.getElementById('deleteModalTitle').textContent = 'Delete Room';
    document.getElementById('deleteModalBody').innerHTML = 'Are you sure you want to delete room <strong class="text-slate-900">' + roomName + '</strong> and all its spec files?';
    document.getElementById('deleteModal').classList.remove('hidden');
  }

  function closeDeleteModal() {
    targetFormId = null;
    document.getElementById('deleteModal').classList.add('hidden');
  }

  async function addTradeFromInput(input) {
    const tradeName = input.value.trim();
    const roomId = input.dataset.roomId;

    input.placeholder = '+ Add';
    if (!tradeName) {
      input.value = '';
      return;
    }

    try {
      const response = await fetch('/admin/edit/' + roomId + '/add-trade', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ tradeName: tradeName })
      });

      if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to add trade. Please try again.');
        input.value = '';
      }
    } catch (err) {
      console.error('Error adding trade:', err);
      alert('Failed to add trade. Please try again.');
      input.value = '';
    }
  }

  document.querySelectorAll('[data-house-card]').forEach(card => {
    const houseId = card.dataset.houseId;
    const isCollapsed = localStorage.getItem('house_' + houseId + '_collapsed') === 'true';
    if (isCollapsed) {
      const container = card.querySelector('.house-rooms-container');
      const icon = card.querySelector('.house-toggle-icon');
      container.classList.add('collapsed');
      icon.classList.add('collapsed');
    }
  });

  document.querySelectorAll('.rooms-grid').forEach(grid => {
    new Sortable(grid, {
      handle: '.drag-handle',
      animation: 150,
      ghostClass: 'drag-over',
      dragClass: 'dragging',
      onEnd: function (evt) {
        const houseId = grid.dataset.houseId;
        const roomIds = Array.from(grid.querySelectorAll('.room-card')).map(el => el.dataset.roomId);

        fetch('/admin/houses/' + houseId + '/reorder-rooms', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ roomOrder: roomIds })
        }).catch(err => console.error('Failed to reorder rooms:', err));
      }
    });
  });

  document.querySelectorAll('.trades-container').forEach(container => {
    new Sortable(container, {
      animation: 150,
      ghostClass: 'drag-over',
      dragClass: 'dragging',
      onEnd: function (evt) {
        const roomId = container.dataset.roomId;
        const tradeIds = Array.from(container.querySelectorAll('.trade-item')).map(el => el.dataset.tradeId);

        fetch('/admin/rooms/' + roomId + '/reorder-trades', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ tradeOrder: tradeIds })
        }).catch(err => console.error('Failed to reorder trades:', err));
      }
    });
  });

  document.getElementById('confirmDeleteBtn').addEventListener('click', () => {
    if (targetFormId) {
      document.getElementById(targetFormId).submit();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDeleteModal();
  });

  document.querySelectorAll('.house-name-input, .room-name-input').forEach(input => {
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        input.blur();
      }
    });
  });

  new Sortable(document.getElementById('housesContainer'), {
    handle: '.drag-handle-house', // We'll add this
    animation: 150,
    ghostClass: 'drag-over',
    dragClass: 'dragging',
    onEnd: function (evt) {
      const houseIds = Array.from(document.querySelectorAll('[data-house-card]')).map(el => el.dataset.houseId);

      fetch('/admin/houses/reorder', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ houseOrder: houseIds })
      }).catch(err => console.error('Failed to reorder houses:', err));
    }
  });

  async function duplicateRoom(roomId, roomName, houseId) {
    if (!confirm(`Duplicate room "${roomName}"?`)) return;

    try {
      const response = await fetch(`/admin/rooms/${roomId}/duplicate`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({
          newName: `${roomName} (Copy)`,
          houseId: houseId
        })
      });

      if (response.ok) {
        window.location.reload();
      } else {
        const data = await response.json();
        alert(data.message || 'Failed to duplicate room');
      }
    } catch (err) {
      console.error('Error duplicating room:', err);
      alert('Failed to duplicate room. Please try again.');
    }
  }

</script>

</main>
<footer class="bg-slate-900 border-t border-slate-600 flex-shrink-0">
  <div class="max-w-7xl mx-auto px-4 py-6 text-center text-xs text-white">
    &copy; 2026. Manu Romero Construction.
  </div>
</footer>
</body>

</html>