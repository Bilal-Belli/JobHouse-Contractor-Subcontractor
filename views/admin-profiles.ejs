<%- include('partials/admin-estimates-header') %>

<main class="max-w-7xl mx-auto px-4 py-6 flex-grow w-full space-y-6">

  <!-- Top Action & Title Bar with Live Search -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-300 pb-4">
    
    <!-- LEFT: Live Search Input -->
    <div class="relative w-full sm:w-72">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
        <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
      <input 
        type="text" 
        id="companySearchInput" 
        onkeyup="filterCompanyProfiles()" 
        placeholder="Search by name, license, phone..." 
        class="w-full pl-9 pr-4 py-2 text-xs sm:text-sm bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all shadow-sm"
      >
    </div>

    <!-- RIGHT: Add Profile Trigger Button -->
    <div class="shrink-0 flex justify-end">
      <button onclick="openCreateModal()" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold px-4 py-2 text-xs sm:text-sm shadow-sm transition-all flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        New Profile
      </button>
    </div>

  </div>

  <!-- Full-Width Reorderable Profiles List -->
  <div class="bg-white shadow-sm border border-slate-200">
    <div class="p-4 bg-slate-100 border-b border-slate-200 flex justify-between items-center text-xs font-bold text-slate-500 uppercase tracking-wider">
      <span>Stored Entities (<%= companyProfiles.length %>)</span>
    </div>

    <div id="profilesContainer" class="divide-y divide-slate-200">
      <% if (companyProfiles.length === 0) { %>
        <div class="p-8 text-center text-xs text-slate-400 italic">No company profiles found. Click "New Profile" to create one.</div>
      <% } %>

      <% companyProfiles.forEach(prof => { %>
        <div 
          class="profile-row p-4 hover:bg-slate-50/80 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4" 
          draggable="true" 
          data-id="<%= prof.id %>"
        >
          <div class="flex items-center gap-4 flex-grow w-full sm:w-auto">
            <!-- Drag Handle -->
            <div class="cursor-grab text-slate-400 hover:text-slate-600 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"></path></svg>
            </div>

            <!-- Logo -->
            <div class="w-12 h-12 bg-white border border-slate-200 p-1 flex items-center justify-center shrink-0">
              <% if (prof.logoUrl) { %>
                <img src="<%= prof.logoUrl %>" alt="Logo" class="w-full h-full object-contain">
              <% } else { %>
                <span class="text-[10px] font-bold text-slate-400">No Logo</span>
              <% } %>
            </div>

            <!-- Profile Info Summary -->
            <div class="space-y-0.5 text-xs">
              <h3 class="font-bold text-slate-900 text-sm"><%= prof.name %></h3>
              <p class="text-slate-500"><span class="font-semibold text-slate-700">License:</span> <%= prof.license || 'N/A' %> &bull; <span class="font-semibold text-slate-700">Phone:</span> <%= prof.phone || 'N/A' %></p>
              <p class="text-slate-500 text-[11px]"><%= prof.address || 'No street address set' %></p>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
            <button 
              onclick='editProfile(<%- JSON.stringify(prof) %>)' 
              class="bg-white hover:bg-slate-100 text-slate-800 border border-slate-300 px-3 py-1.5 text-xs font-semibold transition-all"
            >
              Edit Details
            </button>
            <button 
              onclick="promptDeleteProfile('<%= prof.id %>', '<%= prof.name %>')" 
              class="bg-red-50 hover:bg-red-100 text-red-600 border border-red-300 px-3 py-1.5 text-xs font-semibold transition-all"
            >
              Delete
            </button>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

</main>

<!-- ================= MODAL: ADD / EDIT PROFILE POPUP ================= -->
<div id="profileModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white max-w-xl w-full shadow-2xl border border-slate-300 p-6 space-y-6 max-h-[90vh] overflow-y-auto">
    <div class="flex justify-between items-center border-b border-slate-200 pb-3">
      <h3 id="formTitle" class="text-lg font-bold text-slate-900">Add Company Profile</h3>
      <button onclick="toggleModal('profileModal')" class="text-slate-400 hover:text-slate-700 font-bold text-lg">&times;</button>
    </div>

    <form id="profileForm" onsubmit="saveProfile(event)" class="space-y-4">
      <input type="hidden" id="profId" value="">

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="sm:col-span-2">
          <label class="block font-bold text-slate-700 mb-1">Company Name *</label>
          <input type="text" id="profName" required placeholder="e.g. Apex Construction LLC" class="w-full border border-slate-300 p-2.5 focus:ring-2 focus:ring-amber-500 focus:outline-none">
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">License N°</label>
          <input type="text" id="profLicense" placeholder="e.g. AC-99218" class="w-full border border-slate-300 p-2.5 focus:ring-2 focus:ring-amber-500 focus:outline-none">
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Phone Number</label>
          <input type="text" id="profPhone" placeholder="e.g. (555) 019-2831" class="w-full border border-slate-300 p-2.5 focus:ring-2 focus:ring-amber-500 focus:outline-none">
        </div>

        <div class="sm:col-span-2">
          <label class="block font-bold text-slate-700 mb-1">Address</label>
          <input type="text" id="profAddress" placeholder="e.g. City, State, ZIP" class="w-full border border-slate-300 p-2.5 focus:ring-2 focus:ring-amber-500 focus:outline-none">
        </div>

        <div class="sm:col-span-2 space-y-2">
          <label class="block font-bold text-slate-700">Company Logo</label>
          <div class="flex items-center gap-4 border border-slate-200 p-3 bg-slate-50">
            <div id="logoPreviewContainer" class="w-16 h-16 bg-white border border-slate-300 flex items-center justify-center text-[10px] font-bold text-slate-400 shrink-0">
              No Image
            </div>
            <div class="space-y-1">
              <input type="file" id="profLogo" accept="image/*" onchange="previewLogo(event)" class="text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:border-0 file:text-xs file:font-semibold file:bg-slate-800 file:text-white hover:file:bg-slate-700">
            </div>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-4 border-t border-slate-200">
        <button type="button" onclick="toggleModal('profileModal')" class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 transition-all">Cancel</button>
        <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-bold px-6 py-2.5 shadow-sm transition-all">
          Save
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ================= MODAL: CUSTOM DELETE CONFIRMATION ================= -->
<div id="deleteConfirmModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
  <div class="bg-white max-w-md w-full shadow-2xl border border-slate-300 p-6 space-y-4">
    <div class="flex items-center gap-3 border-b border-slate-200 pb-3 text-red-600">
      <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <h3 class="text-lg font-bold text-slate-900">Delete Profile</h3>
    </div>
    
    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
      Are you sure you want to delete <strong id="deleteTargetName" class="text-slate-900"></strong>? This action cannot be undone.
    </p>

    <div class="flex justify-end gap-2 pt-2">
      <button onclick="toggleModal('deleteConfirmModal')" class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 transition-all">
        Cancel
      </button>
      <button id="confirmDeleteBtn" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 text-xs font-bold transition-all shadow-sm">
        Delete Profile
      </button>
    </div>
  </div>
</div>

<script>
  let profileToDeleteId = null;

  document.addEventListener('DOMContentLoaded', setupDragAndDrop);

  function toggleModal(id) {
    document.getElementById(id).classList.toggle('hidden');
  }

  function openCreateModal() {
    document.getElementById('profId').value = '';
    document.getElementById('profileForm').reset();
    document.getElementById('formTitle').textContent = 'Add Company Profile';
    document.getElementById('logoPreviewContainer').innerHTML = `<span class="text-[10px] font-bold text-slate-400">No Image</span>`;
    toggleModal('profileModal');
  }

  function editProfile(prof) {
    document.getElementById('profId').value = prof.id || '';
    document.getElementById('profName').value = prof.name || '';
    document.getElementById('profLicense').value = prof.license || '';
    document.getElementById('profPhone').value = prof.phone || '';
    document.getElementById('profAddress').value = prof.address || '';
    document.getElementById('formTitle').textContent = 'Edit Company Profile';

    const preview = document.getElementById('logoPreviewContainer');
    if (prof.logoUrl) {
      preview.innerHTML = `<img src="${prof.logoUrl}" class="w-full h-full object-contain">`;
    } else {
      preview.innerHTML = `<span class="text-[10px] font-bold text-slate-400">No Image</span>`;
    }

    toggleModal('profileModal');
  }

  function previewLogo(e) {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function(evt) {
        document.getElementById('logoPreviewContainer').innerHTML = `<img src="${evt.target.result}" class="w-full h-full object-contain">`;
      };
      reader.readAsDataURL(file);
    }
  }

  async function saveProfile(e) {
    e.preventDefault();
    const formData = new FormData();
    formData.append('id', document.getElementById('profId').value);
    formData.append('name', document.getElementById('profName').value);
    formData.append('license', document.getElementById('profLicense').value);
    formData.append('phone', document.getElementById('profPhone').value);
    formData.append('address', document.getElementById('profAddress').value);
    
    const fileInput = document.getElementById('profLogo');
    if (fileInput.files[0]) {
      formData.append('logo', fileInput.files[0]);
    }

    const res = await fetch('/admin/company-profiles', {
      method: 'POST',
      body: formData
    });

    const result = await res.json();
    if (result.success) {
      window.location.reload();
    } else {
      alert('Failed to save profile.');
    }
  }

  // Opens Custom Confirmation Modal
  function promptDeleteProfile(id, name) {
    profileToDeleteId = id;
    document.getElementById('deleteTargetName').textContent = name;
    
    // Bind click handler dynamically
    document.getElementById('confirmDeleteBtn').onclick = executeDeleteProfile;
    
    toggleModal('deleteConfirmModal');
  }

  // Executes Server Action
  async function executeDeleteProfile() {
    if (!profileToDeleteId) return;

    const res = await fetch(`/admin/company-profiles/${profileToDeleteId}/delete`, { method: 'POST' });
    const result = await res.json();
    
    if (result.success) {
      window.location.reload();
    } else {
      alert('Failed to delete profile.');
    }
  }

  // Drag & Drop Reordering Handler
  function setupDragAndDrop() {
    const container = document.getElementById('profilesContainer');
    let draggedRow = null;

    container.querySelectorAll('.profile-row').forEach(row => {
      row.addEventListener('dragstart', (e) => {
        draggedRow = row;
        row.classList.add('opacity-50', 'bg-amber-50');
      });

      row.addEventListener('dragend', () => {
        row.classList.remove('opacity-50', 'bg-amber-50');
        draggedRow = null;
        saveProfilesOrder();
      });
    });

    container.addEventListener('dragover', (e) => {
      e.preventDefault();
      const rows = [...container.querySelectorAll('.profile-row:not(.opacity-50)')];
      const afterElement = rows.reduce((closest, child) => {
        const box = child.getBoundingClientRect();
        const offset = e.clientY - box.top - box.height / 2;
        if (offset < 0 && offset > closest.offset) {
          return { offset: offset, element: child };
        } else {
          return closest;
        }
      }, { offset: Number.NEGATIVE_INFINITY }).element;

      if (afterElement == null) {
        container.appendChild(draggedRow);
      } else {
        container.insertBefore(draggedRow, afterElement);
      }
    });
  }

  async function saveProfilesOrder() {
    const container = document.getElementById('profilesContainer');
    const order = [...container.querySelectorAll('.profile-row')].map(row => row.getAttribute('data-id'));

    await fetch('/admin/company-profiles/reorder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ order })
    });
  }

  function filterCompanyProfiles() {
    const query = document.getElementById('companySearchInput').value.toLowerCase().trim();
    const profileRows = document.querySelectorAll('#profilesContainer .profile-row');

    profileRows.forEach(row => {
      const rowText = row.innerText.toLowerCase();
      if (rowText.includes(query)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }
</script>